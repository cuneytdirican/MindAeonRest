<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MindAeonRest.Mobile.Pages.ConfigPage"
             Title="Gelişmiş Sunucu Ayarı">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center" MaximumWidthRequest="520">
            <Label Text="MindAeon REST" Style="{StaticResource H1}" TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
            <Label Text="Mobil" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" Margin="0,-8,0,12" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SUNUCU ADRESİ (İSTEĞE BAĞLI)" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="UrlEntry" Style="{StaticResource Input}" Placeholder="bulut merkez (varsayılan)" Keyboard="Url" />
                    <Label Text="Uygulama varsayılan olarak bulut merkeze bağlanır. Yalnızca özel bir sunucu/adres kullanacaksanız buraya girin. Boş bırakırsanız bulut merkez kullanılır."
                           Style="{StaticResource Muted}" />
                    <Label x:Name="StatusLabel" IsVisible="False" Margin="0,6,0,0" FontAttributes="Bold" />
                    <Button x:Name="ScanBtn" Text="📷  QR Okut" BackgroundColor="{StaticResource Accent}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="Scan_Clicked" Margin="0,10,0,0" />
                    <Label Text="— veya adresi elle girin —" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,8,0,0" />
                    <Button x:Name="TestBtn" Text="Bağlantıyı Test Et" Style="{StaticResource GhostButton}" Clicked="Test_Clicked" Margin="0,8,0,0" />
                    <Button x:Name="SaveBtn" Text="Kaydet ve Devam" Style="{StaticResource PrimaryButton}" Clicked="Save_Clicked" Margin="0,4,0,0" />
                    <Button x:Name="DefaultBtn" Text="Bulut Merkeze Dön (varsayılan)" Style="{StaticResource GhostButton}" Clicked="Default_Clicked" Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
