<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="MindAeonRest.Mobile.Pages.StockCountPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Başlık + depo -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="16,12">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="📋 Mobil Sayım" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Kapat" Clicked="Close_Clicked" Style="{StaticResource GhostButton}" Padding="12,4" />
                </Grid>
                <Picker Grid.Row="1" x:Name="WarehousePicker" Title="Depo seçin"
                        TextColor="{StaticResource TextColor}" TitleColor="{StaticResource TextMuted}"
                        ItemDisplayBinding="{Binding Name}" />
            </Grid>
        </Border>

        <!-- Okutma alanı -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="16,0,16,12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="CodeEntry" Placeholder="Barkod / ürün kodu"
                           TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextMuted}"
                           ReturnType="Search" Completed="Find_Clicked" />
                    <Button Grid.Column="1" Text="Bul" Clicked="Find_Clicked"
                            BackgroundColor="{StaticResource ButtonColor}" TextColor="{StaticResource TextColor}" CornerRadius="9" Padding="16,4" />
                </Grid>
                <Button x:Name="CameraToggle" Text="📷 Kamera ile Okut" Clicked="ToggleCamera_Clicked"
                        BackgroundColor="{StaticResource Accent}" TextColor="White" FontAttributes="Bold" CornerRadius="10" Padding="12,8" />
                <zxing:CameraBarcodeReaderView x:Name="Reader" HeightRequest="220" IsVisible="False"
                                               IsDetecting="False" BarcodesDetected="OnDetected" />
            </VerticalStackLayout>
        </Border>

        <!-- Sayım listesi -->
        <CollectionView Grid.Row="2" x:Name="LinesView" Margin="12,8">
            <CollectionView.EmptyView>
                <Label Text="Henüz sayım satırı yok. Barkod okutun veya kod girin."
                       Style="{StaticResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" TextColor="{StaticResource TextColor}" FontAttributes="Bold" />
                                <Label Text="{Binding Code}" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding QtyText}" TextColor="{StaticResource Accent}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="✕" Clicked="Remove_Clicked" CommandParameter="{Binding ProductId}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" Padding="8,0" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Gönder -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="16,12">
            <Button x:Name="SubmitBtn" Text="Sayımı Gönder ve Kesinleştir" Clicked="Submit_Clicked"
                    BackgroundColor="{StaticResource Success}" TextColor="White" FontAttributes="Bold" CornerRadius="12" Padding="12,12" />
        </Border>
    </Grid>
</ContentPage>
