<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:p="clr-namespace:MindAeonRest.Mobile.Pages"
             x:Class="MindAeonRest.Mobile.Pages.PaymentPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Başlık (gradyan) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" StrokeThickness="0" Padding="12,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="‹ Geri" Clicked="Back_Clicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" Padding="0" />
                <Label Grid.Column="1" x:Name="TitleLabel" Text="Ödeme" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <!-- Özet -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout><Label Text="TOPLAM" Style="{StaticResource FieldLabel}" /><Label x:Name="TotalLbl" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextColor}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"><Label Text="ÖDENEN" Style="{StaticResource FieldLabel}" /><Label x:Name="PaidLbl" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Success}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"><Label Text="KALAN" Style="{StaticResource FieldLabel}" /><Label x:Name="RemainingLbl" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" /></VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Yöntem (12 yöntem, telefon/tablette sığsın diye FlexLayout wrap) -->
                <Label Text="ÖDEME YÖNTEMİ" Style="{StaticResource FieldLabel}" />
                <FlexLayout x:Name="MethodPanel" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" />

                <!-- Araç (kasa/POS/hesap) veya cari/müşteri seçimi -->
                <VerticalStackLayout x:Name="InstrPanel" Spacing="6">
                    <Label x:Name="InstrLabel" Text="KASA / POS / HESAP" Style="{StaticResource FieldLabel}" />
                    <Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,0">
                        <Picker x:Name="InstrPicker" TextColor="{StaticResource TextColor}" TitleColor="{StaticResource TextMuted}" Title="Seçin" ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="InstrPicker_Changed" />
                    </Border>
                </VerticalStackLayout>

                <!-- Hediye çeki kodu (yalnız Hediye Çeki yönteminde) -->
                <VerticalStackLayout x:Name="GiftPanel" Spacing="6" IsVisible="False">
                    <Label Text="HEDİYE ÇEKİ KODU" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                            <Entry x:Name="GiftCodeEntry" Placeholder="Kod girin" TextColor="{StaticResource TextColor}" PlaceholderColor="{StaticResource TextMuted}" BackgroundColor="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Text="Sorgula" Clicked="QueryGift_Clicked" BackgroundColor="{StaticResource Purple}" TextColor="White" FontAttributes="Bold" CornerRadius="10" Padding="14,0" />
                    </Grid>
                    <Label x:Name="GiftInfoLbl" Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- Puan/Sadakat bilgisi (yalnız Puan yönteminde) -->
                <Label x:Name="LoyaltyInfoLbl" Style="{StaticResource Muted}" IsVisible="False" />

                <!-- Tutar -->
                <Label Text="TUTAR" Style="{StaticResource FieldLabel}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                        <Entry x:Name="AmountEntry" Keyboard="Numeric" IsReadOnly="True" Text="0" TextColor="{StaticResource TextColor}" BackgroundColor="Transparent" FontSize="20" FontAttributes="Bold" />
                    </Border>
                    <Button Grid.Column="1" Text="Kalanı Doldur" FontSize="12" Clicked="FillRemaining_Clicked" Style="{StaticResource GhostButton}" Padding="12,0" />
                </Grid>

                <!-- Numpad -->
                <Grid x:Name="NumpadGrid" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*" RowSpacing="6" ColumnSpacing="6">
                    <Button Text="7" Grid.Row="0" Grid.Column="0" Clicked="Numpad_Clicked" CommandParameter="7" Style="{StaticResource NumpadButton}" />
                    <Button Text="8" Grid.Row="0" Grid.Column="1" Clicked="Numpad_Clicked" CommandParameter="8" Style="{StaticResource NumpadButton}" />
                    <Button Text="9" Grid.Row="0" Grid.Column="2" Clicked="Numpad_Clicked" CommandParameter="9" Style="{StaticResource NumpadButton}" />
                    <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="Numpad_Clicked" CommandParameter="4" Style="{StaticResource NumpadButton}" />
                    <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="Numpad_Clicked" CommandParameter="5" Style="{StaticResource NumpadButton}" />
                    <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="Numpad_Clicked" CommandParameter="6" Style="{StaticResource NumpadButton}" />
                    <Button Text="1" Grid.Row="2" Grid.Column="0" Clicked="Numpad_Clicked" CommandParameter="1" Style="{StaticResource NumpadButton}" />
                    <Button Text="2" Grid.Row="2" Grid.Column="1" Clicked="Numpad_Clicked" CommandParameter="2" Style="{StaticResource NumpadButton}" />
                    <Button Text="3" Grid.Row="2" Grid.Column="2" Clicked="Numpad_Clicked" CommandParameter="3" Style="{StaticResource NumpadButton}" />
                    <Button Text="." Grid.Row="3" Grid.Column="0" Clicked="Numpad_Clicked" CommandParameter="." Style="{StaticResource NumpadButton}" />
                    <Button Text="0" Grid.Row="3" Grid.Column="1" Clicked="Numpad_Clicked" CommandParameter="0" Style="{StaticResource NumpadButton}" />
                    <Button Text="⌫" Grid.Row="3" Grid.Column="2" Clicked="Numpad_Clicked" CommandParameter="back" Style="{StaticResource NumpadButton}" />
                </Grid>

                <!-- Bölme -->
                <Label Text="BÖLME" Style="{StaticResource FieldLabel}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <Button Text="Tamamı"    Clicked="Split_Clicked" CommandParameter="full" Style="{StaticResource SplitButton}" />
                    <Button Text="1/2"       Clicked="Split_Clicked" CommandParameter="2"    Style="{StaticResource SplitButton}" />
                    <Button Text="1/3"       Clicked="Split_Clicked" CommandParameter="3"    Style="{StaticResource SplitButton}" />
                    <Button Text="1/4"       Clicked="Split_Clicked" CommandParameter="4"    Style="{StaticResource SplitButton}" />
                    <Button Text="Kişi Başı" Clicked="Split_Clicked" CommandParameter="cover" Style="{StaticResource SplitButton}" />
                    <Button Text="Kalanı Öde" Clicked="Split_Clicked" CommandParameter="rest" Style="{StaticResource SplitButton}" />
                </FlexLayout>

                <Button Text="＋ Ödeme Ekle" Clicked="AddPayment_Clicked" BackgroundColor="{StaticResource Purple}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="46" />

                <!-- Eklenen ödemeler -->
                <Border Style="{StaticResource Card}" Padding="6">
                    <VerticalStackLayout>
                        <Label Text="EKLENEN ÖDEMELER" Style="{StaticResource FieldLabel}" Margin="8,4" />
                        <CollectionView x:Name="PaymentsView" HeightRequest="130">
                            <CollectionView.EmptyView>
                                <Label Text="Henüz ödeme eklenmedi." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,16,0,0" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="p:PaymentRow">
                                    <Grid Padding="10,8" ColumnDefinitions="*,Auto,Auto" BackgroundColor="{StaticResource Row}">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding KindText}" TextColor="{StaticResource TextColor}" FontAttributes="Bold" />
                                            <Label Text="{Binding InstrumentName}" Style="{StaticResource Muted}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₺{0:N2}'}" TextColor="{StaticResource TextColor}" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,12,0" />
                                        <Button Grid.Column="2" Text="✕" Clicked="RemovePayment_Clicked" BackgroundColor="Transparent" TextColor="{StaticResource Danger}" FontAttributes="Bold" Padding="6,0" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="ErrorLbl" TextColor="{StaticResource Danger}" IsVisible="False" FontAttributes="Bold" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Tamamla -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="14,10">
            <Button x:Name="CompleteBtn" Text="✓ ÖDEMEYİ TAMAMLA" Clicked="Complete_Clicked" Style="{StaticResource PrimaryButton}" />
        </Border>
    </Grid>
</ContentPage>
