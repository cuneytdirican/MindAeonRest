<?xml version="1.0" encoding="UTF-8" ?>
<!-- Adisyon stilleri (palet AYRI: PaletteLight/Dark/Ocean). Renkler DynamicResource → tema anında değişir. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="2,8,0,2" />
    </Style>
    <Style x:Key="Input" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Ödeme numpad tuşu -->
    <Style x:Key="NumpadButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Ödeme bölme tuşu -->
    <Style x:Key="SplitButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="WidthRequest" Value="92" />
        <Setter Property="Margin" Value="3" />
    </Style>

</ResourceDictionary>
