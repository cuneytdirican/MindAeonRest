<?xml version="1.0" encoding="utf-8"?>
<!-- IIS WebDAV modülü PUT/DELETE/PATCH verb'lerini ASP.NET Core'a ulaşmadan 405 ile engeller.
     Bu API güncelleme (PUT) ve silme (DELETE) kullandığından WebDAV bu site için KAPATILIR.
     dotnet publish bu dosyayı dönüştürüp <aspNetCore> handler'ını otomatik ekler. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
