{
  "name": "MindAeon Garson",
  "short_name": "Garson",
  "description": "MindAeonRest garson terminali (PWA)",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
