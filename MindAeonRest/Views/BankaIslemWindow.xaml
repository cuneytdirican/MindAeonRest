<Window x:Class="MindAeonRest.Views.BankaIslemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Banka İşlem" Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Banka İşlem" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel x:Name="CustomerPanel" Visibility="Collapsed">
                    <TextBlock Text="CARİ" Style="{StaticResource FieldLabel}" />
                    <views:EntityPicker x:Name="CustomerPicker" Margin="0,0,0,12" />
                </StackPanel>
                <StackPanel x:Name="TargetPanel" Visibility="Collapsed">
                    <TextBlock Text="HEDEF HESAP" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TargetCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" Margin="0,0,0,12" />
                </StackPanel>
                <TextBlock Text="TUTAR" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AmountBox" Style="{StaticResource InputTextBox}" FontSize="20" />
                <TextBlock Text="AÇIKLAMA" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
