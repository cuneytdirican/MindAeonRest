<Window x:Class="MindAeonRest.Views.MasaBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindAeonRest POS - Masalar"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PosBgBrush}">
    <Window.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Sol panel görünüm geçişi sekmesi (RadioButton) -->
            <Style x:Key="PosPanelTab" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource PosMutedBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="6,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PosAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Masa kartı -->
            <Style x:Key="PosTableCard" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="172" />
                <Setter Property="Height" Value="124" />
                <Setter Property="Margin" Value="9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="14" Background="{Binding StatusColor}"
                                    BorderBrush="{Binding BorderColor}" BorderThickness="1.5">
                                <Grid Margin="14,11">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Display}" FontSize="17" FontWeight="Bold" Foreground="{Binding TextColor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding AmountText}" FontSize="20" FontWeight="Bold" Foreground="{Binding TextColor}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding ElapsedText}" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="{Binding SubTextColor}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding SubTextColor}" />
                                        </DockPanel>
                                        <TextBlock FontSize="11" Foreground="{Binding SubTextColor}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding WaiterName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.78" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst bar -->
        <Border Grid.Row="0" Background="{StaticResource PosHeaderBrush}" Height="60">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" FontSize="24" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Cursor="Hand" Click="Back_Click" />
                    <TextBlock Text="MindAeonRest" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="POS" FontSize="20" FontWeight="Light" Foreground="#FFD0E0" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="MASALAR" FontSize="14" Foreground="#F0D9EA" VerticalAlignment="Center" Margin="26,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="BranchText" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="UserText" Foreground="#F0D9EA" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Click="Lock_Click" ToolTip="Ekranı kilitle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Kilitle" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="5,0,8,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="✕" FontSize="14" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand" Click="Back_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <!-- Sol araç çubuğu -->
            <Border Grid.Column="0" Background="{StaticResource PosSidebarBrush}">
                <StackPanel Margin="6,14,6,14">
                    <Button Style="{StaticResource PosToolButton}" Click="Refresh_Click">
                        <StackPanel><TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Yenile" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Edit_Click">
                        <StackPanel><TextBlock Text="✎" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Düzenle" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Paket_Click">
                        <StackPanel><TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Paket" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Notlar_Click">
                        <StackPanel><TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Notlar" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Tasi_Click">
                        <StackPanel><TextBlock Text="➡" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Taşı" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Bol_Click">
                        <StackPanel><TextBlock Text="✂" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Böl" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PosToolButton}" Click="Birlestir_Click">
                        <StackPanel><TextBlock Text="⊕" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="Birleştir" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                    <Button x:Name="RefundToolButton" Style="{StaticResource PosToolButton}" Click="Refund_Click">
                        <StackPanel><TextBlock Text="↩" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="İade" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Açık adisyonlar / Ödeme bekleyen masalar -->
            <Border Grid.Column="1" Background="{StaticResource PosCardBrush}" Margin="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Görünüm geçişi: Açık Adisyonlar | Ödeme Bekleyen -->
                    <Border Grid.Row="0" Background="{DynamicResource PosSubtleBrush}" CornerRadius="10" Margin="14,16,14,4" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <RadioButton x:Name="TabAdisyon" Grid.Column="0" GroupName="LeftPanel" IsChecked="True"
                                         Content="Açık Adisyonlar" Checked="LeftTab_Changed" Style="{StaticResource PosPanelTab}" />
                            <RadioButton x:Name="TabUnpaid" Grid.Column="1" GroupName="LeftPanel"
                                         Content="Ödeme Bekleyen" Checked="LeftTab_Changed" Style="{StaticResource PosPanelTab}" />
                        </Grid>
                    </Border>

                    <!-- ÖDEME BEKLEYEN/AÇIK MASALAR (V2 paritesi) -->
                    <TextBlock x:Name="UnpaidCountText" Grid.Row="1" Text="0 masa" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PosMutedBrush}" Margin="18,8,18,6" Visibility="Collapsed" />
                    <ListBox x:Name="UnpaidList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Unpaid_DoubleClick" Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="6,3" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PosSubtleBrush}" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Satır 1: masa/teslim adı + kanal rozeti + durum rozeti -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="{DynamicResource PosTextBrush}" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding DisplayLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                            <!-- Masasız (paket/gel-al/self-servis/kiosk) sipariş kanal rozeti -->
                                            <Border Grid.Column="1" CornerRadius="7" Padding="7,2" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource PosAccentBrush}"
                                                    Visibility="{Binding IsNonTable, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ChannelText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <Border Grid.Column="2" x:Name="StatusBadge" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>

                                        <!-- Satır 2: zone · garson · kişi · süre -->
                                        <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource PosMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ZoneName, Mode=OneWay, TargetNullValue='-'}" /><Run Text=" · " /><Run Text="{Binding WaiterName, Mode=OneWay, TargetNullValue='-'}" /><Run Text="   " /><Run Text="{Binding CoverCount, Mode=OneWay}" /><Run Text=" kişi · " /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Satır 3: toplam + kalan -->
                                        <Grid Grid.Row="2" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TOPLAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PosMutedBrush}" />
                                                <TextBlock Text="{Binding TotalText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PosTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="KALAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PosMutedBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding RemainingText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PosAccentBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Kısmi = amber -->
                                    <DataTrigger Binding="{Binding StatusText}" Value="Kısmi Ödendi">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <!-- Ödeme Bekliyor = kırmızı -->
                                    <DataTrigger Binding="{Binding StatusText}" Value="Ödeme Bekliyor">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <!-- Açık = yeşil/nötr -->
                                    <DataTrigger Binding="{Binding StatusText}" Value="Açık">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- AÇIK ADİSYONLAR (varsayılan görünüm) -->
                    <TextBlock x:Name="AdisyonCountText" Grid.Row="1" Text="0 ADİSYON" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PosTextBrush}" Margin="18,8,18,6" />
                    <ListBox x:Name="AdisyonList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Adisyon_DoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="6,3" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PosSubtleBrush}" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TableCodes}" FontWeight="SemiBold" Foreground="{StaticResource PosTextBrush}" />
                                            <TextBlock Text="{Binding CustomerName}" FontSize="11" Foreground="{StaticResource PosMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" Foreground="{StaticResource PosAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" BorderBrush="{StaticResource PosBorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                        <Grid>
                            <TextBlock x:Name="LeftFooterLabel" Text="TOPLAM" FontWeight="Bold" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AdisyonTotalText" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PosTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Masa board -->
            <Grid Grid.Column="2" Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BreadcrumbText" Grid.Row="0" Text="Katlar › —" FontSize="14" Foreground="{StaticResource PosMutedBrush}" Margin="6,2,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BoardHost">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosTableCard}" Click="Table_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Bu lokasyonda masa yok. Yönetim → Masa Planı'ndan ekleyin."
                           Foreground="{StaticResource PosMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <!-- Sağ salon sekmeleri -->
            <Border Grid.Column="3" Background="{StaticResource PosSidebarBrush}">
                <DockPanel Margin="0,16,0,16">
                    <TextBlock DockPanel.Dock="Top" Text="LOKASYONLAR" Foreground="#E7C9DD" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,16,10" />
                    <ListBox x:Name="SalonList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PosSalonTab}" SelectionChanged="Salon_Changed">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
