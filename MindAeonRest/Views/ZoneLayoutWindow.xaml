<Window x:Class="MindAeonRest.Views.ZoneLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masa Yerleşim Planı" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Masa Yerleşim Planı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Lokasyon seçin, kare/yuvarlak masa ekleyip sürükleyerek yerleştirin. Koordinatlar kaydedilir." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- Araç çubuğu -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Lokasyon:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ZoneCombo" Width="240" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}"
                              SelectedValuePath="Value" Tag="Lokasyon seçin" SelectionChanged="Zone_Changed">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◻ Kare Masa" Style="{StaticResource GhostButton}" Width="120" Click="AddSquare_Click" />
                    <Button Content="◯ Yuvarlak Masa" Style="{StaticResource GhostButton}" Width="140" Margin="8,0,0,0" Click="AddRound_Click" />
                    <Button Content="🗑 Sil" Style="{StaticResource GhostButton}" Width="80" Margin="8,0,0,0" Click="DeleteTable_Click" />
                    <Button Content="KAYDET" Style="{StaticResource PrimaryButton}" Width="140" Margin="8,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>

            <!-- İçerik: plan + özellik paneli -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TableHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas x:Name="DesignCanvas" Width="1400" Height="900" Background="Transparent" MouseLeftButtonDown="Canvas_MouseDown" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas Width="{Binding ContainerWidth}" Height="{Binding ContainerHeight}" Background="Transparent">
                                        <!-- Sandalyeler -->
                                        <ItemsControl ItemsSource="{Binding Chairs}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="13" Height="13" CornerRadius="4" Background="{DynamicResource TextMutedBrush}" Opacity="0.75" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Masa -->
                                        <Border x:Name="shape" Canvas.Left="{Binding TableMargin}" Canvas.Top="{Binding TableMargin}"
                                                Width="{Binding Width}" Height="{Binding Height}"
                                                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                                Cursor="SizeAll"
                                                PreviewMouseLeftButtonDown="Table_MouseDown" MouseMove="Table_MouseMove" PreviewMouseLeftButtonUp="Table_MouseUp">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                                                <TextBlock Text="{Binding SeatsText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Shape}" Value="Yuvarlak">
                                                            <Setter Property="CornerRadius" Value="1000" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Özellik paneli -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel x:Name="PropsPanel" IsEnabled="False">
                        <TextBlock Text="SEÇİLİ MASA" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="NoSelText" Text="Bir masa seçin veya ekleyin." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />

                        <TextBlock Text="KOD" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" TextChanged="CodeBox_Changed" />

                        <TextBlock Text="AD" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" TextChanged="NameBox_Changed" />

                        <TextBlock Text="ŞEKİL" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <ComboBox x:Name="ShapeCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Shape_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="KİŞİ SAYISI" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <TextBox x:Name="SeatsBox" Style="{StaticResource InputTextBox}" TextChanged="Seats_Changed" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EN" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="WidthBox" Style="{StaticResource InputTextBox}" TextChanged="Size_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BOY" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HeightBox" Style="{StaticResource InputTextBox}" TextChanged="Size_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
