<Window x:Class="MindAeonRest.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hızlı Ekle" SizeToContent="Height" MinHeight="300" Width="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Hızlı Ekle" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Ekrandan çıkmadan yeni kayıt ekleyin." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <StackPanel x:Name="Field1Panel">
                    <TextBlock x:Name="Label1" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="Box1" Style="{StaticResource InputTextBox}" />
                </StackPanel>
                <TextBlock x:Name="Label2" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <TextBox x:Name="Box2" Style="{StaticResource InputTextBox}" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="EKLE" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
