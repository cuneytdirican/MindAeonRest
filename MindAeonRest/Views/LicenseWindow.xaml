<Window x:Class="MindAeonRest.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lisans" Height="660" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="16,16,0,0" Padding="26,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🔐 Lisans" FontSize="21" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="CompanyText" Text="" FontSize="12.5" Foreground="#EAF7FF" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="✕" Width="36" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,16,26,8">
                <StackPanel>
                    <!-- DURUM -->
                    <Border x:Name="StatusCard" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DURUM" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="StatusText" Text="" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DONANIM KİMLİĞİ (bu makine)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HwBox" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,14" />

                    <!-- 1) TALEP ANAHTARI -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1️⃣ ETKİNLEŞTİR — paketi seçin, &quot;🌐 Online Etkinleştir&quot;e basın" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Gerisi otomatik: talep sunucuya gönderilir, lisansınız onaylıysa anında etkinleşir. (İnternet yoksa anahtarı kopyalayıp bize iletin — offline.)" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Bayi Kodu (varsa):" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="DealerBox" Width="160" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" TextChanged="Dealer_Changed"
                                         ToolTip="Bayinizin verdiği kod. Boş bırakılırsa doğrudan satış olarak işlenir." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Paket:" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="PkgCombo" Width="180" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Pkg_Changed">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="📋 Kopyala (offline)" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="14,4" Click="CopyRequest_Click" />
                                <Button x:Name="OnlineBtn" Content="🌐 Online Etkinleştir" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="16,4" Click="OnlineActivate_Click" />
                            </StackPanel>
                            <TextBox x:Name="RequestBox" Style="{StaticResource InputTextBox}" IsReadOnly="True" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- 2) LİSANS ANAHTARI -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="2️⃣ OFFLINE (internet yoksa) — bizden gelen anahtarı yapıştırın" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBox x:Name="LicenseBox" Style="{StaticResource InputTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11" Margin="0,8,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✓ ETKİNLEŞTİR" Style="{StaticResource PrimaryButton}" Padding="22,6" Click="Activate_Click" />
                                <Button Content="📁 Dosyadan Yükle (.lic)" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="14,6" Click="LoadFile_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,16,16" Padding="22,12">
                <Grid>
                    <TextBlock Text="💡 Talep anahtarını bize iletin, lisans anahtarını alıp yapıştırın." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TrialButton" Content="Deneme ile Devam" Style="{StaticResource GhostButton}" Padding="16,4" Margin="0,0,10,0" Click="Trial_Click" Visibility="Collapsed" />
                        <Button Content="Kapat" Style="{StaticResource GhostButton}" Padding="20,4" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
