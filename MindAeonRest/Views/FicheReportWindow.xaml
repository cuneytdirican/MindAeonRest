<Window x:Class="MindAeonRest.Views.FicheReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiş / Adisyon Raporu" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="📑 Fiş / Adisyon Raporu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- FİLTRELER -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="FromBox" Width="140" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="ToBox" Width="140" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="220" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ARA (ürün/fiş/garson)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" Width="200" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <Button Content="🔍 GÖSTER" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" VerticalAlignment="Bottom" Click="Show_Click" />
                </WrapPanel>
            </Border>

            <!-- SEKMELER + EXPORT -->
            <Grid Grid.Row="2" Margin="0,12,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabFiches" Content="FİŞLER" GroupName="tab" IsChecked="True" Checked="Tab_Changed" Style="{StaticResource TabToggle}" />
                    <RadioButton x:Name="TabCancels" Content="İPTALLER" GroupName="tab" Checked="Tab_Changed" Style="{StaticResource TabToggle}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📊 Excel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Excel_Click" />
                    <Button Content="📄 PDF" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Pdf_Click" />
                    <Button Content="CSV" Style="{StaticResource GhostButton}" Click="Csv_Click" />
                </StackPanel>
            </Grid>

            <!-- GRIDLER -->
            <Grid Grid.Row="3">
                <DataGrid x:Name="FichesGrid" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fiş No" Binding="{Binding FicheCode}" Width="100" />
                        <DataGridTextColumn Header="Adisyon" Binding="{Binding OrderCode}" Width="100" />
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="130" />
                        <DataGridTextColumn Header="Şube" Binding="{Binding BranchName}" Width="120" />
                        <DataGridTextColumn Header="Lokasyon" Binding="{Binding ZoneName}" Width="110" />
                        <DataGridTextColumn Header="Masa" Binding="{Binding TableCodes}" Width="90" />
                        <DataGridTextColumn Header="Garson" Binding="{Binding WaiterName}" Width="120" />
                        <DataGridTextColumn Header="Kasiyer" Binding="{Binding CashierName}" Width="120" />
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="130" />
                        <DataGridTextColumn Header="İndirim" Binding="{Binding DiscountText}" Width="90" />
                        <DataGridTextColumn Header="İkram" Binding="{Binding TreatText}" Width="90" />
                        <DataGridTextColumn Header="Ödeme" Binding="{Binding Payments}" Width="170" />
                        <DataGridTextColumn Header="Tutar" Binding="{Binding TotalText}" Width="100" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="CancelsGrid" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="130" />
                        <DataGridTextColumn Header="Adisyon" Binding="{Binding OrderCode}" Width="110" />
                        <DataGridTextColumn Header="Masa" Binding="{Binding TableCodes}" Width="100" />
                        <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="220" />
                        <DataGridTextColumn Header="Miktar" Binding="{Binding QtyText}" Width="80" />
                        <DataGridTextColumn Header="Tutar" Binding="{Binding AmountText}" Width="110" />
                        <DataGridTextColumn Header="Sebep" Binding="{Binding Reason}" Width="200" />
                        <DataGridTextColumn Header="İptal Eden" Binding="{Binding CancelledByName}" Width="140" />
                        <DataGridTextColumn Header="Akıbet" Binding="{Binding Disposition}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ÖZET -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,8" Margin="0,10,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="—" />
            </Border>
        </Grid>
    </Border>
</Window>
