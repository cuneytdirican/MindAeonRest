<Window x:Class="MindAeonRest.Views.SupervisorAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yetkili Onayı" Height="380" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🔑 Yetkili Onayı" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />
            <TextBlock x:Name="MsgText" Grid.Row="1" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UserBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="ŞİFRE" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <PasswordBox x:Name="PwdBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontSize="16" Padding="12,0" Height="46" VerticalContentAlignment="Center" KeyDown="Pwd_KeyDown" />
                    </Border>
                    <Button Grid.Column="2" Content="⌨" FontSize="20" Width="50" Height="48" Cursor="Hand"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Keyboard_Click" ToolTip="Sanal klavye" />
                </Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="ONAYLA" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
