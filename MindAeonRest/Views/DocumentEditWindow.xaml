<Window x:Class="MindAeonRest.Views.DocumentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Evrak" Height="800" Width="1280" MinHeight="600" MinWidth="980" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="Evrak" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,3" Margin="14,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FisNoText" Text="Fiş No (sistem): otomatik" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   ToolTip="Fiş No bizim seri numaramızdır (firma bazında otomatik ve eşsiz). Belge No ise firmadan gelen/resmi belge numarasıdır." />
                    </Border>
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- Üst bilgiler -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="BELGE NO *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BelgeNoBox" Style="{StaticResource InputTextBox}" ToolTip="Firmadan gelen ya da resmi evrak belge numarası (Fiş No ayrı, sistem tarafından otomatik)." /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="TARİH *" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="DateBox" Height="40" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="BELGE TARİHİ *" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="BelgeTarihiBox" Height="40" /></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="DÖVİZ *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="CurrencyCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectionChanged="Currency_Changed" /></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="ŞUBE *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="BranchCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectionChanged="Branch_Changed" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="DEPO *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="WarehouseCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="PROJE (opsiyonel)" Style="{StaticResource FieldLabel}" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProjectCombo" Grid.Column="0" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                                <Button x:Name="AddProjectBtn" Grid.Column="2" Content="+" Width="44" Height="40" Style="{StaticResource GhostButton}" FontSize="20" FontWeight="Bold" ToolTip="Yeni proje" Click="AddProject_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="PERSONEL (opsiyonel)" Style="{StaticResource FieldLabel}" /><views:EntityPicker x:Name="PersonnelPicker" /></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="4">
                        <StackPanel x:Name="CustomerPanel" Margin="0,0,10,0"><TextBlock Text="CARİ *" Style="{StaticResource FieldLabel}" /><views:EntityPicker x:Name="CustomerPicker" /></StackPanel>
                        <StackPanel x:Name="AddressPanel" Margin="0,0,10,0"><TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="AddressCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                        <StackPanel x:Name="TargetBranchPanel" Margin="0,0,10,0" Visibility="Collapsed"><TextBlock Text="HEDEF ŞUBE" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TargetBranchCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectionChanged="TargetBranch_Changed" /></StackPanel>
                        <StackPanel x:Name="TargetWarehousePanel" Margin="0,0,0,0" Visibility="Collapsed"><TextBlock Text="HEDEF DEPO" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TargetWarehouseCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                        <StackPanel x:Name="ExpensePanel" Margin="0,0,0,0" Visibility="Collapsed"><TextBlock Text="GİDER TİPİ" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ExpenseCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Satır girişi -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="0.9*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="0.8*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="ÜRÜN (stok ara / + ile ekle)" Style="{StaticResource FieldLabel}" /><views:EntityPicker x:Name="ProductPicker" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="MİKTAR" Style="{StaticResource FieldLabel}" /><TextBox x:Name="QtyBox" Style="{StaticResource InputTextBox}" Text="1" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="FİYAT" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PriceBox" Style="{StaticResource InputTextBox}" Text="0" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="İSK %" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DiscBox" Style="{StaticResource InputTextBox}" Text="0" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="KDV GRUBU" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TaxCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                    <Button Grid.Column="10" Content="+ EKLE" Style="{StaticResource PrimaryButton}" Width="100" VerticalAlignment="Bottom" Height="40" Click="AddLine_Click" />
                </Grid>
            </Border>

            <!-- Satırlar -->
            <DataGrid x:Name="LinesGrid" Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource DataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="EditDiscounts_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="40" />
                    <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="2.4*" />
                    <DataGridTextColumn Header="Miktar" Binding="{Binding Qty, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="Fiyat" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="İskonto ₺" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="İndirim %(10'a kadar)" Binding="{Binding DiscountChainText}" Width="1.4*" />
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="% İskonto (10)" Style="{StaticResource GhostButton}" Padding="8,2" Height="28" Margin="2"
                                        Click="RowDiscounts_Click" Tag="{Binding}" ToolTip="Bu satıra 10'a kadar zincirli iskonto" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="KDV%" Binding="{Binding TaxRate, StringFormat=0.#}" Width="70" />
                    <DataGridTextColumn Header="Matrah" Binding="{Binding LineNet, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="KDV" Binding="{Binding LineTax, StringFormat=N2}" Width="*" />
                    <DataGridTextColumn Header="Toplam" Binding="{Binding LineTotal, StringFormat=N2}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Alt: toplamlar + butonlar -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑 Satır Sil" Style="{StaticResource GhostButton}" Width="110" Click="RemoveLine_Click" />
                    <Button Content="% İskontolar (10)" Style="{StaticResource GhostButton}" Width="150" Margin="8,0,0,0" Click="EditDiscounts_Click" />
                    <Button Content="⌨" Style="{StaticResource GhostButton}" Width="48" Margin="8,0,0,0" Click="Keyboard_Click" ToolTip="Sanal klavye (seçili alana yazar)" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="GrossText" Text="Ara Toplam: 0,00" Margin="0,0,18,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="DiscText" Text="İskonto: 0,00" Margin="0,0,18,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="SubText" Text="Matrah: 0,00" Margin="0,0,18,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="TaxText" Text="KDV: 0,00" Margin="0,0,18,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="GrandText" Text="GENEL: 0,00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="FxText" Text="" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Vazgeç" Style="{StaticResource GhostButton}" Width="100" Click="Cancel_Click" />
                    <Button Content="KAYDET (taslak)" Style="{StaticResource GhostButton}" Width="140" Margin="8,0,0,0" Click="Save_Click"
                            ToolTip="Taslak olarak kaydeder. Cari/stok hareketi OLUŞMAZ; sonradan listeden 'İşle' gerekir." />
                    <Button Content="💾 KAYDET ve İŞLE" Style="{StaticResource PrimaryButton}" Width="190" Margin="8,0,0,0" Click="SavePost_Click"
                            ToolTip="Kaydeder ve işler: cari/stok hareketlerini oluşturur, ekstrelerde anında görünür." />
                    <Button Content="KAYDET + YAZDIR" Style="{StaticResource PrimaryButton}" Width="170" Margin="8,0,0,0" Click="SavePrint_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
