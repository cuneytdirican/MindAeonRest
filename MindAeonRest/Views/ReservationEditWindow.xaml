<Window x:Class="MindAeonRest.Views.ReservationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Rezervasyon" Height="660" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Yeni Rezervasyon" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SubText" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="MÜŞTERİ (Misafir)" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                <views:EntityPicker x:Name="CustomerPicker" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TARİH" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateBox" Height="40" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="KİŞİ SAYISI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PartyBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BAŞLANGIÇ (SS:DD)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StartBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BİTİŞ (SS:DD)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EndBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ETİKET" Style="{StaticResource FieldLabel}" />
                        <views:EntityPicker x:Name="TagPicker" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DURUM" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StatusCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="MASALAR" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <ItemsControl x:Name="TablesHost">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="NOT" Style="{StaticResource FieldLabel}" Margin="2,8,0,6" />
                <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
