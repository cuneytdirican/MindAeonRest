<Window x:Class="MindAeonRest.Views.PaymentWindowV2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MindAeonRest.Views"
        Title="Ödeme Merkezi" WindowState="Maximized"
        WindowStyle="None" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:StringToBrushConverter x:Key="Brush" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ödeme bekleyen masa kartı -->
        <DataTemplate x:Key="UnpaidTpl">
            <Border Margin="0,0,0,8" CornerRadius="10" Padding="12,10" Cursor="Hand"
                    Background="{Binding RowBg, Converter={StaticResource Brush}}"
                    BorderBrush="{Binding BorderCol, Converter={StaticResource Brush}}" BorderThickness="1.5">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCmd}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <!-- Masasız sipariş kanal rozeti: Paket / Gel-Al / Kiosk -->
                            <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding ShowChannel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ChannelText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" />
                    </Grid>
                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,2,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Border CornerRadius="5" Padding="6,1" HorizontalAlignment="Left" Background="{Binding StatusBg, Converter={StaticResource Brush}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding RemainingInfo}" HorizontalAlignment="Right" Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- ÜST: adım şeridi + ciro + saat -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34">
                        <TextBlock Text="🍽" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ShopText" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" />
                        <TextBlock x:Name="CashierText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="StepsHost" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="BUGÜN" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Right" />
                        <TextBlock x:Name="CiroText" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" />
                    </StackPanel>
                    <TextBlock x:Name="ClockText" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="🎨" Click="Theme_Click" Margin="14,0,0,0" Padding="9,6" Cursor="Hand" ToolTip="Tema değiştir"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                    <Button Content="✕" Click="Close_Click" Margin="8,0,0,0" Padding="10,6" Cursor="Hand"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" /><ColumnDefinition Width="*" /><ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- SOL: ödeme bekleyen masalar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Margin="10" CornerRadius="12" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Masalar &amp; Siparişler" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="16" />
                        <TextBlock x:Name="UnpaidCount" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,2,0,8" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}" TextChanged="Search_Changed" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="FltAll" Content="Tümü" Tag="all" Click="Filter_Click" Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" FontSize="12" />
                            <Button x:Name="FltOpen" Content="Açık" Tag="open" Click="Filter_Click" Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            <Button x:Name="FltPay" Content="Ödeme Bekliyor" Tag="pay" Click="Filter_Click" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UnpaidHost" ItemTemplate="{StaticResource UnpaidTpl}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ORTA: adisyon -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Margin="0,10" CornerRadius="12" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="OrderTitle" Text="Masa seçin" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20" />
                                <TextBlock x:Name="OrderSub" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" />
                            </StackPanel>
                            <TextBlock x:Name="OrderOpened" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </Grid>
                        <Border x:Name="AllergyBanner" Background="#33EF4444" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AllergyText" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="12.5" />
                        </Border>
                        <Grid Margin="0,12,0,6">
                            <TextBlock x:Name="LinesHeader" Text="ADİSYON" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="LinesCount" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LineHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding QtyText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14.5" />
                                                    <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0" Background="{Binding StatusBg, Converter={StaticResource Brush}}">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Mods}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5"
                                                           Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LineTotalText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14.5" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding UnitText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- SAĞ: ödeme merkezi -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Margin="10" CornerRadius="12" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="💳 Ödeme Merkezi" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="16" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="KALAN TUTAR" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                    <TextBlock x:Name="RemainingBig" Text="₺0,00" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="28" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TotalSmall" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="PaidSmall" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14,8" Margin="0,8,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                            <Grid>
                                <TextBlock Text="GİRİLEN TUTAR" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock x:Name="AmountText" Text="₺0" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="22" />
                            </Grid>
                        </Border>

                        <!-- bölme -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Tamamı" Tag="all" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                            <Button Content="1/2" Tag="2" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                            <Button Content="1/3" Tag="3" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                            <Button Content="1/4" Tag="4" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                            <Button Content="Kişi Başı" Tag="cover" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                            <Button Content="Kalanı Öde" Tag="all" Click="Split_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,5,5" />
                        </WrapPanel>

                        <Button Content="➕ Ödeme Ekle" Click="AddPayment_Click" Margin="0,4,0,0" Padding="0,10" Cursor="Hand"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14"
                                ToolTip="Girilen tutarı seçili yöntemle ekle (karma/kısmi ödeme)" />

                        <TextBlock Text="ÖDEME YÖNTEMİ" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="11" Margin="0,8,0,4" />
                        <ItemsControl x:Name="MethodHost">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="86" Height="46" Margin="0,0,5,5" Tag="{Binding}" Click="Method_Click" BorderThickness="0" Cursor="Hand"
                                            Background="{Binding Bg}" Foreground="{Binding Fg}" FontSize="11" FontWeight="SemiBold" Content="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ComboBox x:Name="InstrumentCombo" Margin="0,6,0,0" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}"
                                  DisplayMemberPath="Text" SelectedValuePath="Value" Visibility="Collapsed" />
                        <v:EntityPicker x:Name="CustomerPicker" Margin="0,6,0,0" Visibility="Collapsed" />

                        <!-- Hediye Çeki: kod + sorgula + bakiye -->
                        <StackPanel x:Name="GiftPanel" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="GiftCodeBox" Grid.Column="0" Style="{StaticResource InputTextBox}" />
                                <Button x:Name="GiftQueryBtn" Grid.Column="1" Content="Sorgula" Click="GiftQuery_Click" Style="{StaticResource GhostButton}" Padding="12,0" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="GiftBalanceText" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="2,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Puan/Sadakat: bakiye/₺ karşılığı -->
                        <TextBlock x:Name="LoyaltyText" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- alt: aksiyonlar -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <ItemsControl x:Name="AddedHost" MaxHeight="90" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding AmountText, Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Content="✕" HorizontalAlignment="Right" Tag="{Binding}" Click="RemovePayment_Click" Padding="6,0"
                                                Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="CompleteBtn" Content="✓ Ödemeyi Al" Click="Complete_Click" Margin="0,8,0,0" Padding="0,14" Cursor="Hand"
                                Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <Button x:Name="ReceiptBtn" Content="🧾 Fiş" Click="Receipt_Click" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,6,0" />
                            <Button x:Name="HoldBtn" Content="⏸ Beklet" Click="Hold_Click" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,6,0" />
                            <Button x:Name="CancelBtn" Content="✕ İptal" Click="ClearPay_Click" Style="{StaticResource GhostButton}" Padding="14,8" />
                        </StackPanel>
                    </StackPanel>

                    <!-- orta: numpad -->
                    <UniformGrid Columns="3" x:Name="Numpad" Margin="0,10,0,0" VerticalAlignment="Top" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
