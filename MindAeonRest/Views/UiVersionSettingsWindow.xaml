<Window x:Class="MindAeonRest.Views.UiVersionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Sürümü" Height="470" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="🖥 Ekran Sürümü" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Adisyon ve Mutfak (KDS) ekranlarının görünümünü seçin." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="✕" Width="32" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="ADİSYON EKRANI" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="AdisyonCombo" Height="42" Margin="0,4,0,0" FontSize="14">
                    <ComboBoxItem Content="Varsayılan (mevcut ekran)" Tag="Varsayilan" />
                    <ComboBoxItem Content="V2 (yeni ekran)" Tag="V2" />
                </ComboBox>

                <TextBlock Text="MUTFAK (KDS) EKRANI" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                <ComboBox x:Name="MutfakCombo" Height="42" Margin="0,4,0,0" FontSize="14">
                    <ComboBoxItem Content="Varsayılan (mevcut ekran)" Tag="Varsayilan" />
                    <ComboBoxItem Content="V2 (yeni ekran)" Tag="V2" />
                </ComboBox>

                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                               Text="• Varsayılan: şu an kullandığınız ekranlar çalışır.&#10;• V2: yeni tasarlanan ekranlar çalışır (mevcut temalarla uyumlu).&#10;Yeni kurulumlar V2 ile başlar. Değişiklik ekranlar bir sonraki açılışta geçerli olur." />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="İptal" Style="{StaticResource GhostButton}" Width="100" Height="42" Click="Cancel_Click" />
                <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Width="120" Height="42" Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
