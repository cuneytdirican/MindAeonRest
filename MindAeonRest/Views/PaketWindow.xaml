<Window x:Class="MindAeonRest.Views.PaketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindAeonRest - Paket / Take Away"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PosBgBrush}">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosHeaderBrush}" Height="58">
            <Grid Margin="14,0">
                <TextBlock Text="PAKET / TAKE AWAY" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BranchText" Foreground="#F0D9EA" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="✕" FontSize="14" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand" Click="Back_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,12,14,0">
            <Button Content="＋ Yeni Paket" Style="{StaticResource PosAccentButton}" Width="150" Click="New_Click" />
            <Button x:Name="IncomingBtn" Content="Gelen Siparişler" Style="{StaticResource GhostButton}" Width="160" Margin="12,0,0,0" Click="ShowIncoming_Click" />
            <Button x:Name="OutgoingBtn" Content="Giden / Teslim" Style="{StaticResource GhostButton}" Width="150" Margin="8,0,0,0" Click="ShowOutgoing_Click" />
            <Button Content="🔄 Yenile" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="Refresh_Click" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="14,12,14,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- Sipariş listesi -->
            <Border Grid.Column="0" Background="{StaticResource PosCardBrush}" CornerRadius="12">
                <ListBox x:Name="OrderList" Background="Transparent" BorderThickness="0" Margin="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Order_Changed">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,3" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F6F7FA" CornerRadius="10" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Foreground="{StaticResource PosTextBrush}" FontWeight="SemiBold"><Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeliveryName, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding TotalText}" FontWeight="Bold" Foreground="{StaticResource PosAccentBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource PosMutedBrush}"><Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeliveryStatusText, Mode=OneWay}" /></TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detay -->
            <Border Grid.Column="2" Background="{StaticResource PosCardBrush}" CornerRadius="12">
                <Grid x:Name="DetailRoot" Margin="20" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DName" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosTextBrush}" />
                                <TextBlock x:Name="DInfo" FontSize="12" Foreground="{StaticResource PosMutedBrush}" />
                            </StackPanel>
                            <Border x:Name="DStatusBadge" Background="#E9A23B" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock x:Name="DStatus" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DAddr" FontSize="13" Foreground="{StaticResource PosTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="DNote" FontSize="12" FontStyle="Italic" Foreground="{StaticResource PosMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource PosBorderBrush}" BorderThickness="0,1,0,1" Margin="0,12" Padding="0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsHost">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,3">
                                        <TextBlock Foreground="{StaticResource PosTextBrush}"><Run Text="{Binding QtyText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ProductName, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding LineTotalText}" Foreground="{StaticResource PosTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Kurye:" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CourierCombo" Width="200" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Kurye Ata / Çağır" Style="{StaticResource GhostButton}" Width="150" Margin="8,0,0,0" Click="AssignCourier_Click" />
                        </StackPanel>
                        <UniformGrid Columns="4">
                            <Button Content="Hazırlanıyor" Style="{StaticResource PosLineToolBtn}" Click="StHazir_Click" />
                            <Button Content="Yola Çıktı" Style="{StaticResource PosLineToolBtn}" Click="StYola_Click" />
                            <Button Content="Teslim Edildi" Style="{StaticResource PosLineToolBtn}" Click="StTeslim_Click" />
                            <Button Content="İptal" Style="{StaticResource PosLineToolBtn}" Click="StIptal_Click" />
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Button Content="🍽 Ürün/Düzenle" Style="{StaticResource PosLineToolBtn}" Click="Edit_Click" />
                            <Button Content="🧾 Hesap Fişi" Style="{StaticResource PosLineToolBtn}" Click="Receipt_Click" />
                            <Button Content="ÖDEME AL" Style="{StaticResource PosGreenButton}" Height="40" Click="Pay_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
