<Window x:Class="MindAeonRest.Views.LoyaltyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Puan / Sadakat Raporu" Height="680" Width="900" MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <Border CornerRadius="8" Padding="12,5" HorizontalAlignment="Left" Background="#F59E0B">
                        <TextBlock Text="⭐ PUAN / SADAKAT RAPORU" FontWeight="Bold" Foreground="#1A1208" FontSize="12" />
                    </Border>
                    <TextBlock Text="Puan / Sadakat Raporu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,46,0">
                    <TextBlock Text="TOPLAM PUAN YÜKÜMLÜLÜĞÜ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="LiabilityText" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- MÜŞTERİ SEÇİMİ + BAKİYE -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MÜŞTERİ" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                        <views:EntityPicker x:Name="CustomerPicker" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="18,8" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="PUAN BAKİYESİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="BalanceText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="HAREKET EKSTRESİ (KAZANIM / HARCAMA)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,14,0,6" />

            <DataGrid x:Name="MovGrid" Grid.Row="3" Style="{StaticResource DataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding MoveDate, StringFormat=dd.MM.yyyy HH:mm}" Width="160" />
                    <DataGridTextColumn Header="Tip" Binding="{Binding TypeText}" Width="120" />
                    <DataGridTextColumn Header="Puan" Binding="{Binding Points, StringFormat=N0}" Width="120" />
                    <DataGridTextColumn Header="Tutar (₺)" Binding="{Binding Amount, StringFormat=N2}" Width="140" />
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
