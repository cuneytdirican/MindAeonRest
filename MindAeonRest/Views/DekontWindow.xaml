<Window x:Class="MindAeonRest.Views.DekontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Dekont" Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,24,30,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border x:Name="KindBadge" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                    <TextBlock x:Name="KindText" Text="DEKONT" FontWeight="Bold" Foreground="White" FontSize="13" />
                </Border>
                <TextBlock x:Name="TitleText" Text="Dekont" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                <TextBlock x:Name="SubText" Text="" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock x:Name="AccountLabel" Text="HESAP" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="AccountCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock x:Name="CustomerLabel" Text="CARİ (MÜŞTERİ / TEDARİKÇİ)" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <views:EntityPicker x:Name="CustomerPicker" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TUTAR (₺)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AmountBox" Style="{StaticResource InputTextBox}" FontSize="18" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TARİH" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateBox" Height="46" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="AÇIKLAMA" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="DEKONTU KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
