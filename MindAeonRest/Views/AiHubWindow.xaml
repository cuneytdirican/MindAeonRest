<Window x:Class="MindAeonRest.Views.AiHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Hub" Height="680" Width="760" MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="BubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧠" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="AI Hub" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="ProviderText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="⚙ Ayarlar" Style="{StaticResource GhostButton}" Width="100" Height="32" Click="Settings_Click" />
                    <Button Content="✕" Width="34" Height="32" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="0,12,0,0">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl x:Name="MessagesHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="12,9" CornerRadius="10" MaxWidth="640" Style="{StaticResource BubbleStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasTable, Converter={StaticResource B2V}}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding TableText}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="SpeakToggle" Grid.Column="0" Content="🔊" Width="44" Height="44" Margin="0,0,8,0" ToolTip="Sesli yanıt" />
                <Button x:Name="MicButton" Grid.Column="1" Content="🎤" Width="44" Height="44" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Click="Mic_Click" ToolTip="Sesle sor" />
                <TextBox x:Name="InputBox" Grid.Column="2" Style="{StaticResource InputTextBox}" Height="44" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
                <Button Grid.Column="3" Content="Gönder" Style="{StaticResource PrimaryButton}" Width="100" Height="44" Margin="8,0,0,0" Click="Send_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
