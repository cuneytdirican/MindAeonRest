<Window x:Class="MindAeonRest.Views.AdisyonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:MindAeonRest.Helpers"
        Title="MindAeonRest POS - Adisyon"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PosBgBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <h:ByteImageConverter x:Key="Img" />
            <BooleanToVisibilityConverter x:Key="B2V" />

            <!-- Ürün kartı -->
            <Style x:Key="PosProductCard" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="158" />
                <Setter Property="Height" Value="150" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="12" Background="{StaticResource PosCardBrush}" BorderBrush="{StaticResource PosBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{DynamicResource PosSubtleBrush}">
                                        <Image Source="{Binding Image, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="10,6,10,8">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PosTextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource PosAccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <!-- bilgi ikonu -->
                                    <Button x:Name="info" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                            Background="#CCFFFFFF" Foreground="{StaticResource PosTextBrush}" BorderThickness="0" Content="ℹ" FontSize="13"
                                            Click="Info_Click" Tag="{Binding}" />
                                    <!-- satışa kapalı -->
                                    <Border x:Name="stop" CornerRadius="12" Background="#AA2B2B3A" Visibility="Collapsed">
                                        <TextBlock Text="SATIŞA KAPALI" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PosAccentBrush}" /></Trigger>
                                <DataTrigger Binding="{Binding HasDescription}" Value="False"><Setter TargetName="info" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsSalesStopped}" Value="True"><Setter TargetName="stop" Property="Visibility" Value="Visible" /></DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PosLineToolBtn" TargetType="Button">
                <Setter Property="Background" Value="#F2F3F6" />
                <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E3E6EC" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Üst bar -->
        <Border Grid.Row="0" Background="{StaticResource PosHeaderBrush}" Height="58">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" FontSize="24" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Cursor="Hand" Click="Back_Click" />
                    <TextBlock x:Name="TableText" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock x:Name="ZoneText" FontSize="13" Foreground="#F0D9EA" VerticalAlignment="Center" Margin="12,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WaiterText" Foreground="#F0D9EA" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Click="Lock_Click" ToolTip="Ekranı kilitle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Kilitle" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="5,0,8,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="✕" FontSize="14" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand" Click="Back_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Sol: adisyon -->
            <Border Grid.Column="0" Background="{StaticResource PosCardBrush}" Margin="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Kişi seçici -->
                    <Border Grid.Row="0" Padding="12,12,12,8">
                        <StackPanel>
                            <TextBlock Text="KİŞİ" Foreground="{StaticResource PosMutedBrush}" FontSize="11" FontWeight="Bold" Margin="2,0,0,6" />
                            <WrapPanel x:Name="SeatHost" />
                        </StackPanel>
                    </Border>

                    <!-- Satırlar -->
                    <ListBox x:Name="LinesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Line_DoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PosSubtleBrush}" CornerRadius="6" Padding="10,4" Margin="2,8,2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PosTextBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock x:Name="qty" Grid.Row="0" Grid.Column="0" Text="{Binding QtyText}" FontWeight="Bold" Foreground="{StaticResource PosAccentBrush}" />
                                        <TextBlock x:Name="pname" Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" Foreground="{StaticResource PosTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ltot" Grid.Row="0" Grid.Column="2" Text="{Binding LineTotalText}" Foreground="{StaticResource PosTextBrush}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding KitchenNote}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource PosMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="  • İKRAM" FontSize="11" FontWeight="Bold" Foreground="#17B26A" Visibility="{Binding IsTreat, Converter={StaticResource B2V}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Menü alt-kırılımı (bileşen): girintili + "↳" + soluk; fiyat gizli (₺0 gürültüsü) -->
                                    <DataTrigger Binding="{Binding IsComponent}" Value="True">
                                        <Setter TargetName="row" Property="Margin" Value="22,0,0,0" />
                                        <Setter TargetName="qty" Property="Text" Value="↳" />
                                        <Setter TargetName="qty" Property="Foreground" Value="{StaticResource PosMutedBrush}" />
                                        <Setter TargetName="pname" Property="Foreground" Value="{StaticResource PosMutedBrush}" />
                                        <Setter TargetName="pname" Property="FontSize" Value="12" />
                                        <Setter TargetName="ltot" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Satır araçları -->
                    <UniformGrid Grid.Row="2" Columns="5" Margin="8,6">
                        <Button Content="İkram" Style="{StaticResource PosLineToolBtn}" Click="Treat_Click" />
                        <Button Content="İskonto" Style="{StaticResource PosLineToolBtn}" Click="Discount_Click" />
                        <Button Content="İptal" Style="{StaticResource PosLineToolBtn}" Click="CancelLine_Click" />
                        <Button Content="↻ Yazdır" Style="{StaticResource PosLineToolBtn}" Click="Reprint_Click" />
                        <Button Content="✂ Böl/Aktar" Style="{StaticResource PosLineToolBtn}" Click="SplitMove_Click" ToolTip="Seçili kişinin (koltuğun) kalemlerini boş masaya böl veya dolu masaya aktar" />
                    </UniformGrid>

                    <!-- Alt: gönder + öde -->
                    <StackPanel Grid.Row="3" Margin="12,4,12,14">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="VipToggle" Content="⭐ VIP" Style="{StaticResource PosLineToolBtn}" Click="Vip_Click" />
                            <Button Grid.Column="2" x:Name="PriorityToggle" Content="⏫ Öncelik" Style="{StaticResource PosLineToolBtn}" Click="Priority_Click" />
                            <Button Grid.Column="4" x:Name="AllergyBtn" Content="⚠ Alerji" Style="{StaticResource PosLineToolBtn}" Click="Allergy_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🖥  Müşteri Ekranı" Style="{StaticResource PosLineToolBtn}" Click="Customer_Click" />
                            <Button Grid.Column="2" x:Name="CampaignBtn" Content="🎁  Kampanya" Style="{StaticResource PosLineToolBtn}" Click="Campaign_Click" />
                        </Grid>
                        <Button Content="🍳  MUTFAĞA GÖNDER" Style="{StaticResource PosAccentButton}" Click="Send_Click" />
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="TOPLAM" FontWeight="Bold" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalText" Text="₺0,00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PosTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🧾 Hesap" Style="{StaticResource PosLineToolBtn}" Height="54" Click="Receipt_Click" />
                            <Button Grid.Column="2" x:Name="PayButton" Content="ÖDEME AL" Style="{StaticResource PosGreenButton}" Click="Pay_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Orta: ürünler -->
            <Grid Grid.Column="1" Margin="0,12,0,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,12,8">
                    <TextBlock x:Name="CrumbText" Text="Menüler › Tümü" FontSize="14" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox x:Name="SearchBox" Width="180" Style="{StaticResource PosSearchBox}" Tag="🔍 Ara" Height="40" TextChanged="Search_Changed" />
                        <Button Content="⌨" Width="44" Height="40" Margin="6,0,0,0" Style="{StaticResource PosLineToolBtn}" ToolTip="Sanal klavye" Click="Keyboard_Click" />
                        <TextBox x:Name="BarcodeBox" Width="160" Style="{StaticResource PosSearchBox}" Tag="⌗ Barkod" Height="40" Margin="8,0,0,0" KeyDown="Barcode_KeyDown" />
                    </StackPanel>
                </Grid>

                <!-- Fiyat Listesi seçimi: tıkla → fiyatlar o listeye göre güncellenir (şube özel fiyat öncelikli) -->
                <DockPanel Grid.Row="1" Margin="2,0,12,8">
                    <TextBlock DockPanel.Dock="Left" Text="FİYAT LİSTESİ:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PriceListBar" Orientation="Horizontal" />
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Row="2" Background="{StaticResource PosCardBrush}" CornerRadius="10" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <ItemsControl x:Name="ProductHost">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><Button Style="{StaticResource PosProductCard}" Click="Product_Click" Tag="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- EN ALTTA HER ZAMAN: kampanyalar. Kritere uyan kampanyada dönen kırmızı ışık + "KULLANILABİLİR" -->
                <Border Grid.Row="3" Background="{StaticResource PosCardBrush}" CornerRadius="10" Margin="0,10,12,0" Padding="10,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🎁 KAMPANYALAR" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CampaignHint" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource PosMutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CampaignHost">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="236" Margin="0,2,8,4">
                                            <!-- dönen kırmızı/sarı ışık halkası (uygun/uygulanmış kampanyada) -->
                                            <Border x:Name="glow" CornerRadius="13" BorderThickness="3" Visibility="Collapsed">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="rot" CenterX="0.5" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
                                                        <GradientStop Color="#FFFF2D2D" Offset="0" />
                                                        <GradientStop Color="#00FF2D2D" Offset="0.4" />
                                                        <GradientStop Color="#FFFFC400" Offset="0.5" />
                                                        <GradientStop Color="#00FF2D2D" Offset="0.6" />
                                                        <GradientStop Color="#FFFF2D2D" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Effect><DropShadowEffect Color="#FF2D2D" BlurRadius="16" ShadowDepth="0" Opacity="0.6" /></Border.Effect>
                                            </Border>
                                            <Border CornerRadius="11" Background="{StaticResource PosSubtleBrush}" Margin="3" Padding="11,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PosTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ShortText}" FontSize="11" Foreground="{StaticResource PosMutedBrush}" TextWrapping="Wrap" MaxHeight="32" Margin="0,2,0,0" />
                                                    <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold" Margin="0,5,0,0" />
                                                    <Button x:Name="applyBtn" Content="✓ UYGULA" Margin="0,7,0,0" Style="{StaticResource PosAccentButton}" Height="34" Click="ApplyCampaign_Click" Tag="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource PosMutedBrush}" />
                                                <Setter TargetName="applyBtn" Property="IsEnabled" Value="False" />
                                                <Setter TargetName="applyBtn" Property="Content" Value="kriter sağlanmadı" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEligible}" Value="True">
                                                <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="status" Property="Foreground" Value="#34D399" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="sb">
                                                        <Storyboard><DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever" /></Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="sb" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="applyBtn" Property="IsEnabled" Value="False" />
                                                <Setter TargetName="applyBtn" Property="Content" Value="✓ UYGULANDI" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sağ: kategoriler -->
            <Border Grid.Column="2" Background="{StaticResource PosSidebarBrush}">
                <DockPanel Margin="0,16,0,16">
                    <TextBlock DockPanel.Dock="Top" Text="KATEGORİLER" Foreground="#E7C9DD" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,16,10" />
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PosSalonTab}" SelectionChanged="Category_Changed">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
