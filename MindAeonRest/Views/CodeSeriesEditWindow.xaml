<Window x:Class="MindAeonRest.Views.CodeSeriesEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kod Serisi" Height="470" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Kod Serisi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Yeni kart açılışında otomatik artan kod önerilir." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="KART TİPİ" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TypeCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Tip" SelectionChanged="Field_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="ŞUBE (evrak serileri için; boş = tüm şubeler)" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <ComboBox x:Name="BranchCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ÖN EK" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PrefixBox" Style="{StaticResource InputTextBox}" TextChanged="Field_Changed2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BASAMAK" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PaddingBox" Style="{StaticResource InputTextBox}" Text="6" TextChanged="Field_Changed2" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="BAŞLANGIÇ NO" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NextBox" Style="{StaticResource InputTextBox}" Text="1" TextChanged="Field_Changed2" />
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sıradaki kod:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewText" Text="-" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ActiveCheck" Content="Seri aktif" Style="{StaticResource ThemedCheckBox}" Margin="2,16,0,0" IsChecked="True" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
