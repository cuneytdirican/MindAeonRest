<Window x:Class="MindAeonRest.Views.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rezervasyon" Height="800" Width="1220" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Rezervasyon" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Lokasyon ve zaman aralığı seçin; boş masaları işaretleyip rezerve edin." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- Araç çubuğu -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="LOKASYON" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ZoneCombo" Width="200" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="TARİH" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateBox" Width="140" Height="40" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StartBox" Width="80" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EndBox" Width="80" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <Button Content="Göster" Style="{StaticResource GhostButton}" Width="90" VerticalAlignment="Bottom" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <!-- İçerik -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TableHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas Width="1400" Height="900" Background="Transparent" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas Width="{Binding ContainerWidth}" Height="{Binding ContainerHeight}" Background="Transparent">
                                        <ItemsControl ItemsSource="{Binding Chairs}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><Border Width="13" Height="13" CornerRadius="4" Background="{DynamicResource TextMutedBrush}" Opacity="0.7" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Canvas.Left="{Binding TableMargin}" Canvas.Top="{Binding TableMargin}"
                                                Width="{Binding Width}" Height="{Binding Height}" BorderThickness="2" Cursor="Hand"
                                                MouseLeftButtonDown="Table_Click">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SeatsText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Shape}" Value="Yuvarlak"><Setter Property="CornerRadius" Value="1000" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding BoardState}" Value="1">
                                                            <Setter Property="BorderBrush" Value="#F44336" />
                                                            <Setter Property="Background" Value="#33F44336" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BoardState}" Value="2">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="#3300C853" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Sağ panel -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SEÇİLİ MASALAR" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="SelectedText" Text="Boş masalara tıklayarak seçin." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <Button x:Name="ReserveButton" Content="🗓  Rezerve Et" Style="{StaticResource PrimaryButton}" Click="Reserve_Click" IsEnabled="False" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Width="13" Height="13" CornerRadius="3" Background="#F44336" Margin="0,0,5,0" /><TextBlock Text="Dolu" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" />
                                <Border Width="13" Height="13" CornerRadius="3" Background="#00C853" Margin="0,0,5,0" /><TextBlock Text="Seçili" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="GÜNÜN REZERVASYONLARI" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                            <ListBox x:Name="DayList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="DayList_DoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="6" Background="{Binding TagColorOrDefault}" CornerRadius="8,0,0,8" />
                                                <StackPanel Margin="10,8">
                                                    <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold">
                                                        <Run Text="{Binding StartTime, StringFormat=HH:mm, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CustomerName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="{Binding TableCodes, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TagName}" Foreground="{Binding TagColorOrDefault}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="🍽  Adisyon Aç (masaya otur)" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="OpenOrder_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
