<Window x:Class="MindAeonRest.Views.PersonnelEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel" Height="640" Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Yeni Personel" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="KOD" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="AD SOYAD" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="GÖREV" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TitleBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="DEPARTMAN" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DepBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="TC KİMLİK" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TcBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="BranchCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="İŞE GİRİŞ" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="HireBox" Height="38" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="MAAŞ" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SalaryBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                </Grid>
                <CheckBox x:Name="ActiveCheck" Content="Aktif" Style="{StaticResource ThemedCheckBox}" Margin="2,14,0,0" IsChecked="True" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <!-- İzinler -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
                <Grid DockPanel.Dock="Top">
                    <TextBlock Text="İZİNLER" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ İzin" Style="{StaticResource GhostButton}" Width="80" Height="30" Click="AddLeave_Click" />
                        <Button Content="Sil" Style="{StaticResource GhostButton}" Width="70" Height="30" Margin="8,0,0,0" Click="DeleteLeave_Click" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="LeavesGrid" Margin="0,8,0,0" Style="{StaticResource DataGridStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="LeavesGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tür" Binding="{Binding TypeText}" Width="*" />
                        <DataGridTextColumn Header="Tarih Aralığı" Binding="{Binding RangeText}" Width="*" />
                        <DataGridTextColumn Header="Gün" Binding="{Binding DaysText}" Width="80" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Kapat" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
