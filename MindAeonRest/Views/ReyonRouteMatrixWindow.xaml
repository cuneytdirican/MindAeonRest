<Window x:Class="MindAeonRest.Views.ReyonRouteMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reyon Yönlendirme" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="🍳 Reyon Yönlendirme (Lokasyon → Kategori → Reyon → Yazıcı)" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Her lokasyonda, ürün kategorisi hangi reyona (mutfak/bar) düşsün? Reyonun yazıcısı = mutfak fişinin çıkacağı yazıcı. Yalnız o lokasyonun reyonları seçilebilir." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="190" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Branch_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="LOKASYON" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ZoneCombo" Width="220" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Zone_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="BU LOKASYONUN VARSAYILAN REYONU" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DefaultReyonCombo" Width="220" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="KATEGORİ → REYON EŞLEME" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />

            <DataGrid x:Name="MatrixGrid" Grid.Row="3" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="2*" IsReadOnly="True" />
                    <DataGridComboBoxColumn x:Name="ReyonColumn" Header="Reyon (→ yazıcı)" Width="3*"
                                            SelectedValueBinding="{Binding ReyonId}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Kapat" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                    <Button Content="💾 KAYDET" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="20,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
