<Window x:Class="MindAeonRest.Views.AmountPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tutar" Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="28,22,28,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Tutar" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock x:Name="LabelText" Text="TUTAR" Style="{StaticResource FieldLabel}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="AmountBox" Grid.Column="0" Style="{StaticResource InputTextBox}" FontSize="20" />
                    <Button Grid.Column="2" Content="⌨" Width="46" Height="40" Style="{StaticResource GhostButton}" FontSize="16" ToolTip="Sanal klavye" Click="Keyboard_Click" />
                </Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,10,0,0" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="UYGULA" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
