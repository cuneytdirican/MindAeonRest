<Window x:Class="MindAeonRest.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Not" Height="320" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_Drag">
                <TextBlock x:Name="TitleText" Text="Not" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
            </StackPanel>

            <ItemsControl x:Name="ChipHost" Grid.Row="1" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Tag="{Binding}" Click="Chip_Click" Margin="0,0,6,6" Padding="10,4" Cursor="Hand"
                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="InputBox" Grid.Row="2" Style="{StaticResource InputTextBox}" Margin="0,12,0,0"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Kaldır" Style="{StaticResource GhostButton}" Padding="16,6" Margin="0,0,8,0" Click="Clear_Click" />
                <Button Content="Vazgeç" Style="{StaticResource GhostButton}" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="✓ Kaydet" Style="{StaticResource PrimaryButton}" Padding="22,6" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
