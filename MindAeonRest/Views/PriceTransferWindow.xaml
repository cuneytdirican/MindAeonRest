<Window x:Class="MindAeonRest.Views.PriceTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şubeler Arası Fiyat Aktarımı" Height="320" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Şubeler Arası Fiyat Aktarımı" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Kaynak şubenin şube-özel fiyatları hedef şubeye kopyalanır (hedefin mevcut şube fiyatları değişir)." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="KAYNAK ŞUBE" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SourceCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                <TextBlock Text="HEDEF ŞUBE" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <ComboBox x:Name="TargetCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="OkButton" Content="AKTAR" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
