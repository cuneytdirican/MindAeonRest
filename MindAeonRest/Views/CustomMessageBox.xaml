<Window x:Class="MindAeonRest.Views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="Height" Width="440" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="26,24,26,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border x:Name="IconCircle" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource TextBrush}" FontSize="14" TextWrapping="Wrap" Margin="2,16,2,0" />

            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </Grid>
    </Border>
</Window>
