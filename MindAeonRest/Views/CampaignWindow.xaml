<Window x:Class="MindAeonRest.Views.CampaignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kampanyalar" Height="700" Width="1080"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Cursor="Hand" Click="Close_Click" />
                <StackPanel>
                    <TextBlock Text="🎁 Kampanyalar" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Şube bazlı, tarih/gün/saat aralıklı kampanyalar. Adisyon ekranında geçerli olanlar gösterilir ve uygulanabilir." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="➕ Yeni" Style="{StaticResource PrimaryButton}" Width="120" Click="Add_Click" />
                <Button Content="✏ Düzenle" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0" Click="Edit_Click" />
                <Button Content="Aktif / Pasif" Style="{StaticResource GhostButton}" Width="130" Margin="8,0,0,0" Click="Toggle_Click" />
                <Button Content="🗑 Sil" Style="{StaticResource GhostButton}" Width="100" Margin="8,0,0,0" Click="Delete_Click" />
            </StackPanel>

            <DataGrid x:Name="Grid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False"
                      Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeader}"
                      CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                      MouseDoubleClick="Edit_Click" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource DeletedAwareText}" />
                    <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Tip" Binding="{Binding TypeText}" Width="1.6*" />
                    <DataGridTextColumn Header="Değer" Binding="{Binding ValueText}" Width="*" />
                    <DataGridTextColumn Header="Geçerlilik" Binding="{Binding PeriodText}" Width="1.4*" />
                    <DataGridTextColumn Header="Kapsam" Binding="{Binding ScopeText}" Width="*" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource GhostButton}" Width="140" Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
