<Window x:Class="MindAeonRest.Views.RestaurantWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurulum Sihirbazı" Height="760" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL: ADIM RAYI -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="16,0,0,16">
                <DockPanel Margin="18,20,14,16">
                    <TextBlock DockPanel.Dock="Top" Text="🚀 Kurulum Sihirbazı" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="Hızlı restoran kurulumu" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                    <ProgressBar DockPanel.Dock="Bottom" x:Name="ProgressBarMain" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" />
                    <ItemsControl x:Name="StepRail">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RailBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RailBadge}" Width="24" Foreground="{Binding RailFg}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Title}" Foreground="{Binding RailFg}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- SAĞ: İÇERİK -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,20,20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock x:Name="StepTitle" Text="" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="StepDesc" Text="" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,14,20,0">
                    <ContentControl x:Name="StepHost" />
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,16,0" Padding="22,12" Margin="0,12,0,0">
                    <Grid>
                        <Button x:Name="BackButton" Content="◀ Geri" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="18,4" Click="Back_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SkipButton" Content="Atla ▷" Style="{StaticResource GhostButton}" Padding="18,4" Margin="0,0,10,0" Click="Skip_Click" />
                            <Button x:Name="NextButton" Content="İleri ▶" Style="{StaticResource PrimaryButton}" Padding="26,4" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
