<Window x:Class="MindAeonRest.Views.MasaRaporWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masa Raporları" Height="740" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="LiveRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Dolu"><Setter Property="Background" Value="#26EF4444" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Rezerve"><Setter Property="Background" Value="#26F59E0B" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Boş"><Setter Property="Background" Value="#1A22C55E" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="🪑 Masa Raporları" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="190" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Branch_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="LOKASYON" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ZoneCombo" Width="190" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="FromBox" Width="130" Height="36" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="ToBox" Width="130" Height="36" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="🔍 GÖSTER" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" VerticalAlignment="Bottom" Click="Show_Click" />
                </WrapPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabLive" Content="🟢 ANLIK DURUM" GroupName="tab" IsChecked="True" Checked="Tab_Changed" Style="{StaticResource TabToggle}" />
                    <RadioButton x:Name="TabHistory" Content="📊 GEÇMİŞ PERFORMANS" GroupName="tab" Checked="Tab_Changed" Style="{StaticResource TabToggle}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📊 Excel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Excel_Click" />
                    <Button Content="📄 PDF" Style="{StaticResource GhostButton}" Click="Pdf_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <DataGrid x:Name="LiveGrid" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" RowStyle="{StaticResource LiveRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lokasyon" Binding="{Binding ZoneName}" Width="130" />
                        <DataGridTextColumn Header="Masa" Binding="{Binding TableCode}" Width="90" />
                        <DataGridTextColumn Header="Kişilik" Binding="{Binding SeatsText}" Width="80" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="Açık Adisyon" Binding="{Binding OrderCode}" Width="120" />
                        <DataGridTextColumn Header="Açılış" Binding="{Binding OpenedText}" Width="100" />
                        <DataGridTextColumn Header="Süre" Binding="{Binding DurationText}" Width="90" />
                        <DataGridTextColumn Header="Kişi" Binding="{Binding CoversText}" Width="60" />
                        <DataGridTextColumn Header="Tutar" Binding="{Binding TotalText}" Width="110" />
                        <DataGridTextColumn Header="Garson" Binding="{Binding WaiterName}" Width="130" />
                        <DataGridTextColumn Header="Not" Binding="{Binding Info}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="HistoryGrid" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lokasyon" Binding="{Binding ZoneName}" Width="140" />
                        <DataGridTextColumn Header="Masa" Binding="{Binding TableCode}" Width="100" />
                        <DataGridTextColumn Header="Kişilik" Binding="{Binding Seats}" Width="80" />
                        <DataGridTextColumn Header="Adisyon (devir)" Binding="{Binding AdisyonCount}" Width="120" />
                        <DataGridTextColumn Header="Ciro" Binding="{Binding RevenueText}" Width="130" />
                        <DataGridTextColumn Header="Ort. Fiş" Binding="{Binding AvgTicketText}" Width="120" />
                        <DataGridTextColumn Header="Toplam Kişi" Binding="{Binding Covers}" Width="100" />
                        <DataGridTextColumn Header="İptal" Binding="{Binding CancelCount}" Width="70" />
                        <DataGridTextColumn Header="Koltuk Başı Ciro" Binding="{Binding RevPerSeatText}" Width="140" />
                        <DataGridTextColumn Header="Son Kullanım" Binding="{Binding LastUsedText}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,8" Margin="0,10,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="—" />
            </Border>
        </Grid>
    </Border>
</Window>
