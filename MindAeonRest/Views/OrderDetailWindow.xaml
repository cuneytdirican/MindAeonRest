<Window x:Class="MindAeonRest.Views.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sipariş Detayı" Height="700" Width="1080" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="Sipariş Detayı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <Border x:Name="LockBadge" Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="10,3" Margin="14,2,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🔒 Z KİLİTLİ — değiştirilemez" Foreground="White" FontSize="12" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel x:Name="InfoPanel" Orientation="Horizontal" />
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="SATIRLAR (silinmiş/iptal dahil — kırmızı)" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <DataGrid x:Name="LinesGrid" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kişi" Binding="{Binding SeatText}" Width="*" />
                            <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Mik." Binding="{Binding QtyText}" Width="60" />
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding LineTotalText}" Width="*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding DurumText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Text="ÖDEME FİŞLERİ" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                        <DataGrid x:Name="FichesGrid" Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Fiche_Changed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fiş" Binding="{Binding Code}" Width="*" />
                                <DataGridTextColumn Header="Tarih" Binding="{Binding FicheDate, StringFormat=dd.MM HH:mm}" Width="*" />
                                <DataGridTextColumn Header="Tutar" Binding="{Binding TotalText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="ÖDEME HAREKETLERİ (seçili fiş)" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                        <DataGrid x:Name="PaymentsGrid" Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip" Binding="{Binding KindText}" Width="*" />
                                <DataGridTextColumn Header="Tutar" Binding="{Binding AmountText}" Width="*" />
                                <DataGridTextColumn Header="Tarih" Binding="{Binding PayDate, StringFormat=dd.MM HH:mm}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Grid>

            <Button Grid.Row="3" Content="Kapat" Style="{StaticResource GhostButton}" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
