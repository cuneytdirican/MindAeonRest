<Window x:Class="MindAeonRest.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restoran Tanımları" Height="780" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="16,16,0,0" Padding="26,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🚀 Restoran Tanımları" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Restoranı ayağa kaldırmak için tüm tanımlar — iş sırasına göre, tek ekranda." FontSize="12.5" Foreground="#EAF7FF" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="✕" Width="36" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                </Grid>
            </Border>

            <!-- İLERLEME -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="26,12">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ProgressText" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <Button Content="🔄 Yenile" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="12,2" Click="Refresh_Click" />
                    </Grid>
                    <ProgressBar x:Name="ProgressBarMain" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" />
                </StackPanel>
            </Border>

            <!-- ADIMLAR -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12">
                <ItemsControl x:Name="StepsHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Margin="0,0,12,0"
                                            Background="{Binding BadgeBrush}">
                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14.5">
                                            <Run Text="{Binding No, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Icon, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,12,0" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{Binding BadgeBrush}" />
                                    <Button Grid.Column="3" Content="AÇ ▶" Style="{StaticResource PrimaryButton}" Padding="16,6" VerticalAlignment="Center" Tag="{Binding}" Click="Open_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,16,16" Padding="26,12">
                <Grid>
                    <TextBlock Text="💡 Adımı açıp tanımları yapın, geri dönünce durum otomatik güncellenir. Sıralama, sistemi kurma iş akışına göredir." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Kapat" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="22,4" Click="Cancel_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
