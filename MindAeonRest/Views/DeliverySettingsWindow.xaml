<Window x:Class="MindAeonRest.Views.DeliverySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paket / Yemek Sitesi Ayarları (Şube Bazlı)" Height="500" Width="820" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Paket / Yemek Sitesi Ayarları" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Trendyol / Getir / Yemeksepeti / Migros — her şube için ayrı tanımlanır" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Şube:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="BranchCombo" Width="220" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Id" SelectionChanged="Branch_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <DataGrid x:Name="Grid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                      Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Platform" Binding="{Binding PlatformText}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Mağaza/Store ID" Binding="{Binding StoreId}" Width="*" />
                    <DataGridTextColumn Header="API Key" Binding="{Binding ApiKey}" Width="1.5*" />
                    <DataGridTextColumn Header="Secret" Binding="{Binding SecretKey}" Width="1.5*" />
                    <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsEnabled}" Width="60" />
                    <DataGridCheckBoxColumn Header="Gelen Sipariş" Binding="{Binding IsInboundEnabled}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Kapat" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
