<Window x:Class="MindAeonRest.Views.CompanySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şirket Kurulumu" Height="660" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="34,30,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Yeni Şirket Kurulumu" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Şirket için ayrı bir veritabanı (MindAeonRest_KOD) oluşturulur."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <!-- Yönetici doğrulaması -->
                <StackPanel x:Name="AuthPanel">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Şirket kurmak için yönetici (SysAdmin) doğrulaması gereklidir."
                                       FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="YÖNETİCİ KULLANICI" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AdminUserBox" Style="{StaticResource InputTextBox}" Text="admin" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="YÖNETİCİ PAROLA" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="AdminPassBox" Style="{StaticResource InputPasswordBox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="ŞİRKET KODU" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" TextChanged="CodeBox_TextChanged" />
                <TextBlock x:Name="DbNamePreview" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ŞİRKET ADI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DÖVİZ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CurrencyCombo" Style="{StaticResource InputComboBox}"
                                  ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Id" Tag="Döviz">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Code}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="2,16,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="CreateButton" Content="ŞİRKETİ KUR"
                        Style="{StaticResource PrimaryButton}" Click="Create_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
