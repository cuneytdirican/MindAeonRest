<UserControl x:Class="MindAeonRest.Views.LocationSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MindAeonRest.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="ÜLKE" Style="{StaticResource FieldLabel}" />
            <views:EntityPicker x:Name="CountryPicker" />
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="ŞEHİR" Style="{StaticResource FieldLabel}" />
            <views:EntityPicker x:Name="CityPicker" />
        </StackPanel>
        <StackPanel Grid.Column="4">
            <TextBlock Text="İLÇE" Style="{StaticResource FieldLabel}" />
            <views:EntityPicker x:Name="DistrictPicker" />
        </StackPanel>
    </Grid>
</UserControl>
