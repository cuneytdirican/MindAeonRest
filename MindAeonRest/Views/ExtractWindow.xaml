<Window x:Class="MindAeonRest.Views.ExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hesap Ekstresi" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="📒 Hesap Ekstresi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- FİLTRELER -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="HESAP TİPİ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeCombo" Width="170" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Type_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="BranchPanel" Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="180" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Branch_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="HESAP" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AccountCombo" Width="240" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Account_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="FromBox" Width="130" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="ToBox" Width="130" Height="36" />
                    </StackPanel>
                    <Button Content="🔍 GÖSTER" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" VerticalAlignment="Bottom" Click="Show_Click" />
                </WrapPanel>
            </Border>

            <!-- ÖZET KARTLARI -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12">
                    <StackPanel><TextBlock Text="AÇILIŞ BAKİYE" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock x:Name="OpeningText" Text="0,00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1622C55E" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel><TextBlock Text="TOPLAM GİRİŞ" FontSize="12" Foreground="#22C55E" FontWeight="SemiBold" /><TextBlock x:Name="InText" Text="0,00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#16EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel><TextBlock Text="TOPLAM ÇIKIŞ" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" /><TextBlock x:Name="OutText" Text="0,00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="16,12">
                    <StackPanel><TextBlock Text="KAPANIŞ BAKİYE" FontSize="12" Foreground="#EAF7FF" FontWeight="SemiBold" /><TextBlock x:Name="ClosingText" Text="0,00" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" /></StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,8">
                <Button Content="📊 Excel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Excel_Click" />
                <Button Content="📄 PDF" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Pdf_Click" />
                <Button Content="CSV" Style="{StaticResource GhostButton}" Click="Csv_Click" />
            </StackPanel>

            <DataGrid x:Name="ExtractGrid" Grid.Row="4" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="150" />
                    <DataGridTextColumn Header="İşlem" Binding="{Binding TypeText}" Width="2*" />
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="3*" />
                    <DataGridTextColumn Header="Giriş" Binding="{Binding InText}" Width="130" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Çıkış" Binding="{Binding OutText}" Width="130" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Bakiye" Binding="{Binding RunningText}" Width="150" ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
