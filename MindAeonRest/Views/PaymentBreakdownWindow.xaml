<Window x:Class="MindAeonRest.Views.PaymentBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme Yöntemi Kırılımı" Height="680" Width="900" MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <Border CornerRadius="8" Padding="12,5" HorizontalAlignment="Left" Background="#2563EB">
                        <TextBlock Text="💳 ÖDEME YÖNTEMİ KIRILIMI" FontWeight="Bold" Foreground="White" FontSize="12" />
                    </Border>
                    <TextBlock Text="Ödeme Yöntemi Kırılımı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="FromBox" Width="140" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="ToBox" Width="140" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="200" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="🔍 GÖSTER" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" VerticalAlignment="Bottom" Click="Show_Click" />
                </WrapPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <ItemsControl x:Name="Host">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,12,12" Width="200">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AmountText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FisText" Grid.Column="0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="—" />
                    <StackPanel Grid.Column="1" Margin="0,0,28,0">
                        <TextBlock Text="GERÇEK TAHSİLAT (açık hesap hariç)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="TahsilatText" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="#17B26A" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TOPLAM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="TotalText" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
