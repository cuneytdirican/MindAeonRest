<Window x:Class="MindAeonRest.Views.ProductBarcodeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barkod" Height="320" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Barkod" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="BİRİM" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="UnitCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}"
                          SelectedValuePath="UnitId" Tag="Birim seçin">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding UnitName}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="BARKOD" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                <TextBox x:Name="BarcodeBox" Style="{StaticResource InputTextBox}" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="EKLE" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
