<Window x:Class="MindAeonRest.Views.SystemManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Yönetimi" Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Başlık şeridi (sürükle-taşı) -->
            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="16,16,0,0" Padding="24,16" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🛠 Sistem Yönetimi" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Uygulama güncelleme ve mobil sunucu yönetimi" FontSize="12" Foreground="#EAF7FF" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="✕" Width="34" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18">
                <!-- UYGULAMA GÜNCELLEME -->
                <TextBlock Text="UYGULAMA GÜNCELLEME" Style="{StaticResource FieldLabel}" Margin="2,0,0,4" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentVersionText" Text="Mevcut sürüm: …" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="UpdateStatusText" Text="Güncellemeleri kontrol etmek için butona tıklayın." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="CheckBtn" Content="↻ Güncellemeleri Kontrol Et" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButton}" Padding="14,6" Click="Check_Click" />
                        </Grid>

                        <!-- Sürüm notları + güncelle butonu (yalnız güncelleme varsa) -->
                        <Border x:Name="NotesBox" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LatestVersionText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="NotesText" Text="" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="UpdateBtn" Content="⬇ Güncelle ve Yeniden Başlat" HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}" Padding="18,7" Margin="0,12,0,0"
                                Visibility="Collapsed" IsEnabled="False" Click="Update_Click" />
                    </StackPanel>
                </Border>

                <!-- MOBİL SUNUCU -->
                <TextBlock Text="MOBİL SUNUCU" Style="{StaticResource FieldLabel}" Margin="2,18,0,4" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📱 API + Garson PWA yönetimi" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="Sunucu durumu, adres/QR, Windows hizmeti ve PWA kurulumu." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Aç" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}" Padding="22,6" Click="OpenMobileServer_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,16,16" Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Kapat" Style="{StaticResource GhostButton}" Padding="22,6" Click="Close_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
