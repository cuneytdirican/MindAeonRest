<Window x:Class="MindAeonRest.Views.ProductPriceMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Şube · Fiyat Listesi Matrisi" Height="780" Width="1240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" Cursor="Hand" Click="Close_Click" />
                <StackPanel>
                    <TextBlock Text="Şube · Fiyat Listesi Matrisi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Her ürünün şube/fiyat-listesi bazlı tüm fiyatları ayrı satırda. Fiyat/KDV'yi satır içinde düzenleyin; yeni kapsamlı satır için sağdan ürün seçip '+ Fiyat Ekle'."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- Filtreler + ekleme -->
            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="➕ Fiyat Ekle" Style="{StaticResource PrimaryButton}" Width="150" Click="AddPrice_Click" />
                <views:EntityPicker x:Name="ProductPicker" DockPanel.Dock="Right" Width="240" Margin="8,0,8,0" />
                <TextBlock DockPanel.Dock="Right" Text="Ürün:" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />

                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" Width="260" HorizontalAlignment="Left" Tag="🔍 Ürün ara…" TextChanged="Filter_Changed" />
                <TextBlock Text="Şube:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="BranchFilter" Width="170" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Liste:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="ListFilter" Width="170" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DataGrid x:Name="Grid" Grid.Row="2" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeader}"
                      CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                      RowEditEnding="Grid_RowEditEnding" HorizontalScrollBarVisibility="Auto">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,2" Padding="10,5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tip" Binding="{Binding TypeText}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Birim" Binding="{Binding UnitName}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Şube" Binding="{Binding BranchText}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Fiyat Listesi" Binding="{Binding ListText}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Fiyat" Binding="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}" Width="130" FontSize="15" />
                    <DataGridCheckBoxColumn Header="KDV Dahil" Binding="{Binding TaxIncluded}" Width="80" />
                    <DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Geçerlilik" Binding="{Binding PeriodText}" Width="*" MinWidth="150" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" Width="34" Height="30" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource DangerBrush}" Cursor="Hand" Click="Delete_Click" Tag="{Binding}" ToolTip="Bu fiyat satırını sil" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource GhostButton}" Width="140" Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
