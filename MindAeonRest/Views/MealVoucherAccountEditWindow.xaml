<Window x:Class="MindAeonRest.Views.MealVoucherAccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Yemek Çek Hesabı" Height="610" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Yeni Yemek Çek Hesabı" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Şube + yemek çeki + döviz zorunludur." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KOD" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HESAP ADI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <views:EntityPicker x:Name="BranchPicker" />
                <TextBlock Text="YEMEK ÇEKİ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <views:EntityPicker x:Name="VoucherPicker" />
                <TextBlock Text="DÖVİZ TİPİ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <ComboBox x:Name="CurrencyCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Döviz">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KAPSAM" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ScopeCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Scope_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="KioskPanel" Grid.Column="2" Visibility="Collapsed">
                        <TextBlock Text="KIOSK" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="KioskCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ActiveCheck" Content="Aktif" Style="{StaticResource ThemedCheckBox}" Margin="2,16,0,0" IsChecked="True" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
