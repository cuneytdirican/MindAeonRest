<Window x:Class="MindAeonRest.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Ekranı"
        WindowStyle="None" WindowStartupLocation="Manual" Background="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MindAeonRest;component/Themes/PosTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>

        <!-- Sol: sipariş -->
        <Border Grid.Column="0" Background="{StaticResource PosHeaderBrush}">
            <Grid Margin="36,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ürünler" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LinesHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding QtyText}" FontSize="18" FontWeight="Bold" Foreground="#FFD9EC" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="18" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding LineTotalText}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="TOPLAM" FontSize="22" FontWeight="Bold" Foreground="#FFD9EC" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalText" Text="₺0,00" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Sağ: logo / karşılama -->
        <Border Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoImg" Stretch="Uniform" MaxHeight="220" MaxWidth="420" />
                <TextBlock x:Name="WelcomeText" Text="Hoş geldiniz" FontSize="22" Foreground="#9AA0AB" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
