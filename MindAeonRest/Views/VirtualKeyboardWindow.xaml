<Window x:Class="MindAeonRest.Views.VirtualKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klavye" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        WindowStartupLocation="Manual">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
        <StackPanel>
            <Grid Margin="2,0,2,6">
                <TextBlock Text="⌨ Sanal Klavye" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                           MouseLeftButtonDown="Header_MouseLeftButtonDown" />
                <Button Content="✕" Width="30" Height="26" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Focusable="False" Click="Close_Click" />
            </Grid>
            <StackPanel x:Name="KeysHost" />
        </StackPanel>
    </Border>
</Window>
