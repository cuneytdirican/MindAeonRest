<Window x:Class="MindAeonRest.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vardiya Kapanışı" Height="720" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="🧾 Vardiya Kapanışı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Margin="0,12,0,0" Padding="12,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TERMİNAL / ŞUBE" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="ContextText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Background="{DynamicResource SurfaceBrush}">
                        <TextBlock x:Name="StatusText" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>

                    <!-- ====== AÇIK VARDİYA YOK: VARDİYA AÇ ====== -->
                    <Border x:Name="OpenPanel" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Açık vardiya yok" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="Bu terminalde açık bir vardiya bulunmuyor. Açılış kasasını girip yeni bir vardiya başlatın." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <TextBlock Text="AÇILIŞ KASASI (₺)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OpeningFloatBox" Style="{StaticResource InputTextBox}" Text="0" />
                        </StackPanel>
                    </Border>

                    <!-- ====== AÇIK VARDİYA VAR: RAPOR + KAPANIŞ ====== -->
                    <StackPanel x:Name="ClosePanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="VARDİYA ÖZETİ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="ShiftSub" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10" />

                                <Grid Margin="0,4">
                                    <TextBlock Text="TOPLAM TAHSİLAT" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalText" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="ÖDEME YÖNTEMİ DAĞILIMI" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <ItemsControl x:Name="PayHost">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,2"><TextBlock Text="{Binding KindText}" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" /></Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="TAHSİL EDEN KULLANICI" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <ItemsControl x:Name="UserHost">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,2"><TextBlock Text="{Binding UserName}" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" /></Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ====== NAKİT MUTABAKAT ====== -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="18" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="💵 NAKİT MUTABAKAT" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Açılış kasası" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="OpeningText" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Nakit tahsilat" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="CashCollectedText" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Beklenen nakit" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="ExpectedCashText" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                </Grid>

                                <TextBlock Text="SAYILAN NAKİT (₺)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                                <TextBox x:Name="CountedCashBox" Style="{StaticResource InputTextBox}" TextChanged="Counted_Changed" />

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="FARK (sayılan − beklenen)" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DiffText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                </Grid>

                                <TextBlock Text="NOT (opsiyonel)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                                <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Kapat" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button x:Name="OpenShiftButton" Grid.Column="2" Content="VARDİYA AÇ" Style="{StaticResource PrimaryButton}" Click="OpenShift_Click" Visibility="Collapsed" />
                <Button x:Name="CloseShiftButton" Grid.Column="2" Content="VARDİYA KAPAT" Style="{StaticResource PrimaryButton}" Click="CloseShift_Click" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
