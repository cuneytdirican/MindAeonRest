<Window x:Class="MindAeonRest.Views.ProductPriceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiyat" Height="700" Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderTitle" Text="Fiyat" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Satış ve (varsa) Alış fiyatını birlikte girebilirsiniz. Şube/müşteri/grup/liste boşsa GENEL fiyattır."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Alanlar kaydırılabilir: hiçbir alan kırpılmaz -->
            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BİRİM" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="UnitCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Birim">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DÖVİZ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CurrencyCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Döviz">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SATIŞ FİYATI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SalePriceBox" Style="{StaticResource InputTextBox}" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ALIŞ FİYATI (opsiyonel)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BuyPriceBox" Style="{StaticResource InputTextBox}" FontSize="17" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LİSTE FİYATI (boş=yok)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ListPriceBox" Style="{StaticResource InputTextBox}" FontSize="17" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Padding="12,10">
                            <CheckBox x:Name="TaxInclCheck" Content="Fiyata KDV Dahil" IsChecked="True"
                                      FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                    <ComboBox x:Name="BranchCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Şube">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BAŞLANGIÇ (gg.aa.yyyy SS:dd)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StartBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BİTİŞ (boş=süresiz)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EndBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MÜŞTERİ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CustomerCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Genel">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MÜŞTERİ GRUBU" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GroupCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Genel">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FİYAT LİSTESİ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PriceListCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Genel">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="ActiveCheck" Content="Aktif" Style="{StaticResource ThemedCheckBox}" VerticalAlignment="Bottom" Margin="0,0,0,12" IsChecked="True" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Sabit alt bölge: hata + butonlar her zaman görünür, asla kırpılmaz -->
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="SemiBold"
                           Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                    <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
