<Window x:Class="MindAeonRest.Views.KioskDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIOSK Kasa Paneli" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰 KIOSK KASA PANELİ" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <Border Background="#22C55E" CornerRadius="9" Padding="9,2" Margin="14,4,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="CANLI" Foreground="White" FontWeight="Bold" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="🔄" Width="38" Height="34" Style="{StaticResource GhostButton}" ToolTip="Yenile" Click="Refresh_Click" />
                    <Button Content="✕" Width="38" Height="34" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                </StackPanel>
            </Grid>

            <!-- FİLTRELER -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="190" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="KIOSK NO" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="KioskCombo" Width="130" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ZAMAN KAPSAMI" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ScopeCombo" Width="180" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Scope_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="FromBox" Width="130" Height="36" SelectedDateChanged="Filter_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="ToBox" Width="130" Height="36" SelectedDateChanged="Filter_Changed" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <TextBlock x:Name="ScopeInfoText" Grid.Row="2" Margin="2,12,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />

            <!-- PARA KARTLARI -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border x:Name="CardNakit" Grid.Row="0" Grid.Column="0" CornerRadius="14" Padding="20,18" Background="#1622C55E" BorderBrush="#22C55E" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="💵  NAKİT" FontWeight="Bold" Foreground="#22C55E" FontSize="14" />
                        <TextBlock x:Name="NakitText" Text="0,00 ₺" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" CornerRadius="14" Padding="20,18" Background="#163B82F6" BorderBrush="#3B82F6" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="💳  KREDİ KARTI" FontWeight="Bold" Foreground="#3B82F6" FontSize="14" />
                        <TextBlock x:Name="KartText" Text="0,00 ₺" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" CornerRadius="14" Padding="20,18" Background="#16F59E0B" BorderBrush="#F59E0B" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="🎫  YEMEK ÇEKİ" FontWeight="Bold" Foreground="#F59E0B" FontSize="14" />
                        <TextBlock x:Name="CekText" Text="0,00 ₺" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="6" CornerRadius="14" Padding="20,18" Background="#16EF4444" BorderBrush="#EF4444" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="📋  AÇIK HESAP" FontWeight="Bold" Foreground="#EF4444" FontSize="14" />
                        <TextBlock x:Name="AcikText" Text="0,00 ₺" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- TOPLAM TAHSİLAT -->
                <Border x:Name="TotalCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" CornerRadius="16" Padding="28,22" Margin="0,16,0,0" Background="{DynamicResource AccentBrush}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOPLAM TAHSİLAT (Nakit + Kart + Çek)" Foreground="#EAF7FF" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="TahsilatText" Text="0,00 ₺" FontSize="44" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="FisCountText" Text="0 fiş" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock x:Name="GenelToplamText" Text="" Foreground="#EAF7FF" FontSize="13" HorizontalAlignment="Right" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ALT BİLGİ -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,8" Margin="0,12,0,0">
                <Grid>
                    <TextBlock x:Name="LastRefreshText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Text="—" />
                    <TextBlock Text="⏱ Ekran açık kaldıkça 1 dakikada bir otomatik yenilenir." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
