<Window x:Class="MindAeonRest.Views.UserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı Seç" Height="680" Width="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Kullanıcı Seç" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <ItemsControl x:Name="UserList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Username}" Click="User_Click" Cursor="Hand" Margin="0,0,0,10"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentGradient}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold" Foreground="#1A1208"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding RoleName}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Bu şube için yetkili kullanıcı bulunamadı."
                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <Button Grid.Row="2" Content="Kapat" Style="{StaticResource GhostButton}" Margin="0,16,0,0" Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
