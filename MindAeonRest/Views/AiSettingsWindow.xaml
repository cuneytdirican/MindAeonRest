<Window x:Class="MindAeonRest.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Ayarları" Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="⚙ AI Ayarları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="32" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="Sağlayıcı" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="ProviderCombo" Height="40" SelectionChanged="Provider_Changed" DisplayMemberPath="Text" SelectedValuePath="Value" />

                <StackPanel x:Name="PresetPanel" Margin="0,12,0,0">
                    <TextBlock Text="Hazır sağlayıcı (seçince otomatik 'Özel' moda geçer; anahtarı girip Kaydet)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="PresetCombo" Height="40" SelectionChanged="Preset_Changed" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel x:Name="UrlPanel" Margin="0,12,0,0">
                    <TextBlock Text="Uç nokta (BaseUrl — tam chat/completions adresi)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource InputTextBox}" Height="40" />
                </StackPanel>

                <StackPanel x:Name="KeyPanel" Margin="0,12,0,0">
                    <TextBlock Text="API Anahtarı (gizli)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="KeyBox" Height="40" FontSize="16" Padding="8,6" />
                    <TextBlock Text="Model (boş = sağlayıcı varsayılanı)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4" />
                    <TextBox x:Name="ModelBox" Style="{StaticResource InputTextBox}" Height="40" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Yaratıcılık (düşük = tutarlı/kesin)" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="TempText" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" />
                </Grid>
                <Slider x:Name="TempSlider" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="Temp_Changed" />

                <CheckBox x:Name="VoiceOutCheck" Content="Cevabı sesli oku (TTS)" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,0" />
                <CheckBox x:Name="VoiceInCheck" Content="Mikrofonla sesli soru (STT — çevrimdışı; sistemde dikte motoru, tercihen Türkçe, yüklüyse)" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" />

                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Text="Gizlilik: Bulut sağlayıcı seçilirse yalnız sorunuz ve araç adları gönderilir; finansal verileriniz cihazda işlenir. AI salt-okumadır, veri değiştirmez. Anahtar yoksa otomatik 'Yerel' moda düşer." />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="İptal" Style="{StaticResource GhostButton}" Width="100" Height="42" Click="Cancel_Click" />
                <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Width="120" Height="42" Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
