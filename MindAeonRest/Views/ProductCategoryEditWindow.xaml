<Window x:Class="MindAeonRest.Views.ProductCategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategori" Height="580" Width="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Yeni Kategori" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Kategori resmi kiosk ekranlarında gösterilir." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KOD" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="KATEGORİ ADI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <CheckBox Grid.Column="4" x:Name="ActiveCheck" Content="Aktif" Style="{StaticResource ThemedCheckBox}" VerticalAlignment="Bottom" Margin="0,0,0,12" IsChecked="True" />
                </Grid>

                <TextBlock Text="RESİM" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="NoImageText" Text="Resim yok" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="Resim Seç" Style="{StaticResource GhostButton}" Click="Pick_Click" />
                            <Button Content="Kaldır" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="Remove_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
