<Window x:Class="MindAeonRest.Views.BranchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Şube" Height="760" Width="780" MinHeight="620" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="34,28,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Yeni Şube" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ŞUBE KODU" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" CharacterCasing="Upper" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ŞUBE ADI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VERGİ NUMARASI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TaxNumberBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="VERGİ DAİRESİ" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <TextBox x:Name="TaxOfficeBox" Style="{StaticResource InputTextBox}" />

                    <TextBlock Text="LOKASYON" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <views:LocationSelector x:Name="Location" />

                    <TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBox}" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="14,10" />

                    <TextBlock Text="GÜN BAŞLANGIÇ SAATİ (HH:mm)" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DayStartHourBox" Grid.Column="0" Style="{StaticResource InputComboBox}" />
                        <ComboBox x:Name="DayStartMinuteBox" Grid.Column="2" Style="{StaticResource InputComboBox}" />
                    </Grid>
                    <TextBlock Text="Gece yarısını geçen/24 saat işletmeler için iş günü kesimi (örn. 06:00). 00:00 = takvim günü."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />

                    <CheckBox x:Name="ActiveCheck" Content="Şube aktif" Style="{StaticResource ThemedCheckBox}" Margin="2,18,0,0" IsChecked="True" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
