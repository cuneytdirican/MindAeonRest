<Window x:Class="MindAeonRest.Views.RefundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İade" Height="470" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Satır İadesi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SubText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="İADE MİKTARI" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="QtyBox" Style="{StaticResource InputTextBox}" FontSize="20" />
                <TextBlock Text="İADE TÜRÜ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <ComboBox x:Name="KindCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="ÖDEME İADESİ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <ComboBox x:Name="MethodCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Method_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="InstrLabel" Text="ARAÇ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <ComboBox x:Name="InstrumentCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="İADE ET" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
