<Window x:Class="MindAeonRest.Views.ProductBulkPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MindAeonRest.Helpers"
        Title="Toplu Fiyat" Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <helpers:CategoryColorConverter x:Key="CatColor" />
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="30,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Toplu Fiyat Düzenleme" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Tüm ürünlerin GENEL satış fiyatını tek ekranda düzenleyin. Fiyat kutusuna yazıp 'Tümünü Kaydet'e basın (boş bıraktıklarınız değişmez)."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Arama -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource InputTextBox}" Margin="0,14,0,0"
                     Tag="🔍 Ürün ara (kod / ad)…" TextChanged="Search_Changed" />

            <DataGrid x:Name="Grid" Grid.Row="2" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeader}"
                      CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" CornerRadius="6,0,0,6" Background="{Binding Name, Converter={StaticResource CatColor}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="12,6,8,6"
                                                   Foreground="{Binding Name, Converter={StaticResource CatColor}}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat='({0} ürün)'}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Ürün" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Birim" Binding="{Binding UnitName}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="15" />
                    <DataGridCheckBoxColumn Header="KDV Dahil" Binding="{Binding TaxIncluded}" Width="90" />
                    <DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="70" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3">
                <TextBlock x:Name="InfoText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="2,12,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Kapat" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Width="140" Click="Cancel_Click" />
                    <Button Grid.Column="2" Content="TÜMÜNÜ KAYDET" Style="{StaticResource PrimaryButton}" Width="220" Click="SaveAll_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
