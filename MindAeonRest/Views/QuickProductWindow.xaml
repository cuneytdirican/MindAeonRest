<Window x:Class="MindAeonRest.Views.QuickProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        xmlns:helpers="clr-namespace:MindAeonRest.Helpers"
        Title="Hızlı Ürün Tanımlama" Height="780" Width="1180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <helpers:CategoryColorConverter x:Key="CatColor" />
        <helpers:ByteImageConverter x:Key="Img" />
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" Cursor="Hand" Click="Close_Click" />
                <StackPanel>
                    <TextBlock Text="Hızlı Ürün Tanımlama" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Tek ekranda hızlıca ürün ekle; aşağıdaki listede fiyatları satır içinde düzenle. Kategori/Birim/KDV yanındaki 🔍 ile seç, + ile yeni ekle."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- Hızlı giriş formu (Enter ile yerleşim sırasına göre ilerler; Barkod'da Enter → Kaydet) -->
            <Border Grid.Row="1" x:Name="EntryForm" PreviewKeyDown="Form_PreviewKeyDown"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="KOD" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" TabIndex="1" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="ÜRÜN ADI *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" TabIndex="2" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="KATEGORİ" Style="{StaticResource FieldLabel}" />
                        <views:EntityPicker x:Name="CatPicker" TabIndex="3" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="6">
                        <TextBlock Text="BİRİM" Style="{StaticResource FieldLabel}" />
                        <views:EntityPicker x:Name="UnitPicker" TabIndex="4" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                        <TextBlock Text="KDV GRUBU" Style="{StaticResource FieldLabel}" />
                        <views:EntityPicker x:Name="TaxPicker" TabIndex="5" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                        <TextBlock Text="SATIŞ FİYATI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SaleBox" Style="{StaticResource InputTextBox}" TabIndex="6" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
                        <TextBlock Text="ALIŞ FİYATI (ops.)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="BuyBox" Style="{StaticResource InputTextBox}" TabIndex="7" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BARKOD (ops.)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BarcodeBox" Style="{StaticResource InputTextBox}" TabIndex="8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox x:Name="TaxInclCheck" Content="KDV Dahil" IsChecked="True" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <TextBlock Text="RESİM (ops.)" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                    <Image x:Name="ImagePreview" Stretch="UniformToFill" />
                                </Border>
                                <Button x:Name="ImageButton" Content="📷 Seç" Style="{StaticResource GhostButton}" Padding="10,6" TabIndex="22" Click="PickImage_Click" />
                                <Button x:Name="ImageClearButton" Content="✕" Style="{StaticResource GhostButton}" Padding="9,6" Margin="6,0,0,0" Click="ClearImage_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="➕  EKLE ve KAYDET" Style="{StaticResource PrimaryButton}" Width="220" TabIndex="9" Click="Add_Click" />
                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" Width="300" HorizontalAlignment="Left" TabIndex="20" Tag="🔍 Listede ara (kod/ad)…" TextChanged="Search_Changed" />
                <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="CatFilter" Width="220" HorizontalAlignment="Left" TabIndex="21" Style="{StaticResource InputComboBox}"
                          ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!-- Liste: satır içi fiyat düzenleme -->
            <DataGrid x:Name="Grid" Grid.Row="3" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridHeader}"
                      CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                      RowEditEnding="Grid_RowEditEnding" HorizontalScrollBarVisibility="Auto">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" CornerRadius="6,0,0,6" Background="{Binding Name, Converter={StaticResource CatColor}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Margin="10,5,8,5" Foreground="{Binding Name, Converter={StaticResource CatColor}}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="52" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" Margin="2">
                                    <Image Source="{Binding Image, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Ürün" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Birim" Binding="{Binding UnitName}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding SaleInput, UpdateSourceTrigger=PropertyChanged}" Width="130" FontSize="15" />
                    <DataGridTextColumn Header="Alış Fiyatı" Binding="{Binding BuyInput, UpdateSourceTrigger=PropertyChanged}" Width="130" FontSize="15" />
                    <DataGridCheckBoxColumn Header="KDV Dahil" Binding="{Binding TaxIncluded}" Width="80" />
                    <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="140" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource GhostButton}" Width="140" Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
