<Window x:Class="MindAeonRest.Views.CampaignApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kampanyalar" Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="🎁 Geçerli Kampanyalar" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Şu an bu şubede geçerli kampanyalar. 'Uygula' seçilen kampanyayı adisyona indirim olarak işler." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" x:Name="AppliedPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tümünü Kaldır" Style="{StaticResource GhostButton}" Width="130" Click="Remove_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UYGULANAN KAMPANYA(LAR)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="AppliedText" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Uygula" Style="{StaticResource PrimaryButton}" Width="110" Click="Apply_Click" Tag="{Binding}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ValueText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource GhostButton}" Width="130" Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
