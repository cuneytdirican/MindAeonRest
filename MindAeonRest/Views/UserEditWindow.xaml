<Window x:Class="MindAeonRest.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı" Height="800" Width="780" MinHeight="640" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="34,28,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Yeni Kullanıcı" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AD SOYAD" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ROLLER (birden fazla seçilebilir)" Style="{StaticResource FieldLabel}" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ItemsControl x:Name="RoleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource ThemedCheckBox}" Margin="0,3" Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="Mutfak ve SysAdmin tek başına atanır. Garson+Kasiyer birlikte olabilir."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox x:Name="ActiveCheck" Content="Kullanıcı aktif" Style="{StaticResource ThemedCheckBox}" IsChecked="True" Margin="2,0,0,12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PasswordLabel" Text="PAROLA / PIN" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" />
                    <TextBlock x:Name="PasswordHint" Text="KIOSK için basit numerik PIN verilebilir (ör. 1234)."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,5,0,0" />

                    <TextBlock Text="ŞUBE ERİŞİMİ" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                    <CheckBox x:Name="AllBranchesCheck" Content="Tüm şubelere erişebilir" Style="{StaticResource ThemedCheckBox}"
                              Checked="AllBranches_Toggled" Unchecked="AllBranches_Toggled" />
                    <Border x:Name="BranchListBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0" Padding="14,8">
                        <ItemsControl x:Name="BranchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource ThemedCheckBox}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
