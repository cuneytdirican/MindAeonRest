<Window x:Class="MindAeonRest.Views.BankaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banka Yönetimi" Height="660" Width="1000" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Banka Yönetimi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="BranchText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="＋ Tahsilat" Style="{StaticResource GhostButton}" Width="120" Click="Collect_Click" />
                <Button Content="－ Ödeme" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0" Click="Pay_Click" />
                <Button Content="＋ Para Girişi" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0" Click="In_Click" />
                <Button Content="－ Para Çıkışı" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0" Click="Out_Click" />
                <Button Content="➡ Transfer" Style="{StaticResource GhostButton}" Width="110" Margin="8,0,0,0" Click="Transfer_Click" />
                <Button Content="🔄 Yenile" Style="{StaticResource GhostButton}" Width="100" Margin="8,0,0,0" Click="Refresh_Click" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="BANKA HESAPLARI (BAKİYE)" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <DataGrid x:Name="BalancesGrid" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              SelectionChanged="Balance_Changed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hesap" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Banka" Binding="{Binding BankName}" Width="*" />
                            <DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="70" />
                            <DataGridTextColumn Header="Bakiye" Binding="{Binding BalanceText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" x:Name="MovTitle" Text="HAREKETLER" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <DataGrid x:Name="MovementsGrid" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="*" />
                            <DataGridTextColumn Header="Tip" Binding="{Binding TypeText}" Width="*" />
                            <DataGridTextColumn Header="Cari" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding AmountText}" Width="100" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
