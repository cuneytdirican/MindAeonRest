<Window x:Class="MindAeonRest.Views.EInvoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="e-Fatura Ayarları" Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="e-Fatura / e-Arşiv Ayarları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Eklenti modül · EDM veya Uyumsoft entegrasyonu" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="SAĞLAYICI" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ProviderCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                <TextBox x:Name="UserBox" Style="{StaticResource InputTextBox}" />
                <TextBlock Text="PAROLA" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <TextBox x:Name="PassBox" Style="{StaticResource InputTextBox}" />
                <CheckBox x:Name="TestCheck" Content="Test ortamı" Style="{StaticResource ThemedCheckBox}" Margin="2,16,0,0" IsChecked="True" />
                <CheckBox x:Name="EnabledCheck" Content="Modül etkin (faturalar gönderilebilir)" Style="{StaticResource ThemedCheckBox}" Margin="2,10,0,0" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
