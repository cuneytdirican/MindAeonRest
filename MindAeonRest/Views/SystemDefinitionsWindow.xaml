<Window x:Class="MindAeonRest.Views.SystemDefinitionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Sistem Tanımları" Height="700" Width="1040"
        WindowStartupLocation="CenterOwner" MinHeight="560" MinWidth="860"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" Margin="28,22,20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Sistem Tanımları" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Tüm şirketlerce ortak kullanılan tanımlar." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL MENÜ (genişleyebilir) -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,16,14,16">
                            <TextBlock Text="TANIMLAR" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,8" />
                            <RadioButton x:Name="MenuCountries" Content="Ülkeler" GroupName="Def" Style="{StaticResource NavItem}" Checked="Menu_Checked" />
                            <RadioButton x:Name="MenuCities" Content="Şehirler" GroupName="Def" Style="{StaticResource NavItem}" Checked="Menu_Checked" />
                            <RadioButton x:Name="MenuDistricts" Content="İlçeler" GroupName="Def" Style="{StaticResource NavItem}" Checked="Menu_Checked" />
                            <RadioButton x:Name="MenuUnits" Content="Ana Birimler" GroupName="Def" Style="{StaticResource NavItem}" Checked="Menu_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- SAĞ İÇERİK -->
                <Grid Grid.Column="1" Margin="24,4,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Üst: başlık + filtre + Yeni -->
                    <Grid Grid.Row="0" Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContentTitle" Grid.Column="0" Text="" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <StackPanel x:Name="FilterPanel" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="Ülke:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <views:EntityPicker x:Name="CountryFilter" Width="220" />
                            <TextBlock x:Name="CityFilterLabel" Text="Şehir:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0" Visibility="Collapsed" />
                            <views:EntityPicker x:Name="CityFilter" Width="220" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="DeleteToggleButton" Content="🗑 Sil / Geri Al" Style="{StaticResource GhostButton}"
                                    Width="140" Margin="0,0,10,0" Click="DeleteToggle_Click" Visibility="Collapsed" />
                            <Button x:Name="AddButton" Content="+ Yeni" Style="{StaticResource PrimaryButton}"
                                    Width="130" Click="Add_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Margin="2">
                            <TextBlock x:Name="HintText" Text="Soldaki menüden bir tanım seçin."
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <DataGrid x:Name="CountriesGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" />
                                    <DataGridTextColumn Header="Ülke Adı" Binding="{Binding Name}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="CitiesGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Plaka" Binding="{Binding PlateCode}" Width="*" />
                                    <DataGridTextColumn Header="Şehir Adı" Binding="{Binding Name}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="DistrictsGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="İlçe Adı" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="UnitsGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" />
                                    <DataGridTextColumn Header="Birim Adı" Binding="{Binding Name}" Width="3*" />
                                    <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2" Content="Kapat" Style="{StaticResource GhostButton}" Margin="0,16,0,0" Width="160" HorizontalAlignment="Right" Click="Cancel_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
