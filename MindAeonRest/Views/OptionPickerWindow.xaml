<Window x:Class="MindAeonRest.Views.OptionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seçenekler" SizeToContent="Height" Width="500" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource PosCardBrush}" BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" />
                <TextBlock Text="Seçenekleri belirleyip Ekle'ye basın." FontSize="12" Foreground="{DynamicResource PosMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" MaxHeight="480">
                <StackPanel x:Name="GroupsHost" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Toplam: " FontSize="15" Foreground="{DynamicResource PosMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosAccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Vazgeç" Style="{StaticResource PosLineToolBtnBig}" Width="110" Click="Cancel_Click" />
                    <Button Content="Ekle" Style="{StaticResource PosGreenButton}" Width="140" Margin="10,0,0,0" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
