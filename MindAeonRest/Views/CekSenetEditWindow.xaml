<Window x:Class="MindAeonRest.Views.CekSenetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Çek / Senet" Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Yeni Çek / Senet" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="TÜR" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="KindCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="YÖN" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="DirCombo" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" /></StackPanel>
                </Grid>
                <TextBlock Text="CARİ" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <views:EntityPicker x:Name="CustomerPicker" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="SERİ / NO" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SerialBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="BANKA (çek)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BankBox" Style="{StaticResource InputTextBox}" /></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="TUTAR" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AmountBox" Style="{StaticResource InputTextBox}" Text="0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="DÜZENLEME" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="IssueBox" Height="38" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="VADE" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="DueBox" Height="38" /></StackPanel>
                </Grid>
                <TextBlock Text="AÇIKLAMA" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
