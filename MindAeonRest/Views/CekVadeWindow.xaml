<Window x:Class="MindAeonRest.Views.CekVadeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çek / Senet Vade Takibi" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="📆 Çek / Senet Vade Takibi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="TİP" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="KindCombo" Width="120" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="YÖN" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DirCombo" Width="140" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="VADE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DueCombo" Width="180" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="DURUM" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StatusCombo" Width="150" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="🔄 Yenile" Style="{StaticResource GhostButton}" Height="38" Padding="14,0" VerticalAlignment="Bottom" Click="Refresh_Click" />
                </WrapPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
                <Button Content="🏦 Bankaya Ver / Tahsil Et" Style="{StaticResource PrimaryButton}" Padding="14,0" Height="38" Click="ToBank_Click" />
                <Button Content="📤 Tahsile Ver" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="38" Click="ToCollection_Click" />
                <Button Content="🔁 Ciro Et" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="38" Click="Endorse_Click" />
                <Button Content="⚠ Karşılıksız" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="38" Click="Bounce_Click" />
                <Button Content="📊 Excel" Style="{StaticResource GhostButton}" Margin="20,0,0,0" Height="38" Click="Excel_Click" />
            </StackPanel>

            <DataGrid x:Name="VadeGrid" Grid.Row="3" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False"
                      RowStyle="{StaticResource VadeRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tip" Binding="{Binding KindText}" Width="70" />
                    <DataGridTextColumn Header="Yön" Binding="{Binding DirectionText}" Width="80" />
                    <DataGridTextColumn Header="Cari" Binding="{Binding CustomerName}" Width="2*" />
                    <DataGridTextColumn Header="Seri No" Binding="{Binding Serial}" Width="120" />
                    <DataGridTextColumn Header="Banka" Binding="{Binding BankName}" Width="130" />
                    <DataGridTextColumn Header="Tutar" Binding="{Binding AmountText}" Width="110" />
                    <DataGridTextColumn Header="Vade" Binding="{Binding DueText}" Width="100" />
                    <DataGridTextColumn Header="Kalan" Binding="{Binding DaysToDueText}" Width="110" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,8" Margin="0,10,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="—" />
            </Border>
        </Grid>
    </Border>
</Window>
