<Window x:Class="MindAeonRest.Views.WaiterTerminalV2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MindAeonRest.Views"
        xmlns:h="clr-namespace:MindAeonRest.Helpers"
        Title="Garson Terminali" WindowState="Maximized"
        WindowStyle="None" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:StringToBrushConverter x:Key="Brush" />
        <h:ByteImageConverter x:Key="Img" />

        <!-- ===== FLAT BUTON (tema uyumlu) — varsayılan WPF buton şablonu yerine; tüm butonlara uygulanır.
             Her butonun kendi Background/Foreground/Padding'ini korur; hover/pressed temaya göre opaklıkla. ===== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== MASA KARTI ===== -->
        <DataTemplate x:Key="TableCardTpl">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="6" Padding="0" Cursor="Hand"
                    BorderBrush="{Binding BorderCol, Converter={StaticResource Brush}}" BorderThickness="1.5">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCmd}" />
                </Border.InputBindings>
                <StackPanel>
                    <Border CornerRadius="12,12,0,0" Height="5" Background="{Binding StatusColor, Converter={StaticResource Brush}}" />
                    <StackPanel Margin="14,12,14,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding ZoneText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" />
                                <TextBlock Text="{Binding TableName}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="22" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="7,2"
                                    Background="{Binding StatusBg, Converter={StaticResource Brush}}">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CoverText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,12,0"
                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                                       Visibility="{Binding HasElapsed, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- hızlı rozet (geciken) — diğer bekleyen işler zamanlı listede -->
                        <WrapPanel Margin="0,6,0,0">
                            <Border Background="#33EF4444" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                                    Visibility="{Binding IsLate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⏰ GECİKEN" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </WrapPanel>

                        <!-- SİPARİŞ özeti -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SİPARİŞ" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" />
                            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- BEKLEYEN İŞLER (zamanlı liste) -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="BEKLEYEN İŞLER" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Color, Converter={StaticResource Brush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- masa notu / alerji -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NoteText}" Foreground="{Binding NoteColor, Converter={StaticResource Brush}}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- INLINE EXPAND: tüm satırlar + son sipariş saati (Tümünü Gör ile açılır) -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                                Visibility="{Binding ExpandVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ADİSYON DETAYI" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding QtyText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Border Grid.Column="2" CornerRadius="5" Padding="6,1" Margin="6,0" VerticalAlignment="Center" Background="{Binding StatusBg, Converter={StaticResource Brush}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="9.5" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding LineTotalText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LastOrderText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                           Visibility="{Binding HasLastOrder, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- tutar + 3 aksiyon: Tümünü Gör (inline) · Ürün Ekle (adisyon) · Hesap Al (ödeme) -->
                        <Grid Margin="0,10,0,0">
                            <Button Content="{Binding ExpandLabel}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" Cursor="Hand"
                                    Command="{Binding ExpandCmd}" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" FontWeight="SemiBold" FontSize="12"
                                    Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AmountText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                           Visibility="{Binding HasAmount, Converter={StaticResource BoolToVis}}" />
                                <Button Content="➕ Ürün Ekle" Margin="10,0,0,0" Padding="10,5" Cursor="Hand" Command="{Binding OpenCmd}"
                                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5"
                                        Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}" />
                                <Button Content="💳 Hesap Al" Margin="8,0,0,0" Padding="10,5" Cursor="Hand" Command="{Binding PayCmd}"
                                        Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5"
                                        Visibility="{Binding CanPay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== ÜRÜN KARTI (menü) ===== -->
        <DataTemplate x:Key="ProductCardTpl">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="6" Width="190"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Height="96">
                        <Border CornerRadius="12,12,0,0" Background="{DynamicResource SurfaceAltBrush}" />
                        <TextBlock Text="🍽" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                        <Image Source="{Binding Image, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                        <Border CornerRadius="0,12,0,0" Background="#CCEF4444" Padding="8,2" Height="22"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsSalesStopped, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DURDU" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   MaxHeight="32" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding PriceText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button Content="+ Ekle" HorizontalAlignment="Right" Padding="12,5" Cursor="Hand" Tag="{Binding}" Click="Product_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== TESLİM / MEŞRUBAT KARTI (gruplu) ===== -->
        <DataTemplate x:Key="DeliverCardTpl">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="6" Width="300"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Margin="14,12,14,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding TableTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20" />
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                <Run Text="{Binding ZoneText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding WaiterName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="7,2" Background="{DynamicResource SuccessBrush}">
                            <TextBlock Text="HAZIR" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,6,0,0">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                                Visibility="{Binding IsVip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⭐ VIP" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <Border Background="#33EF4444" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                                Visibility="{Binding HasAllergy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold">
                                <Run Text="⚠ ALERJİ: " /><Run Text="{Binding AllergyNote, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>

                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding QtyText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SeatText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding KitchenNote}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="✓ Teslim Et" Margin="0,12,0,0" Padding="0,10" Cursor="Hand" Tag="{Binding}" Click="Deliver_Click"
                            Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="15" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== SERVİS İSTEĞİ KARTI ===== -->
        <DataTemplate x:Key="ServiceCardTpl">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="6" Width="300"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Margin="14,12,14,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontSize="26" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="15" />
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                <Run Text="{Binding TableText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding NoteText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <Button Content="✓ Tamamlandı İşaretle" Margin="0,12,0,0" Padding="0,10" Cursor="Hand" Tag="{Binding}" Click="ServiceComplete_Click"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== CANLI ADİSYON SATIRI (Varsayılan kırılımlarıyla) ===== -->
        <DataTemplate x:Key="LiveLineTpl">
            <Border x:Name="row" Padding="8,5" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="qty" Grid.Row="0" Grid.Column="0" Text="{Binding QtyText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="pname" Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ltot" Grid.Row="0" Grid.Column="2" Text="{Binding LineTotalText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Border CornerRadius="5" Padding="6,1" Margin="0,2,6,0" Background="{Binding StatusBg, Converter={StaticResource Brush}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding KitchenNote}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  • İKRAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding IsTreat, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- yeni eklenen satır kısa highlight -->
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <!-- Menü alt-kırılımı (bileşen): girintili + "↳" + soluk; fiyat gizli -->
                <DataTrigger Binding="{Binding IsComponent}" Value="True">
                    <Setter TargetName="row" Property="Margin" Value="22,0,0,0" />
                    <Setter TargetName="qty" Property="Text" Value="↳" />
                    <Setter TargetName="qty" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="pname" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="pname" Property="FontSize" Value="12" />
                    <Setter TargetName="ltot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== KAMPANYA KARTI (belirgin + dönen/parlayan efekt — Varsayılan birebir) ===== -->
        <DataTemplate x:Key="LiveCampaignTpl">
            <Grid Width="236" Margin="0,2,8,4">
                <!-- dönen kırmızı/sarı ışık halkası (uygun/uygulanmış kampanyada) -->
                <Border x:Name="glow" CornerRadius="13" BorderThickness="3" Visibility="Collapsed">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="rot" CenterX="0.5" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FFFF2D2D" Offset="0" />
                            <GradientStop Color="#00FF2D2D" Offset="0.4" />
                            <GradientStop Color="#FFFFC400" Offset="0.5" />
                            <GradientStop Color="#00FF2D2D" Offset="0.6" />
                            <GradientStop Color="#FFFF2D2D" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect><DropShadowEffect Color="#FF2D2D" BlurRadius="16" ShadowDepth="0" Opacity="0.6" /></Border.Effect>
                </Border>
                <Border CornerRadius="11" Background="{DynamicResource SurfaceAltBrush}" Margin="3" Padding="11,9">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ShortText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="32" Margin="0,2,0,0" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold" Margin="0,5,0,0" />
                        <Button x:Name="applyBtn" Content="✓ UYGULA" Margin="0,7,0,0" Height="34" Cursor="Hand" Click="ApplyCampaign_Click" Tag="{Binding}"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEligible}" Value="False">
                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="applyBtn" Property="IsEnabled" Value="False" />
                    <Setter TargetName="applyBtn" Property="Content" Value="kriter sağlanmadı" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEligible}" Value="True">
                    <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="status" Property="Foreground" Value="#34D399" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="sb">
                            <Storyboard><DoubleAnimation Storyboard.TargetName="rot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever" /></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="sb" /></DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                    <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="applyBtn" Property="IsEnabled" Value="False" />
                    <Setter TargetName="applyBtn" Property="Content" Value="✓ UYGULANDI" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <Grid Margin="22,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="38" Height="38">
                        <TextBlock Text="🧑‍🍳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompanyText" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="16" />
                        <TextBlock x:Name="BranchText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="ClockText" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="UserText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RoleText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="🎨" Click="Theme_Click" Margin="4,0,0,0" Padding="10,7" Cursor="Hand" ToolTip="Tema değiştir"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                    <Button Content="Çıkış" Click="Close_Click" Margin="8,0,0,0" Padding="14,7" Cursor="Hand"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== GARSON ÇAĞRISI BANNER (belirgin + yanıp sönen kırmızı; bekleyen CagriGarson varken görünür) ===== -->
        <Border x:Name="CallBanner" Grid.Row="1" Visibility="Collapsed" Margin="22,12,22,0" Cursor="Hand"
                Background="#EF4444" CornerRadius="10" Padding="18,12"
                MouseLeftButtonUp="CallBanner_Click" ToolTip="🔔 Yeni Servis sekmesine git">
            <Border.Effect><DropShadowEffect Color="#FFEF4444" BlurRadius="20" ShadowDepth="0" Opacity="0.75" /></Border.Effect>
            <Border.Triggers>
                <!-- kampanya glow desenine benzer sürekli blink (Opacity) -->
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔔" FontSize="22" VerticalAlignment="Center" />
                <TextBlock x:Name="CallBannerText" Foreground="White" FontWeight="Bold" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="  ›  Yeni Servis" Foreground="#FFEAEA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== ÜST SEKMELER ===== -->
        <ItemsControl x:Name="TabHost" Grid.Row="2" Margin="22,12,22,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Tag="{Binding}" Click="Tab_Click" Margin="0,0,10,8" Padding="18,9" Cursor="Hand"
                            Background="{Binding Bg}" Foreground="{Binding Fg}" BorderThickness="0" FontWeight="SemiBold" FontSize="14" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== İÇERİK ===== -->
        <Grid Grid.Row="3" Margin="16,12,16,16">

            <!-- 1) MASALAR -->
            <DockPanel x:Name="TablesView">
                <ItemsControl x:Name="TableFilterHost" DockPanel.Dock="Top" Margin="6,0,6,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding}" Click="TableFilter_Click" Margin="0,0,8,8" Padding="12,6" Cursor="Hand"
                                    Background="{Binding Bg}" Foreground="{Binding Fg}" BorderThickness="0" FontWeight="SemiBold" FontSize="12.5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TableHost" ItemTemplate="{StaticResource TableCardTpl}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 2) MENÜ / ADİSYON PANELİ (SPLIT: sol canlı adisyon · orta menü+kampanyalar) -->
            <Grid x:Name="MenuView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- başlık şeridi -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="6,0,6,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← Masalar" Click="BackToTables_Click" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelTableText" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="18" />
                                <TextBlock x:Name="SelZoneText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="−" Click="CoverMinus_Click" Width="34" Height="34" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="Bold" FontSize="16" />
                            <TextBlock x:Name="CoverText" Text="1 kişi" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14" Margin="10,0" VerticalAlignment="Center" />
                            <Button Content="+" Click="CoverPlus_Click" Width="34" Height="34" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="Bold" FontSize="16" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="VipBtn" Content="⭐ VIP" Click="Vip_Click" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <Button x:Name="PriorityBtn" Content="⏫ Öncelik" Click="Priority_Click" Margin="6,0,0,0" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <Button x:Name="AllergyBtn" Content="⚠ Alerji" Click="Allergy_Click" Margin="6,0,0,0" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <Button x:Name="NoteBtn" Content="📝 Masa Notu" Click="TableNote_Click" Margin="6,0,0,0" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <Button x:Name="TableOpsBtn" Content="⇄ Masa İşlemleri" Click="TableOps_Click" Margin="6,0,0,0" Padding="12,7" Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- gövde: SOL canlı adisyon · ORTA menü -->
                <Grid Grid.Row="1" Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- SOL: kalıcı canlı adisyon -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ADİSYON" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="14,12,0,4" />

                            <!-- Satırlar (kişiye göre gruplu) -->
                            <ListBox x:Name="LinesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="6,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemTemplate="{StaticResource LiveLineTpl}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,4" Margin="2,8,2,4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="2,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Satır araçları (Varsayılan handler mantığı) -->
                            <UniformGrid Grid.Row="2" Columns="5" Margin="8,6">
                                <Button Content="İkram" Click="Treat_Click" Margin="2" Height="40" Cursor="Hand" FontSize="12"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                <Button Content="İskonto" Click="Discount_Click" Margin="2" Height="40" Cursor="Hand" FontSize="12"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                <Button Content="📝 Açıklama" Click="Note_Click" Margin="2" Height="40" Cursor="Hand" FontSize="12"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                <Button Content="İptal" Click="CancelLine_Click" Margin="2" Height="40" Cursor="Hand" FontSize="12"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                <Button Content="↻ Yazdır" Click="Reprint_Click" Margin="2" Height="40" Cursor="Hand" FontSize="12"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                            </UniformGrid>

                            <!-- Alt: toplam + gönder + öde -->
                            <StackPanel Grid.Row="3" Margin="12,4,12,14">
                                <Grid Margin="0,4,0,8">
                                    <TextBlock Text="TOPLAM" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalText" Text="₺0,00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Button Content="🍳  MUTFAĞA GÖNDER" Click="Send_Click" Height="46" Cursor="Hand" FontWeight="Bold" FontSize="14"
                                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🧾 Hesap" Click="Receipt_Click" Height="50" Cursor="Hand" FontSize="13"
                                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                    <Button Grid.Column="2" x:Name="PayBtn" Content="💳 ÖDEME AL" Click="Pay_Click" Height="50" Cursor="Hand" FontWeight="Bold" FontSize="15"
                                            Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ORTA: ürün menüsü + altında kampanya bandı -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                     Tag="Ürün adı / kod ara…" />
                            <ItemsControl x:Name="CategoryHost" Margin="0,8,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Tag="{Binding}" Click="Category_Click" Margin="0,0,8,6" Padding="12,5" Cursor="Hand"
                                                Background="{Binding Bg}" Foreground="{Binding Fg}" BorderThickness="0" FontWeight="SemiBold" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl x:Name="ProductHost" ItemTemplate="{StaticResource ProductCardTpl}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- EN ALTTA HER ZAMAN: kampanyalar (belirgin + dönen ışık efekti) -->
                        <Border x:Name="CampaignSection" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="0,10,0,0" Padding="10,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="🎁 KAMPANYALAR" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CampaignHint" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="CampaignHost" ItemTemplate="{StaticResource LiveCampaignTpl}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 3/4) TESLİM / MEŞRUBAT -->
            <ScrollViewer x:Name="DeliverView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DeliverHost" ItemTemplate="{StaticResource DeliverCardTpl}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 5) YENİ SERVİS -->
            <ScrollViewer x:Name="ServiceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ServiceHost" ItemTemplate="{StaticResource ServiceCardTpl}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- EMPTY hint -->
            <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <!-- ===== MASA NOTU OVERLAY ===== -->
            <Grid x:Name="NoteOverlay" Background="#99000000" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Width="540" MaxHeight="640"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📝 Masa Notu" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20" />

                            <TextBlock Text="Hızlı not" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,14,0,4" />
                            <ItemsControl x:Name="NoteChipHost">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Tag="{Binding}" Click="NoteChip_Click" Margin="0,0,8,8" Padding="12,6" Cursor="Hand"
                                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontSize="12.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Genel Not" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,4" />
                            <TextBox x:Name="NoteBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8"
                                     Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <TextBlock Text="Alerji" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,10,0,4" />
                            <ItemsControl x:Name="AllergyChipHost" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Tag="{Binding}" Click="AllergyChip_Click" Margin="0,0,8,8" Padding="12,6" Cursor="Hand"
                                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontSize="12.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="AllergyBox" Height="44" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8"
                                     Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="VipSwitch" Content="⭐ VIP" Click="VipSwitch_Click" Padding="16,8" Cursor="Hand"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                                <Button x:Name="PrioritySwitch" Content="⏫ Öncelik" Click="PrioritySwitch_Click" Margin="10,0,0,0" Padding="16,8" Cursor="Hand"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Vazgeç" Click="NoteCancel_Click" Padding="18,8" Cursor="Hand"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                <Button Content="Kaydet" Click="NoteSave_Click" Margin="10,0,0,0" Padding="24,8" Cursor="Hand"
                                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== MASA İŞLEMLERİ MENÜSÜ OVERLAY ===== -->
            <Grid x:Name="TableOpsOverlay" Background="#99000000" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Width="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⇄ Masa İşlemleri" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20" />
                        <TextBlock x:Name="TableOpsSubText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,4,0,0" />

                        <Button Content="➡  Taşı (boş masaya)" Click="OpMove_Click" Margin="0,16,0,0" Height="52" Cursor="Hand" FontSize="14" FontWeight="SemiBold"
                                HorizontalContentAlignment="Left" Padding="16,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                        <Button Content="✂  Böl (kalem/kişi → boş masa)" Click="OpSplit_Click" Margin="0,8,0,0" Height="52" Cursor="Hand" FontSize="14" FontWeight="SemiBold"
                                HorizontalContentAlignment="Left" Padding="16,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                        <Button Content="🔗  Birleştir (dolu masaya)" Click="OpMerge_Click" Margin="0,8,0,0" Height="52" Cursor="Hand" FontSize="14" FontWeight="SemiBold"
                                HorizontalContentAlignment="Left" Padding="16,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                        <Button Content="👤  Kişi Aktar (kalem/kişi → dolu masa)" Click="OpMoveLines_Click" Margin="0,8,0,0" Height="52" Cursor="Hand" FontSize="14" FontWeight="SemiBold"
                                HorizontalContentAlignment="Left" Padding="16,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />

                        <Button Content="Kapat" Click="TableOpsClose_Click" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="22,9" Cursor="Hand"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== KALEM / KİŞİ SEÇİM OVERLAY (Böl & Kişi Aktar) ===== -->
            <Grid x:Name="LinePickOverlay" Background="#99000000" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Width="560" MaxHeight="680"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LinePickTitle" Grid.Row="0" Text="Kalem Seç" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="20" />

                        <!-- koltuk hızlı seçim çipleri -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="Koltuğa göre seç" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <ItemsControl x:Name="SeatChipHost">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Tag="{Binding}" Click="SeatChip_Click" Margin="0,0,8,8" Padding="12,6" Cursor="Hand"
                                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Margin="0,8,0,0" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LinePickHost">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="6,3">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center"
                                                          Foreground="{DynamicResource TextBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding QtyText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding SeatText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Vazgeç" Click="LinePickCancel_Click" Padding="18,9" Cursor="Hand"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontWeight="SemiBold" />
                            <Button Content="Devam ›" Click="LinePickConfirm_Click" Margin="10,0,0,0" Padding="24,9" Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
