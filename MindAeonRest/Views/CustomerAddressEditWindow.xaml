<Window x:Class="MindAeonRest.Views.CustomerAddressEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Müşteri Adresi" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Müşteri Adresi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BAŞLIK" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TELEFON" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="LOKASYON" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                <views:LocationSelector x:Name="Location" />

                <TextBlock Text="ADRES" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBox}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="14,10" />

                <CheckBox x:Name="DefaultCheck" Content="Varsayılan adres" Style="{StaticResource ThemedCheckBox}" Margin="2,16,0,0" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="KAYDET" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
