<Window x:Class="MindAeonRest.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapor" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Rapor" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="SubText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click" />
            </Grid>

            <!-- Filtre çubuğu -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                <WrapPanel x:Name="FilterPanel" Orientation="Horizontal">
                    <StackPanel x:Name="DateFromPanel" Margin="0,0,14,6">
                        <TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateFrom" Width="150" Height="36" />
                    </StackPanel>
                    <StackPanel x:Name="DateToPanel" Margin="0,0,14,6">
                        <TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateTo" Width="150" Height="36" />
                    </StackPanel>
                    <StackPanel x:Name="CustomerPanel" Margin="0,0,14,6">
                        <TextBlock Text="CARİ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CustomerCombo" Width="220" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                    </StackPanel>
                    <StackPanel x:Name="BranchPanel" Margin="0,0,14,6">
                        <TextBlock Text="ŞUBE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BranchCombo" Width="180" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                    </StackPanel>
                    <StackPanel x:Name="WarehousePanel" Margin="0,0,14,6">
                        <TextBlock Text="DEPO" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="WarehouseCombo" Width="180" Style="{StaticResource InputComboBox}" SelectedValuePath="Value" DisplayMemberPath="Text" />
                    </StackPanel>
                    <StackPanel x:Name="SearchPanel" Margin="0,0,14,6">
                        <TextBlock Text="ARA" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" Width="200" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <Button Content="Göster" Style="{StaticResource PrimaryButton}" Width="100" Height="36" VerticalAlignment="Bottom" Margin="4,0,0,6" Click="Show_Click" />
                </WrapPanel>
            </Border>

            <!-- Tablo -->
            <DataGrid x:Name="Grid" Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" />

            <!-- Alt toplam -->
            <Border Grid.Row="3" x:Name="FooterBar" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
                <WrapPanel x:Name="FooterPanel" Orientation="Horizontal" />
            </Border>

            <!-- Alt butonlar -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock x:Name="CountText" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📄 CSV" Style="{StaticResource GhostButton}" Width="100" Margin="0,0,8,0" Click="Csv_Click" />
                    <Button Content="📊 Excel" Style="{StaticResource GhostButton}" Width="110" Margin="0,0,8,0" Click="Excel_Click" />
                    <Button Content="🖨 PDF / Yazdır" Style="{StaticResource GhostButton}" Width="150" Margin="0,0,8,0" Click="Pdf_Click" />
                    <Button Content="Kapat" Style="{StaticResource PrimaryButton}" Width="100" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
