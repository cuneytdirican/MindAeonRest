<Window x:Class="MindAeonRest.Views.GiftCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        Title="Hediye Çekleri" Height="700" Width="1140" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,16,22,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <Border CornerRadius="8" Padding="12,5" HorizontalAlignment="Left" Background="#8B5CF6">
                        <TextBlock Text="🎁 HEDİYE ÇEKİ YÖNETİMİ" FontWeight="Bold" Foreground="White" FontSize="12" />
                    </Border>
                    <TextBlock Text="Hediye Çekleri" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,46,0">
                    <TextBlock Text="DOLAŞIMDAKİ TOPLAM YÜKÜMLÜLÜK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="LiabilityText" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>

                <!-- SOL: liste + seçili çekin hareketleri -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="1.1*" /></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="ÇEKLER" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowInactive" Content="Pasifleri de göster" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" IsChecked="True" Click="Refresh_Click" />
                        <Button Content="🗙 Seçili Çeki İptal Et" Style="{StaticResource GhostButton}" Margin="16,0,0,0" Padding="12,4" Click="CancelCard_Click" />
                    </StackPanel>

                    <DataGrid x:Name="Grid" Grid.Row="1" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" />
                            <DataGridTextColumn Header="İlk Tutar" Binding="{Binding InitialText}" Width="*" />
                            <DataGridTextColumn Header="Bakiye" Binding="{Binding BalanceText}" Width="*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="1.4*" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="SEÇİLİ ÇEK HAREKETLERİ (EKSTRE)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,12,0,6" />
                    <DataGrid x:Name="MovGrid" Grid.Row="3" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding MoveDate, StringFormat=dd.MM.yyyy HH:mm}" Width="*" />
                            <DataGridTextColumn Header="Tip" Binding="{Binding TypeText}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding AmountText}" Width="*" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- SAĞ: Yeni Hediye Çeki Sat -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Yeni Hediye Çeki Sat" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Çek bedeli ayrıca tahsil edilmelidir (kasa/POS). Bu ekran yalnız çeki oluşturur ve bakiye yükler." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />

                        <TextBlock Text="TUTAR (₺) *" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <TextBox x:Name="AmountBox" Style="{StaticResource InputTextBox}" FontSize="18" />

                        <!-- SATIŞ ÖDEMESİ (çek bedeli kasaya/POS'a yazılır) -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="SATIŞ ÖDEMESİ *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Çek bedeli bu yöntemle tahsil edilir (kasaya/POS'a yazılır)." FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                                <TextBlock Text="YÖNTEM" Style="{StaticResource FieldLabel}" Margin="2,10,0,6" />
                                <ComboBox x:Name="MethodCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}"
                                          SelectedValuePath="Value" SelectionChanged="Method_Changed">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock x:Name="CashLabel" Text="KASA" Style="{StaticResource FieldLabel}" Margin="2,10,0,6" />
                                <ComboBox x:Name="CashCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock x:Name="PosLabel" Text="POS CİHAZI" Style="{StaticResource FieldLabel}" Margin="2,10,0,6" Visibility="Collapsed" />
                                <ComboBox x:Name="PosCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Visibility="Collapsed">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MÜŞTERİ (opsiyonel)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <views:EntityPicker x:Name="CustomerPicker" />

                        <TextBlock Text="KOD (opsiyonel — boşsa otomatik üretilir)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputTextBox}" />

                        <TextBlock Text="SON KULLANMA (opsiyonel)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <DatePicker x:Name="ExpiresBox" Height="46" />

                        <TextBlock Text="AÇIKLAMA (opsiyonel)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBox}" />

                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <Button x:Name="IssueButton" Content="🎁  HEDİYE ÇEKİ OLUŞTUR" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Issue_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
