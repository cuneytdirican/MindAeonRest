<UserControl x:Class="MindAeonRest.Views.BossDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MindAeonRest.Views">
    <UserControl.Resources>
        <local:StringToBrushConverter x:Key="Brush" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <!-- Tutar bazlı sıralı satır (ürün/masa/garson…) -->
        <DataTemplate x:Key="RankAmount">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarWidth}" Height="14" BorderThickness="0"
                             Foreground="{Binding Color, Converter={StaticResource Brush}}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </DataTemplate>
        <!-- Adet bazlı sıralı satır (iptal) -->
        <DataTemplate x:Key="RankCount">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarWidth}" Height="14" BorderThickness="0"
                             Foreground="{Binding Color, Converter={StaticResource Brush}}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </DataTemplate>
        <!-- Zaman trendi satırı -->
        <DataTemplate x:Key="TrendRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarWidth}" Height="14" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- FİLTRELER -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Tarih:" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker x:Name="FromDate" Width="140" Height="38" Margin="0,0,6,0" />
                <DatePicker x:Name="ToDate" Width="140" Height="38" Margin="0,0,10,0" />
                <Button Content="Bugün" Style="{StaticResource GhostButton}" Width="80" Height="38" Margin="0,0,6,0" Click="Today_Click" />
                <Button Content="7 Gün" Style="{StaticResource GhostButton}" Width="80" Height="38" Margin="0,0,6,0" Click="Week_Click" />
                <Button Content="30 Gün" Style="{StaticResource GhostButton}" Width="80" Height="38" Margin="0,0,14,0" Click="Month_Click" />
                <TextBlock Text="Şube:" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="BranchCombo" Width="200" Height="38" Margin="0,0,12,0" SelectedValuePath="Value" DisplayMemberPath="Text" SelectionChanged="Branch_Changed" />
                <Button Content="Göster" Style="{StaticResource PrimaryButton}" Width="120" Height="38" Margin="0,0,14,0" Click="Show_Click" />
                <TextBlock Text="🔄 Oto-yenile:" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="AutoRefreshCombo" Width="130" Height="38" SelectedValuePath="Value" DisplayMemberPath="Text" SelectionChanged="AutoRefresh_Changed" />
                <TextBlock x:Name="AutoRefreshInfo" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- KPI KARTLARI -->
                <WrapPanel>
                    <Border Style="{StaticResource Card}" Width="190"><StackPanel><TextBlock Text="💰 CİRO" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="RevenueText" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="150"><StackPanel><TextBlock Text="🧾 Fiş Adedi" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="FisText" Style="{StaticResource KpiValue}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="170"><StackPanel><TextBlock Text="📊 Ort. Fiş" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="AvgText" Style="{StaticResource KpiValue}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="170"><StackPanel><TextBlock Text="🏷 İskonto" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="DiscText" Style="{StaticResource KpiValue}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="170"><StackPanel><TextBlock Text="↩ İade" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="RefundText" Style="{StaticResource KpiValue}" Foreground="#F44336" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="130"><StackPanel><TextBlock Text="✖ İptal" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="CancelText" Style="{StaticResource KpiValue}" Foreground="#F44336" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="150"><StackPanel><TextBlock Text="🍽 Açık Masa" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="OpenText" Style="{StaticResource KpiValue}" Foreground="#17B26A" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="150"><StackPanel><TextBlock Text="Nakit" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="NakitText" Style="{StaticResource KpiValue}" FontSize="18" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="150"><StackPanel><TextBlock Text="Kart" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="KartText" Style="{StaticResource KpiValue}" FontSize="18" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="150"><StackPanel><TextBlock Text="Diğer" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="DigerText" Style="{StaticResource KpiValue}" FontSize="18" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="190"><StackPanel><TextBlock Text="🎁 Hediye Çeki Yükümlülüğü" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="GiftLiabText" Style="{StaticResource KpiValue}" FontSize="18" Foreground="#8B5CF6" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="190"><StackPanel><TextBlock Text="⭐ Puan Yükümlülüğü" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="LoyaltyLiabText" Style="{StaticResource KpiValue}" FontSize="18" Foreground="#F59E0B" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="200"><StackPanel><TextBlock Text="📈 Katkı Marjı (Menü)" Style="{StaticResource KpiLabel}" /><TextBlock x:Name="MenuMarginText" Style="{StaticResource KpiValue}" FontSize="18" Foreground="#2E7D32" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="230"><StackPanel><TextBlock Text="🍽 Menü Sınıfı (Yıldız/İnek/Bilmece/Köpek)" Style="{StaticResource KpiLabel}" TextWrapping="Wrap" /><TextBlock x:Name="MenuClassText" Style="{StaticResource KpiValue}" FontSize="18" /></StackPanel></Border>
                </WrapPanel>

                <!-- ŞUBE KIRILIMI -->
                <Border x:Name="BranchCard" Style="{StaticResource Card}" Margin="0,2,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🏢 Şube Kırılımı" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="BranchHost">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,10" Width="220">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" />
                                            <Grid Margin="0,8,0,0"><TextBlock Text="Ciro" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding RevenueText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                            <Grid Margin="0,3,0,0"><TextBlock Text="Fiş" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding FisCount}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" /></Grid>
                                            <Grid Margin="0,3,0,0"><TextBlock Text="Ort. Fiş" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding AvgText}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" /></Grid>
                                            <Grid Margin="0,3,0,0"><TextBlock Text="Açık Masa" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding OpenTables}" Foreground="#17B26A" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- TREND: SAATLİK + GÜNLÜK -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="⏰ Saatlik Yoğunluk (ciro)" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="HourHost" ItemTemplate="{StaticResource TrendRow}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="📈 Günlük Ciro Trendi" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="DailyHost" ItemTemplate="{StaticResource TrendRow}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TOP LİSTELER -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="🍔 En Çok Satan Ürünler" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="TopProductsHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="🪑 En Çok Ciro Yapan Masalar" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="TopTablesHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="📍 En Çok Ciro Yapan Lokasyonlar" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="TopZonesHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="👤 Garson Performansı" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="WaitersHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="💳 Kasiyer Performansı" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="CashiersHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="↩ En Çok İade Edilen" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="RefundedHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="✖ En Çok İptal Edilen" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="CancelledHost" ItemTemplate="{StaticResource RankCount}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="🎁 Kampanya Satışları (ciro · adisyon)" Style="{StaticResource SectionTitle}" /><ItemsControl x:Name="CampaignSalesHost" ItemTemplate="{StaticResource RankAmount}" /></StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🎁 Şu An Geçerli (Aktif) Kampanyalar" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="ActiveCampaignsHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding ScopeText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PeriodText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoCampaignText" Text="Şu an geçerli kampanya yok." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
