<Window x:Class="MindAeonRest.Views.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV İçe Aktarım" Height="780" Width="1040" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="CsvRow" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="CSV İçe Aktarım (Stok + Fiyat)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="CSV ile toplu stok kartı ve fiyat tanımlayın. Başlık satırı zorunludur, ayraç ; veya , olabilir." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <!-- Format yardımı -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="KOLON FORMATI" Style="{StaticResource FieldLabel}" />
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Kod*; Ad*; Aciklama; BirimKodu; SatisVergiKodu; AlisVergiKodu; IadeVergiKodu; Takip(YOK/PARTI/PARTILOT/SERI/RENKBEDEN); KategoriKodlari(| ile çoklu); Fiyat; DovizKodu; SubeKodu; Barkod   (*zorunlu)" />
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Boş bırakılan birim/vergi/döviz alanları için aşağıdaki varsayılanlar kullanılır. Kodlar sistemde tanımlı olmalıdır (yoksa + ile önce tanımlayın)." />
                </StackPanel>
            </Border>

            <!-- Dosya + varsayılanlar -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📂 Dosya Seç" Style="{StaticResource PrimaryButton}" Width="150" Click="PickFile_Click" />
                    <Button Content="⬇ Örnek CSV İndir" Style="{StaticResource GhostButton}" Width="160" Margin="10,0,0,0" Click="DownloadSample_Click" />
                </StackPanel>
                <TextBlock x:Name="FileText" Grid.Column="1" Text="Dosya seçilmedi" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="VARSAYILAN ATAMALAR (boş alanlar için)" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BİRİM" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="UnitCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SATIŞ VERGİ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SalesTaxCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="DÖVİZ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CurrencyCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="FİYAT KAPSAMI" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ScopeCombo" Style="{StaticResource InputComboBox}" ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="UpdateExistingCheck" Content="Var olan kodları güncelle (üzerine yaz)" Style="{StaticResource ThemedCheckBox}" IsChecked="True" />
                        <Button Content="🔍 Doğrula" Style="{StaticResource GhostButton}" Width="120" Margin="24,0,0,0" Click="Validate_Click" />
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="20,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Önizleme -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,12,0,0">
                <DataGrid x:Name="PreviewGrid" Style="{StaticResource DataGridStyle}" RowStyle="{StaticResource CsvRow}"
                          ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowNo}" Width="50" />
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" />
                        <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Birim" Binding="{Binding UnitName}" Width="*" />
                        <DataGridTextColumn Header="Fiyat" Binding="{Binding PriceDisplay}" Width="*" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Button Content="Kapat" Style="{StaticResource GhostButton}" Width="120" HorizontalAlignment="Left" Click="Cancel_Click" />
                <Button x:Name="ImportButton" Content="İÇE AKTAR" Style="{StaticResource PrimaryButton}" Width="200" HorizontalAlignment="Right" IsEnabled="False" Click="Import_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
