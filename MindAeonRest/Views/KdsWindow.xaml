<Window x:Class="MindAeonRest.Views.KdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindAeonRest - Mutfak (KDS)"
        WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="#1B1D26">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MindAeonRest;component/Themes/PosTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2VKds" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosHeaderBrush}" Height="58">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MUTFAK" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock x:Name="ReyonTitle" FontSize="14" Foreground="#F0D9EA" VerticalAlignment="Center" Margin="16,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock x:Name="BranchText" Foreground="#F0D9EA" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Content="🔄" FontSize="16" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand" Click="Refresh_Click" />
                    <Button Content="✕" FontSize="14" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand" Click="Back_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PosSidebarBrush}">
                <DockPanel Margin="0,16,0,16">
                    <TextBlock DockPanel.Dock="Top" Text="REYONLAR" Foreground="#E7C9DD" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,16,10" />
                    <ListBox x:Name="ReyonList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PosSalonTab}" SelectionChanged="Reyon_Changed">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                <ItemsControl x:Name="TicketHost">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320" Background="#2A2D3A" CornerRadius="12" Margin="8" Padding="0"
                                    BorderThickness="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <!-- ALERJİ varsa en güçlü vurgu -->
                                            <DataTrigger Binding="{Binding HasAllergy}" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <!-- VIP -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasAllergy}" Value="False" />
                                                    <Condition Binding="{Binding IsVip}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </MultiDataTrigger>
                                            <!-- ÖNCELİK -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasAllergy}" Value="False" />
                                                    <Condition Binding="{Binding IsVip}" Value="False" />
                                                    <Condition Binding="{Binding Priority}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- başlık -->
                                    <Border Background="#343847" CornerRadius="12,12,0,0" Padding="14,10">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TableCodes}" Foreground="White" FontWeight="Bold" FontSize="16" />
                                                    <TextBlock Foreground="#AEB4C2" FontSize="11">
                                                        <Run Text="{Binding OrderCode, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding WaiterName, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ElapsedText}" Foreground="#FFD27A" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            </Grid>
                                            <!-- Rozetler: ALERJİ / VIP / ÖNCELİK / ACI -->
                                            <WrapPanel Margin="0,8,0,0">
                                                <!-- ALERJİ -->
                                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,6,4"
                                                        Visibility="{Binding HasAllergy, Converter={StaticResource B2VKds}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠ ALERJİ" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AllergyNote}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- VIP -->
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,6,4"
                                                        Visibility="{Binding IsVip, Converter={StaticResource B2VKds}}">
                                                    <TextBlock Text="★ VIP" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <!-- ÖNCELİK -->
                                                <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,6,4"
                                                        Visibility="{Binding Priority, Converter={StaticResource B2VKds}}">
                                                    <TextBlock Text="⏫ ÖNCELİK" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <!-- ACI -->
                                                <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,6,4"
                                                        Visibility="{Binding HasSpicy, Converter={StaticResource B2VKds}}">
                                                    <TextBlock Text="🌶 ACI" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- satırlar -->
                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="8,8,8,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22242F" CornerRadius="8" Margin="0,0,0,8" Padding="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding StatusColor}" CornerRadius="8,0,0,8" />
                                                        <StackPanel Grid.Column="1" Margin="10,8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding QtyText}" Foreground="#FF7BAC" FontWeight="Bold" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                                <TextBlock Text="🌶" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsSpicy, Converter={StaticResource B2VKds}}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding SeatText}" Foreground="#8A90A0" FontSize="11" VerticalAlignment="Center" />
                                                                <!-- Satır durumu (renk StatusColor'dan; Hazırlanıyor dahil) -->
                                                                <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding StatusColor}" />
                                                                    </Border.Background>
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding KitchenNote}" Foreground="#FFD27A" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource B2VKds}}" />
                                                            <ItemsControl ItemsSource="{Binding Children}" Margin="8,2,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="└ " Foreground="#8A90A0" FontSize="12" />
                                                                            <TextBlock Text="{Binding ProductName}" Foreground="#C9CEDA" FontSize="12" />
                                                                            <TextBlock Text="{Binding KitchenNote}" Foreground="#FFD27A" FontSize="12" Margin="6,0,0,0"
                                                                                       Visibility="{Binding HasNote, Converter={StaticResource B2VKds}}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="↻ Yeniden basıldı" Foreground="#FF7BAC" FontSize="10" FontWeight="Bold"
                                                                       Visibility="{Binding RePrinted, Converter={StaticResource B2VKds}}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="6,0,8,0" Width="84" Height="46"
                                                                Cursor="Hand" BorderThickness="0" Click="Ready_Click" Tag="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#17B26A" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="Content" Value="HAZIR" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                            <Setter Property="Background" Value="#3A3F4E" />
                                                                            <Setter Property="Content" Value="✓ Geri Al" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Fiş geneli iş akışı: Başlat (→ Hazırlanıyor) / Hazır (→ Hazır) -->
                                    <Grid Margin="8,0,8,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="40" Cursor="Hand" BorderThickness="0"
                                                Foreground="White" FontWeight="Bold" Content="▶ BAŞLAT"
                                                Background="{DynamicResource AccentBrush}"
                                                Click="StartTicket_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="2" Height="40" Cursor="Hand" BorderThickness="0"
                                                Foreground="White" FontWeight="Bold" Content="✓ HAZIR"
                                                Background="{DynamicResource SuccessBrush}"
                                                Click="ReadyTicket_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <!-- Mutfak fişi alt satırı: yazılım markası -->
                                    <TextBlock Text="MindAeonRest by Mobilteg" Foreground="#6A7080" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Column="1" Text="Bu reyonda bekleyen sipariş yok."
                       Foreground="#6C7180" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
