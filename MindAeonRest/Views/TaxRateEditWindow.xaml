<Window x:Class="MindAeonRest.Views.TaxRateEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KDV Oranı" Height="430" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="KDV Oranı" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TİP" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeCombo" Style="{StaticResource InputComboBox}"
                                  ItemContainerStyle="{StaticResource InputComboBoxItem}" SelectedValuePath="Value" Tag="Tip">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ORAN (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RateBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BAŞLANGIÇ (gg.aa.yyyy)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StartBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BİTİŞ (boş=süresiz)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EndBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="EKLE" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
