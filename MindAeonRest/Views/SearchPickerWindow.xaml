<Window x:Class="MindAeonRest.Views.SearchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ara ve Seç" Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Ara ve Seç" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <Button Content="✕" Width="32" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource InputTextBox}" Height="44"
                         VerticalContentAlignment="Center" FontSize="15" TextChanged="Search_Changed" />
                <Button Grid.Column="2" Content="⌨" Width="48" Height="44" Style="{StaticResource GhostButton}" FontSize="18" ToolTip="Sanal klavye" Click="Keyboard_Click" />
            </Grid>

            <ListBox x:Name="ResultList" Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Ok_Click" FontSize="15">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Vazgeç" Style="{StaticResource GhostButton}" Width="100" Height="42" Click="Cancel_Click" />
                    <Button Content="Seç" Style="{StaticResource PrimaryButton}" Width="120" Height="42" Margin="10,0,0,0" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
