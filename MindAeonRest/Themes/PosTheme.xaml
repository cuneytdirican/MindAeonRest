<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MENULUX görünümü: magenta->mor ray, açık içerik, pembe vurgu -->
    <LinearGradientBrush x:Key="PosSidebarBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#D81B60" Offset="0" />
        <GradientStop Color="#6A1B9A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C2185B" Offset="0" />
        <GradientStop Color="#4A148C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PosBgBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="PosCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PosAccentBrush" Color="#E91E63" />
    <SolidColorBrush x:Key="PosGreenBrush" Color="#17B26A" />
    <SolidColorBrush x:Key="PosTextBrush" Color="#2B2B3A" />
    <SolidColorBrush x:Key="PosMutedBrush" Color="#9AA0AB" />
    <SolidColorBrush x:Key="PosBorderBrush" Color="#E6E8EE" />
    <SolidColorBrush x:Key="PosRailTextBrush" Color="#F4E9F2" />
    <!-- ikincil zemin (keypad/satır/ödeme yöntemi) -->
    <SolidColorBrush x:Key="PosSubtleBrush" Color="#F2F3F6" />

    <!-- Sağ salon sekmesi -->
    <Style x:Key="PosSalonTab" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PosRailTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10,0,0,10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sol araç çubuğu butonu (ikon + küçük etiket) -->
    <Style x:Key="PosToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PosRailTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#3DFFFFFF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Yeşil ana aksiyon (ÖDEME AL / Göster) -->
    <Style x:Key="PosGreenButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PosGreenBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14A05E" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#B9C2CC" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Açık gri ikincil buton (satır/işlem) -->
    <Style x:Key="PosLineToolBtn" TargetType="Button">
        <Setter Property="Background" Value="#F2F3F6" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E3E6EC" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ödeme yöntemi butonu (seçilebilir) -->
    <Style x:Key="PosLineToolBtnBig" TargetType="Button">
        <Setter Property="Background" Value="#F2F3F6" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="54" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E3E6EC" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pembe ikincil aksiyon -->
    <Style x:Key="PosAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C2185B" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- POS arama/barkod kutusu: açık zemin, koyu yazı, Tag ile placeholder -->
    <Style x:Key="PosSearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PosTextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource PosMutedBrush}"
                                       Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PosAccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
