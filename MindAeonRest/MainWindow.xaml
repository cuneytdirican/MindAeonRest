<Window x:Class="MindAeonRest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MindAeonRest"
        xmlns:views="clr-namespace:MindAeonRest.Views"
        xmlns:helpers="clr-namespace:MindAeonRest.Helpers"
        mc:Ignorable="d"
        Title="MindAeonRest" Height="900" Width="1440" MinHeight="700" MinWidth="1100"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <helpers:CategoryColorConverter x:Key="CatColor" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ SOL MENÜ ============ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,0,18">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="M" FontSize="22" FontWeight="Bold" Foreground="#1A1208"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                        <Run Text="MindAeon" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="REST" FontSize="18" FontWeight="Light" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                </StackPanel>

                <!-- Aktif şirket / şube -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Margin="14,0,14,4" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="AKTİF ŞİRKET / ŞUBE" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="CompanyContextText" Text="-" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Gruplu menü (genişlemeye uygun) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel x:Name="NavRoot" Margin="14,0,14,0">
                        <TextBox x:Name="NavSearchBox" Style="{StaticResource InputTextBox}" Height="40" Margin="0,0,0,8"
                                 Tag="🔍 Menüde ara…" VerticalContentAlignment="Center" TextChanged="NavSearch_Changed" KeyDown="NavSearch_KeyDown" />
                        <Popup x:Name="NavSearchPopup" PlacementTarget="{Binding ElementName=NavSearchBox}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=NavSearchBox}" StaysOpen="False" AllowsTransparency="True" MaxHeight="420">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <ListBox x:Name="NavSearchList" Background="Transparent" BorderThickness="0" MaxHeight="400"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="NavSearch_Pick" KeyDown="NavSearchList_KeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                        <!-- ============ RESTORAN İŞLEMLERİ (günlük operasyon — en üstte) ============ -->
                        <TextBlock Text="🍽 RESTORAN İŞLEMLERİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,6" />
                        <Button x:Name="PosButton" Content="🍽  POS / ADİSYON" Click="Pos_Click"
                                Style="{StaticResource PrimaryButton}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                        <Button x:Name="KdsButton" Content="🍳  MUTFAK (KDS)" Click="Kds_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="KioskButton" Content="🖥  KIOSK" Click="Kiosk_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="PaketButton" Content="📦  PAKET / TAKE AWAY" Click="Paket_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="KasaButton" Content="💰  KASA" Click="Kasa_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="IadeButton" Content="↩  İADE" Click="Iade_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="RaporButton" Content="📊  X / Z RAPORU" Click="Rapor_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="ShiftCloseButton" Content="🧾  VARDİYA KAPANIŞI" Click="ShiftClose_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,6" />
                        <Button x:Name="OrderHistoryButton" Content="📜  SİPARİŞ İZLEME" Click="OrderHistory_Click"
                                Style="{StaticResource GhostButton}" FontSize="14" Margin="0,0,0,10" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,2,4,8" Opacity="0.5" />
                        <!-- ============ KURULUM & ÖZET ============ -->
                        <TextBlock Text="⚙ KURULUM &amp; ÖZET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,6" />
                        <RadioButton x:Name="NavDashboard" Tag="📊" Content="Özet (Dashboard)" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavDashboard_Checked" />
                        <Button x:Name="RestaurantWizardButton" Content="🚀  KURULUM SİHİRBAZI" Click="RestaurantWizard_Click"
                                Style="{StaticResource GhostButton}" FontSize="13" Margin="0,6,0,6"
                                ToolTip="Adım adım hızlı kurulum: her adımda toplu/akıllı ekleme." />
                        <Button x:Name="SetupWizardButton" Content="📋  RESTORAN TANIMLARI" Click="SetupWizard_Click"
                                Style="{StaticResource GhostButton}" FontSize="13" Margin="0,0,0,6"
                                ToolTip="Tüm tanım ekranlarına iş sırasına göre tek listeden ulaşın." />
                        <Button x:Name="LicenseButton" Content="🔐  LİSANS" Click="License_Click"
                                Style="{StaticResource GhostButton}" FontSize="13" Margin="0,0,0,6"
                                ToolTip="Lisans durumu / paket yükseltme / talep anahtarı." />
                        <Button x:Name="MobileServerButton" Content="📱  MOBİL SUNUCU" Click="MobileServer_Click"
                                Style="{StaticResource GhostButton}" FontSize="13" Margin="0,0,0,6"
                                ToolTip="Mobil uygulamaların bağlandığı sunucu: durum, adres ve QR kod." />
                        <Button x:Name="SystemMgmtButton" Content="🛠  SİSTEM YÖNETİMİ" Click="SystemManagement_Click"
                                Style="{StaticResource GhostButton}" FontSize="13" Margin="0,0,0,12"
                                ToolTip="Uygulama güncelleme ve mobil sunucu yönetimi." />

                        <ToggleButton x:Name="GrpProduct" Content="ÜRÜN YÖNETİMİ" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpProductItems">
                            <RadioButton x:Name="NavProducts" Tag="📦" Content="Ürünler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavProducts_Checked" />
                            <RadioButton x:Name="NavCategories" Tag="🗂" Content="Kategoriler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCategories_Checked" />
                            <RadioButton x:Name="NavTax" Tag="🧾" Content="Vergi Grupları" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavTax_Checked" />
                            <RadioButton x:Name="NavWarehouses" Tag="🏬" Content="Depolar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavWarehouses_Checked" />
                            <RadioButton x:Name="NavPriceLists" Tag="🏷" Content="Fiyat Listeleri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavPriceLists_Checked" />
                            <RadioButton x:Name="NavSalesStop" Tag="⛔" Content="Satış Durdurma" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavSalesStop_Checked" />
                            <RadioButton x:Name="NavCodeSeries" Tag="🔢" Content="Kod Serileri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCodeSeries_Checked" />
                            <Button x:Name="CsvImportButton" Content="⬆  CSV İçe Aktarım" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="CsvImport_Click" Visibility="Collapsed" />
                            <Button x:Name="PriceTransferButton" Content="🔁  Şube Fiyat Aktarımı" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PriceTransfer_Click" Visibility="Collapsed" />
                            <Button x:Name="BulkPriceButton" Content="₺  Toplu Fiyat Düzenleme" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="BulkPrice_Click" Visibility="Collapsed" />
                            <Button x:Name="QuickProductButton" Content="⚡  Hızlı Ürün Tanımlama" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="QuickProduct_Click" Visibility="Collapsed" />
                            <Button x:Name="PriceMatrixButton" Content="🔀  Şube·Liste Fiyat Matrisi" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PriceMatrix_Click" Visibility="Collapsed" />
                            <Button x:Name="CampaignButton" Content="🎁  Kampanyalar" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Campaign_Click" Visibility="Collapsed" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpCustomer" Content="MÜŞTERİ YÖNETİMİ" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpCustomerItems">
                            <RadioButton x:Name="NavCustomers" Tag="👥" Content="Müşteriler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCustomers_Checked" />
                            <RadioButton x:Name="NavCustomerGroups" Tag="👪" Content="Müşteri Grupları" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCustomerGroups_Checked" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpLocation" Content="LOKASYON YÖNETİMİ" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpLocationItems">
                            <RadioButton x:Name="NavZones" Tag="📍" Content="Lokasyonlar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavZones_Checked" />
                            <RadioButton x:Name="NavReyons" Tag="🍳" Content="Reyonlar (Mutfak)" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavReyons_Checked" />
                            <Button x:Name="LayoutButton" Content="🪑  Masa Planı" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="Layout_Click" />
                            <Button x:Name="ReyonRouteButton" Content="🔀  Reyon Yönlendirme (Mutfak/Bar)" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="ReyonRoute_Click" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpFinance" Content="FİNANS YÖNETİMİ" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpFinanceItems">
                            <TextBlock Text="TANIMLAR" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <RadioButton x:Name="NavBanks" Tag="🏦" Content="Bankalar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavBanks_Checked" />
                            <RadioButton x:Name="NavBankAccounts" Tag="💳" Content="Banka Hesapları" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavBankAccounts_Checked" />
                            <RadioButton x:Name="NavPos" Tag="💳" Content="Kredi Kartı POS" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavPos_Checked" />
                            <RadioButton x:Name="NavCashRegisters" Tag="💵" Content="Nakit Kasalar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCashRegisters_Checked" />
                            <RadioButton x:Name="NavKiosks" Tag="🖥" Content="KIOSK'lar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavKiosks_Checked" />
                            <RadioButton x:Name="NavMealVouchers" Tag="🍽" Content="Yemek Çekleri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavMealVouchers_Checked" />
                            <RadioButton x:Name="NavMealVoucherAccounts" Tag="🧾" Content="Yemek Çek Hesapları" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavMealVoucherAccounts_Checked" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="💵 KASA İŞLEMLERİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button Content="⬆  Kasa Giriş Dekontu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="KasaGirisDekont_Click" />
                            <Button Content="⬇  Kasa Çıkış Dekontu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="KasaCikisDekont_Click" />
                            <Button Content="💰  Kasa Hareketleri" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Kasa_Click" />
                            <Button x:Name="CashExtractButton" Content="📒  Nakit Kasa Ekstresi" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="CashExtract_Click" />

                            <StackPanel x:Name="FinBankSection">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="🏦 BANKA İŞLEMLERİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button Content="⬆  Banka Giriş Dekontu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="BankaGirisDekont_Click" />
                            <Button Content="⬇  Banka Çıkış Dekontu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="BankaCikisDekont_Click" />
                            <Button x:Name="BankaButton" Content="🏦  Banka Hareketleri" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="Banka_Click" />
                            <Button x:Name="BankaBakiyeButton" Content="⚖  Banka Bakiye" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="BankaBakiye_Click" />
                            <Button x:Name="BankExtractButton" Content="📒  Banka Hesap Ekstresi" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="BankExtract_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FinCardSection">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="💳 KREDİ KARTI İŞLEMLERİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button Content="⬆  Kart Tahsilat Evrağı" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="KartTahsilatDekont_Click" />
                            <Button Content="⬇  Kart Ödeme Evrağı" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="KartOdemeDekont_Click" />
                            <Button x:Name="PosHareketButton" Content="💳  POS Hareketleri" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PosHareket_Click" />
                            <Button x:Name="PosBakiyeButton" Content="📄  POS Bakiye Raporu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PosBakiye_Click" />
                            <Button x:Name="PosExtractButton" Content="📒  POS Hareket Ekstresi" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PosExtract_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FinCheckSection">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="🧾 ÇEK / SENET İŞLEMLERİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button x:Name="CekSenetButton" Content="🧾  Çek / Senet Portföyü" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="CekSenet_Click" />
                            <Button x:Name="CekVadeButton" Content="📆  Çek/Senet Vade Takibi" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="CekVade_Click" />
                            <Button x:Name="CekVadeYakinButton" Content="⏰  Vadesi Yaklaşan Çek/Senet" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="CekVadeYakin_Click" />
                            <Button x:Name="CekSenetRaporButton" Content="📄  Çek/Senet Portföy Raporu" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="CekSenetRapor_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FinVoucherSection">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="🍽 YEMEK ÇEKİ İŞLEMLERİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button x:Name="YemekCekiCikisButton" Content="🎫  Yemek Çeki Çıkışı (Satış Faturası)" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="YemekCekiCikis_Click" />
                            <Button x:Name="VoucherExtractButton" Content="📒  Yemek Çeki Ekstresi" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="VoucherExtract_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FinLoyaltySection">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,4" Opacity="0.5" />
                            <TextBlock Text="🎁 SADAKAT &amp; HEDİYE ÇEKİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,3" />
                            <Button x:Name="GiftCardButton" Content="🎁  Hediye Çekleri (sat / iptal / ekstre)" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="GiftCard_Click" />
                            <Button x:Name="LoyaltySettingsButton" Content="⭐  Sadakat Ayarları (puan oranları)" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="LoyaltySettings_Click" />
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton x:Name="GrpReservation" Content="REZERVASYON" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpReservationItems">
                            <RadioButton x:Name="NavResTags" Tag="🏷" Content="Rezervasyon Etiketleri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavResTags_Checked" />
                            <Button x:Name="ReservationButton" Content="🗓  Rezervasyon Ekranı" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="Reservation_Click" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpPaket" Content="PAKET / KURYE" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpPaketItems">
                            <RadioButton x:Name="NavCouriers" Tag="🛵" Content="Kuryeler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCouriers_Checked" />
                            <Button x:Name="DeliverySettingsButton" Content="🛍  Yemek Sitesi Ayarları" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="DeliverySettings_Click" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpCompany" Content="ŞİRKET YÖNETİMİ" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpCompanyItems">
                            <RadioButton x:Name="NavCompanies" Tag="🏢" Content="Şirket Bilgileri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCompanies_Checked" />
                            <RadioButton x:Name="NavBranches" Tag="🏪" Content="Şubeler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavBranches_Checked" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpErp" Content="PROJE / PERSONEL" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpErpItems">
                            <RadioButton x:Name="NavProjects" Tag="📁" Content="Projeler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavProjects_Checked" />
                            <RadioButton x:Name="NavPersonnel" Tag="🧑" Content="Personel" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavPersonnel_Checked" />
                            <RadioButton x:Name="NavExpenseTypes" Tag="🧾" Content="Gider Tipleri" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavExpenseTypes_Checked" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpAccounting" Content="ÖN MUHASEBE" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpAccountingItems">
                            <RadioButton x:Name="NavCariHareket" Tag="📒" Content="Cari Hareketler" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavCariHareket_Checked" />
                            <Button x:Name="CariEkstreButton" Content="📄  Cari Ekstre" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="CariEkstre_Click" />
                            <Button x:Name="CariBakiyeButton" Content="⚖  Cari Bakiye" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="CariBakiye_Click" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpOrders" Content="SİPARİŞLER" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpOrdersItems">
                            <Button x:Name="SalesOrderButton" Content="🧾  Satış Siparişleri" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,4,0,0" Click="SalesOrder_Click" />
                            <Button x:Name="PurchaseOrderButton" Content="🧾  Alış Siparişleri" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PurchaseOrder_Click" />
                        </StackPanel>

                        <ToggleButton x:Name="GrpWaybills" Content="İRSALİYELER" Style="{StaticResource NavGroupHeader}" IsChecked="True" Click="Group_Click" />
                        <StackPanel x:Name="GrpWaybillsItems">
                            <Button x:Name="SalesWaybillButton" Content="🚚  Satış İrsaliyeleri" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,4,0,0" Click="SalesWaybill_Click" />
                            <Button x:Name="PurchaseWaybillButton" Content="🚚  Alış İrsaliyeleri" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Margin="0,6,0,0" Click="PurchaseWaybill_Click" />
