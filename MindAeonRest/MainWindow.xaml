                    <DataGrid x:Name="CashRegistersGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="CashRegistersGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Kasa Adı" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Şube" Binding="{Binding BranchName}" Width="2*" />
                            <DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="80" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Yemek Çekleri -->
                    <DataGrid x:Name="MealVouchersGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="MealVouchersGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Yemek Çeki Adı" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Yemek Çek Hesapları -->
                    <DataGrid x:Name="MealVoucherAccountsGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="MealVoucherAccountsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Hesap Adı" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Şube" Binding="{Binding BranchName}" Width="2*" />
                            <DataGridTextColumn Header="Yemek Çeki" Binding="{Binding MealVoucherName}" Width="2*" />
                            <DataGridTextColumn Header="Döviz" Binding="{Binding CurrencyCode}" Width="80" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Kuryeler -->
                    <DataGrid x:Name="CouriersGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="CouriersGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Ad Soyad" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Projeler -->
                    <DataGrid x:Name="ProjectsGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="ProjectsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Proje Adı" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Personel -->
                    <DataGrid x:Name="PersonnelGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="PersonnelGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="2*" />
                            <DataGridTextColumn Header="Görev" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Departman" Binding="{Binding Department}" Width="*" />
                            <DataGridTextColumn Header="Şube" Binding="{Binding BranchName}" Width="*" />
                            <DataGridTextColumn Header="Maaş" Binding="{Binding SalaryText}" Width="100" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Gider Tipleri -->
                    <DataGrid x:Name="ExpenseTypesGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="ExpenseTypesGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Gider Tipi" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Maaş Tipi" Binding="{Binding SalaryText}" Width="2*" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Cari Hareketler -->
                    <DataGrid x:Name="CariHareketGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="150" />
                            <DataGridTextColumn Header="Cari" Binding="{Binding CustomerName}" Width="2*" />
                            <DataGridTextColumn Header="Belge Tipi" Binding="{Binding DocTypeText}" Width="*" />
                            <DataGridTextColumn Header="Belge No" Binding="{Binding DocNo}" Width="110" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*" />
                            <DataGridTextColumn Header="Borç" Binding="{Binding Debt, StringFormat=N2}" Width="110" />
                            <DataGridTextColumn Header="Alacak" Binding="{Binding Credit, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rezervasyon Etiketleri -->
                    <DataGrid x:Name="ResTagsGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}"
                              MouseDoubleClick="ResTagsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Etiket Adı" Binding="{Binding Name}" Width="2*" />
                            <DataGridTemplateColumn Header="Renk" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="16" CornerRadius="4" Background="{Binding ColorOrDefault}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Satış Durdurma (çoklu seçim) -->
                    <DataGrid x:Name="SalesStopGrid" Visibility="Collapsed" Style="{StaticResource DataGridStyle}"
                              SelectionMode="Extended"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}" CellStyle="{StaticResource DataGridCell}" RowStyle="{StaticResource DataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource DeletedAwareText}" />
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Satış Durumu" Binding="{Binding StatusText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
