<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MindAeonRest</AssemblyName>
    <RootNamespace>MindAeonRest</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Sürüm: self-update karşılaştırması (sunucudaki version.json ile). Her yayında artır. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uygulama ikonu: exe + başlık çubuklu pencerelerde (MainWindow) kullanılır -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms yalnızca 2. monitör (Screen) için; global using'leri WPF ile çakışmasın diye kaldırıldı -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SharpCompress" Version="0.36.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bağlantı ayarları exe ile aynı dizine kopyalanır; kullanıcı düzenlemişse korunur -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAeonRest.Licensing\MindAeonRest.Licensing.csproj" />
    <ProjectReference Include="..\MindAeonRest.Core\MindAeonRest.Core.csproj" />
  </ItemGroup>

</Project>
