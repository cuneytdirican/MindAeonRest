<?xml version="1.0" encoding="utf-8"?>
<!--
  MindAeonRestWeb — TEK uygulama: back-office + POS API (/api) + SignalR (/hubs) + PWA (/app) hepsi burada.
  Ayrı süreç / ters-proxy (ARR) GEREKMEZ. SignalR için IIS "WebSocket Protocol" özelliği kurulu olsun.
  aspNetCore öğesini dotnet publish otomatik günceller.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <webSocket enabled="true" pingInterval="00:00:30" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MindAeonRestWeb.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
