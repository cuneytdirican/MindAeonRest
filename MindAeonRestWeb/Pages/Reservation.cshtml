@page
@model MindAeonRestWeb.Pages.ReservationModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
    <meta name="theme-color" content="#0f1115" />
    <title>Rezervasyon · MindAeon</title>
    <link rel="stylesheet" href="~/css/reservation.css" asp-append-version="true" />
</head>
<body>
    <div id="rz-app" aria-live="polite"></div>
    @* Token yalnız istemciye taşınır; doğrulama ReservationPublicController'da (sunucuda) yapılır. *@
    <script>window.RESERVATION_TOKEN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Token));</script>
    <script src="~/js/reservation.js" asp-append-version="true"></script>
</body>
</html>
