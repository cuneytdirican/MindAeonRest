@page "{id:int?}"
@model MindAeonRestWeb.Pages.BackOffice.CustomerGroups.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Müşteri Grubu" : $"Müşteri Grubu · {Model.Code}";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>👪 @(Model.IsNew ? "Yeni Müşteri Grubu" : "Müşteri Grubu Düzenle")</h1>
    <a class="btn btn-ghost" href="/BackOffice/CustomerGroups">← Liste</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">@Model.Error</div>
}

<div class="bo-card bo-form">
    <form method="post">
        <div class="frm-row">
            <label>Kod *</label>
            @if (Model.IsNew)
            {
                <input asp-for="Code" class="field up" maxlength="50" autocomplete="off" required />
                <small class="hint">Firma bazında benzersiz; otomatik BÜYÜK harfe çevrilir.</small>
            }
            else
            {
                <input value="@Model.Code" class="field up" readonly />
                <input type="hidden" asp-for="Code" />
                <small class="hint">Kod mevcut kayıtlarda değiştirilemez.</small>
            }
        </div>
        <div class="frm-row">
            <label>Grup Adı *</label>
            <input asp-for="Name" class="field" maxlength="150" required />
        </div>
        <div class="frm-row">
            <label class="chk"><input asp-for="IsActive" type="checkbox" /> Aktif</label>
        </div>
        <div class="frm-actions">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/BackOffice/CustomerGroups" class="btn btn-ghost">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Kod alanı: elle BÜYÜK harf (server CodeHelper.Normalize ile de garanti).
        document.querySelector('input[name="Code"]:not([type=hidden])')?.addEventListener('input', e => e.target.value = e.target.value.toLocaleUpperCase('tr-TR'));
    </script>
}
