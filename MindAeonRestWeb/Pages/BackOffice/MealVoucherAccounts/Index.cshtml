@page
@model MindAeonRestWeb.Pages.BackOffice.MealVoucherAccounts.IndexModel
@{
    ViewData["Title"] = "Yemek Çek Hesapları";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🎫 Yemek Çek Hesapları</h1>
    <a class="btn btn-primary" href="/BackOffice/MealVoucherAccounts/Edit">+ Yeni Hesap</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Kod, ad, şube veya çek ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Kod</th><th>Ad</th><th>Şube</th><th>Yemek Çeki</th><th>Döviz</th><th>Kapsam</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var a in Model.Items)
        {
            <tr class="@(a.IsDeleted ? "row-deleted" : "")">
                <td><b>@a.Code</b></td>
                <td>@a.Name</td>
                <td>@(a.BranchName ?? "—")</td>
                <td>@(a.MealVoucherName ?? "—")</td>
                <td>@(a.CurrencyCode ?? "—")</td>
                <td>@a.ScopeText</td>
                <td>
                    @if (a.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (a.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!a.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/MealVoucherAccounts/Edit/@a.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
