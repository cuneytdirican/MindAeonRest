@page
@model MindAeonRestWeb.Pages.BackOffice.Branches.IndexModel
@{
    ViewData["Title"] = "Şubeler";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🏢 Şubeler</h1>
    <a class="btn btn-primary" href="/BackOffice/Branches/Edit">+ Yeni Şube</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Kod veya ad ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Kod</th><th>Ad</th><th>Gün Başlangıcı</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="5" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var b in Model.Items)
        {
            <tr class="@(b.IsDeleted ? "row-deleted" : "")">
                <td><b>@b.Code</b></td>
                <td>@b.Name</td>
                <td>@b.DayStartText</td>
                <td>
                    @if (b.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (b.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!b.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/Branches/Edit/@b.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
