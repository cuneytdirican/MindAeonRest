@page
@using MindAeonRest.Helpers
@model MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel
@{
    ViewData["Title"] = "Kurulum Sihirbazı";
    Layout = "_BackOfficeLayout";
    var step = Model.Step;
    var last = MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.StepCount - 1;
    var info = MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.Steps[step];
}

<div class="bo-page-head">
    <h1>🚀 Kurulum Sihirbazı</h1>
    <a class="btn btn-ghost" href="/BackOffice">← Geri Ofis</a>
</div>

@* ---- Adım göstergesi şeridi (mevcut sınıflar + inline style; yeni CSS yok) ---- *@
<div class="bo-card" style="padding:12px 14px;margin-bottom:14px">
    <div style="display:flex;flex-wrap:wrap;gap:6px">
        @for (int i = 0; i < MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.StepCount; i++)
        {
            var s = MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.Steps[i];
            var cur = i == step;
            var done = i < step;
            var bg = cur ? "var(--accent,#4f7cff)" : (done ? "var(--bg2,#2a2f3a)" : "transparent");
            var fg = cur ? "#fff" : (done ? "var(--text,#e6e6e6)" : "var(--muted,#8a8f98)");
            var bd = cur ? "var(--accent,#4f7cff)" : "var(--line,#333)";
            <a href="?step=@i" style="display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:8px;text-decoration:none;font-size:12.5px;font-weight:600;background:@bg;color:@fg;border:1px solid @bd">
                <span>@(done ? "✓" : (i + 1).ToString())</span>
                <span>@s.Title</span>
            </a>
        }
    </div>
</div>

<div class="bo-page-head" style="margin-bottom:8px">
    <div>
        <h1 style="font-size:20px">@(step + 1). @info.Title</h1>
        <div style="color:var(--muted);font-size:13px;margin-top:4px">@info.Desc</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Info)) { <div class="alert-success">@Model.Info</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert-error">@Model.Error</div> }

@* ==================== ADIM İÇERİKLERİ ==================== *@

@if (step == 0)
{
    <div class="bo-card" style="padding:18px">
        @if (Model.Sector is not null)
        {
            <div class="alert-success" style="display:flex;justify-content:space-between;align-items:center">
                <span>Seçili sektör: @Model.Sector.Icon @Model.Sector.Name — @Model.Sector.Categories.Length kategori, @Model.Sector.Zones.Length lokasyon + örnek ürünler hazır. Sonraki adımlarda işaretli/dolu gelir.</span>
                <form method="post" asp-page-handler="ClearSector" style="margin:0">
                    <button type="submit" class="btn btn-sm btn-ghost">Seçimi temizle</button>
                </form>
            </div>
        }
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
            @foreach (var s in MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.Sectors)
            {
                var sel = Model.Sector?.Name == s.Name;
                <form method="post" asp-page-handler="ChooseSector" style="margin:0">
                    <input type="hidden" name="name" value="@s.Name" />
                    <button type="submit" style="width:100%;cursor:pointer;text-align:center;padding:16px 10px;border-radius:10px;background:@(sel ? "var(--accent,#4f7cff)" : "var(--card,#1c2029)");color:@(sel ? "#fff" : "var(--text,#e6e6e6)");border:@(sel ? "2px" : "1px") solid @(sel ? "var(--accent,#4f7cff)" : "var(--line,#333)")">
                        <div style="font-size:34px">@s.Icon</div>
                        <div style="font-weight:700;font-size:14px;margin-top:4px">@s.Name</div>
                        <div style="font-size:10.5px;opacity:.8;margin-top:4px">@string.Join(" · ", s.Categories.Take(4))</div>
                    </button>
                </form>
            }
        </div>
    </div>
}

@if (step == 1)
{
    <div class="bo-card" style="padding:18px;margin-bottom:12px">
        <h3 style="margin:0 0 8px">Mevcut şubeler (@Model.Branches.Count)</h3>
        @if (Model.Branches.Count == 0) { <div style="color:var(--muted);font-style:italic">Henüz şube yok.</div> }
        else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var b in Model.Branches) { <span style="background:var(--bg2,#2a2f3a);border-radius:6px;padding:4px 9px;font-size:12px">@b.Name</span> }</div> }
    </div>
    <div class="bo-card bo-form">
        <h3 style="margin:0 0 4px">Hızlı ekle</h3>
        <div style="color:var(--muted);font-size:12px;margin-bottom:10px">Kaç şube istersiniz? Otomatik isimlendirilir (örn. 'Şube 1, Şube 2…').</div>
        <form method="post" asp-page-handler="CreateBranches">
            <div class="frm-row"><label>Adet</label><input type="number" name="count" value="1" min="1" class="field" style="max-width:120px" /></div>
            <div class="frm-row"><label>Önek</label><input type="text" name="prefix" value="Şube" class="field" style="max-width:220px" /></div>
            <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Topluca oluştur</button></div>
        </form>
        <div style="color:var(--muted);font-size:12px;margin-top:10px">Detaylı şube için <a href="/BackOffice/Branches/Edit">şube ekle ekranını</a> kullanabilirsiniz.</div>
    </div>
}

@if (step == 2)
{
    @if (Model.Branches.Count == 0)
    {
        <div class="bo-card" style="padding:18px;color:var(--muted)">Önce en az bir şube ekleyin (önceki adım).</div>
    }
    else
    {
        var zoneNames = Model.Sector?.Zones is { Length: > 0 } sz ? sz : MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.CommonZones;
        <div class="bo-card bo-form" style="max-width:720px">
            <form method="post" asp-page-handler="AddZones">
                <div class="frm-row">
                    <label>Şube</label>
                    <select name="branchId" class="field" style="max-width:320px">
                        @foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }
                    </select>
                </div>
                <div class="frm-row">
                    <label>Yaygın lokasyonlar</label>
                    <div class="chk-grid">
                        @foreach (var z in zoneNames)
                        {
                            <label class="chk"><input type="checkbox" name="zones" value="@z" @(Model.Sector != null ? "checked" : "") /> @z</label>
                        }
                    </div>
                </div>
                <div class="frm-row"><label>Diğer (virgülle)</label><input type="text" name="custom" class="field" placeholder="örn. Bahçe Üst, Sigara İçilen" /></div>
                <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Seçilenleri ekle</button></div>
            </form>
        </div>
        <div class="bo-card" style="padding:14px 18px">
            <h3 style="margin:0 0 8px">Tüm mevcut lokasyonlar (@Model.Zones.Count)</h3>
            @if (Model.Zones.Count == 0) { <div style="color:var(--muted);font-style:italic">Henüz lokasyon yok.</div> }
            else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var z in Model.Zones) { <span style="background:var(--bg2,#2a2f3a);border-radius:6px;padding:4px 9px;font-size:12px">@z.Name (@z.BranchName)</span> }</div> }
        </div>
    }
}

@if (step == 3)
{
    @if (Model.Zones.Count == 0)
    {
        <div class="bo-card" style="padding:18px;color:var(--muted)">Önce lokasyon ekleyin (önceki adım).</div>
    }
    else
    {
        <div class="bo-card bo-form" style="max-width:720px">
            <form method="post" asp-page-handler="AutoReyons">
                <div class="frm-row">
                    <label>Lokasyon</label>
                    <select name="zoneId" class="field" style="max-width:360px">
                        @foreach (var z in Model.Zones) { <option value="@z.Id">@z.Name (@z.BranchName)</option> }
                    </select>
                </div>
                <div class="frm-actions"><button type="submit" class="btn btn-primary">🍳 Mutfak + 🍹 Bar otomatik oluştur</button></div>
            </form>
            <hr style="border:none;border-top:1px solid var(--line,#333);margin:14px 0" />
            <form method="post" asp-page-handler="AddReyons">
                <div class="frm-row">
                    <label>Lokasyon</label>
                    <select name="zoneId" class="field" style="max-width:360px">
                        @foreach (var z in Model.Zones) { <option value="@z.Id">@z.Name (@z.BranchName)</option> }
                    </select>
                </div>
                <div class="frm-row"><label>Reyon adı (virgülle)</label><input type="text" name="custom" class="field" placeholder="örn. Tatlı İstasyonu, Izgara" /></div>
                <div class="frm-actions"><button type="submit" class="btn btn-ghost">Ekle</button></div>
            </form>
        </div>
        <div class="bo-card" style="padding:14px 18px">
            <h3 style="margin:0 0 8px">Tüm reyonlar (@Model.Reyons.Count)</h3>
            @if (Model.Reyons.Count == 0) { <div style="color:var(--muted);font-style:italic">Henüz reyon yok.</div> }
            else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var r in Model.Reyons) { <span style="background:var(--bg2,#2a2f3a);border-radius:6px;padding:4px 9px;font-size:12px">@r.Name@(string.IsNullOrWhiteSpace(r.PrinterName) ? "" : " 🖨")</span> }</div> }
        </div>
    }
}

@if (step == 4)
{
    <div class="bo-card" style="padding:18px;margin-bottom:12px">
        <h3 style="margin:0 0 6px">Mevcut kural: @Model.Routes.Count</h3>
        <div style="color:var(--muted);font-size:12.5px">🤖 Otomatik kurulum: her lokasyonda, içecek/bar kategorileri o lokasyonun Bar reyonuna; diğer (yiyecek) kategoriler Mutfak reyonuna yönlendirilir. Bar yoksa Mutfak'a düşer.</div>
    </div>
    <div class="bo-card bo-form">
        <form method="post" asp-page-handler="AutoRoutes">
            <div class="frm-actions"><button type="submit" class="btn btn-primary">🤖 Otomatik yönlendirmeyi kur</button></div>
        </form>
    </div>
}

@if (step == 5)
{
    @if (Model.Zones.Count == 0)
    {
        <div class="bo-card" style="padding:18px;color:var(--muted)">Önce lokasyon ekleyin.</div>
    }
    else
    {
        <div class="bo-card bo-form" style="max-width:720px">
            <form method="post" asp-page-handler="AddTables">
                <div class="frm-row">
                    <label>Lokasyon</label>
                    <select name="zoneId" class="field" style="max-width:360px">
                        @foreach (var z in Model.Zones) { <option value="@z.Id">@z.Name (@z.BranchName)</option> }
                    </select>
                </div>
                <div class="frm-row"><label>Adet</label><input type="number" name="count" value="8" min="1" class="field" style="max-width:120px" /></div>
                <div class="frm-row"><label>Kişilik</label><input type="number" name="seats" value="4" min="1" class="field" style="max-width:120px" /></div>
                <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Masaları oluştur</button></div>
                <div style="color:var(--muted);font-size:12px;margin-top:8px">Masalar MASA1, MASA2… diye otomatik numaralanır; planda düzenleyebilirsiniz (Masa Planı).</div>
            </form>
        </div>
    }
}

@if (step == 6)
{
    var catNames = Model.Sector?.Categories is { Length: > 0 } sc ? sc : MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.CommonCats;
    <div class="bo-card" style="padding:14px 18px;margin-bottom:12px">
        <h3 style="margin:0 0 8px">Mevcut kategoriler (@Model.Categories.Count)</h3>
        @if (Model.Categories.Count == 0) { <div style="color:var(--muted);font-style:italic">Henüz kategori yok.</div> }
        else { <div style="display:flex;flex-wrap:wrap;gap:6px">@foreach (var c in Model.Categories) { <span style="background:var(--bg2,#2a2f3a);border-radius:6px;padding:4px 9px;font-size:12px">@c.Name</span> }</div> }
    </div>
    <div class="bo-card bo-form" style="max-width:720px">
        <form method="post" asp-page-handler="AddCategories">
            <div class="frm-row">
                <label>Yaygın kategoriler</label>
                <div class="chk-grid">
                    @foreach (var c in catNames)
                    {
                        <label class="chk"><input type="checkbox" name="cats" value="@c" @(Model.Sector != null ? "checked" : "") /> @c</label>
                    }
                </div>
            </div>
            <div class="frm-row"><label>Diğer (virgülle)</label><input type="text" name="custom" class="field" placeholder="örn. Kahvaltı, Vejetaryen" /></div>
            <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Seçilenleri ekle</button></div>
        </form>
    </div>
}

@if (step == 7)
{
    @if (Model.Categories.Count == 0)
    {
        <div class="bo-card" style="padding:18px;color:var(--muted)">Önce kategori ekleyin (önceki adım).</div>
    }
    else
    {
        var firstCat = Model.Categories.First();
        var prefill = Model.ProductsTextForCategory(firstCat.Name);
        <div class="bo-card bo-form" style="max-width:820px">
            <div style="color:var(--muted);font-size:12.5px;margin-bottom:10px">Toplam @Model.ProductCount ürün var.</div>
            <form method="post" asp-page-handler="AddProducts">
                <div class="frm-row">
                    <label>Kategori</label>
                    <select name="catId" id="wizCat" class="field" style="max-width:360px">
                        @foreach (var c in Model.Categories) { <option value="@c.Id" data-prefill="@Model.ProductsTextForCategory(c.Name)">@c.Name</option> }
                    </select>
                </div>
                <div class="frm-row">
                    <label>Ürünler — her satır 'Ad;Fiyat'</label>
                    <textarea name="lines" id="wizLines" class="field" rows="9" style="font-family:monospace">@(string.IsNullOrEmpty(prefill) ? "Ör:\nKola;45\nAyran;25\nKöfte;160" : prefill)</textarea>
                </div>
                <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Ürünleri ekle</button></div>
            </form>
        </div>
    }
}

@if (step == 8)
{
    var existBanks = new MindAeonRest.Services.BankService().GetAll().Select(b => b.Name.ToLowerInvariant()).ToHashSet();
    var existVo = new MindAeonRest.Services.MealVoucherService().GetAll().Select(v => v.Name.ToLowerInvariant()).ToHashSet();
    <div class="bo-card" style="padding:14px 18px;margin-bottom:12px">
        <h3 style="margin:0 0 6px">Durum</h3>
        <div style="color:var(--muted)">@Model.Branches.Count şube · @Model.CashCount kasa · @Model.KioskCount KIOSK tanımlı.</div>
    </div>
    <div class="bo-card bo-form" style="margin-bottom:12px">
        <form method="post" asp-page-handler="AutoFinance">
            <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Her şubeye Nakit Kasa + KIOSK #1 oluştur</button></div>
        </form>
        <div style="color:var(--muted);font-size:12px;margin-top:8px">POS ve hesap detaylarını ihtiyaç oldukça FİNANS menüsünden ekleyebilirsiniz.</div>
    </div>
    <div class="bo-card bo-form" style="max-width:900px;margin-bottom:12px">
        <h3 style="margin:0 0 4px">🏦 Türkiye Bankaları</h3>
        <div style="color:var(--muted);font-size:12px;margin-bottom:8px">Çalıştığınız bankaları işaretleyin.</div>
        <form method="post" asp-page-handler="AddBanks">
            <div class="chk-grid">
                @foreach (var n in MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.TurkBanks.Where(x => !existBanks.Contains(x.ToLowerInvariant())))
                {
                    <label class="chk"><input type="checkbox" name="banks" value="@n" /> @n</label>
                }
            </div>
            <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Seçili bankaları ekle</button></div>
        </form>
    </div>
    <div class="bo-card bo-form" style="max-width:900px">
        <h3 style="margin:0 0 4px">🎫 Yemek Çeki / Kart Şirketleri</h3>
        <div style="color:var(--muted);font-size:12px;margin-bottom:8px">Kabul ettiğiniz yemek çeki firmalarını işaretleyin.</div>
        <form method="post" asp-page-handler="AddVouchers">
            <div class="chk-grid">
                @foreach (var n in MindAeonRestWeb.Pages.BackOffice.SetupWizard.IndexModel.VoucherCos.Where(x => !existVo.Contains(x.ToLowerInvariant())))
                {
                    <label class="chk"><input type="checkbox" name="vouchers" value="@n" /> @n</label>
                }
            </div>
            <div class="frm-actions"><button type="submit" class="btn btn-primary">⚡ Seçili yemek çeklerini ekle</button></div>
        </form>
    </div>
}

@if (step == 9)
{
    <div class="bo-card" style="padding:18px">
        <h3 style="margin:0 0 12px">🎉 Kurulum özeti</h3>
        <table class="sub-grid" style="max-width:420px">
            <tbody>
                <tr><td>Şube</td><td>@(Model.Branches.Count > 0 ? "✓" : "○") @Model.Branches.Count</td></tr>
                <tr><td>Lokasyon</td><td>@(Model.Zones.Count > 0 ? "✓" : "○") @Model.Zones.Count</td></tr>
                <tr><td>Reyon</td><td>@(Model.Reyons.Count > 0 ? "✓" : "○") @Model.Reyons.Count</td></tr>
                <tr><td>Yönlendirme kuralı</td><td>@(Model.Routes.Count > 0 ? "✓" : "○") @Model.Routes.Count</td></tr>
                <tr><td>Kategori</td><td>@(Model.Categories.Count > 0 ? "✓" : "○") @Model.Categories.Count</td></tr>
                <tr><td>Ürün</td><td>@(Model.ProductCount > 0 ? "✓" : "○") @Model.ProductCount</td></tr>
                <tr><td>KIOSK</td><td>@(Model.KioskCount > 0 ? "✓" : "○") @Model.KioskCount</td></tr>
            </tbody>
        </table>
        <div style="color:var(--muted);font-size:12.5px;margin-top:12px">Eksik kalanları sol menüdeki RESTORAN TANIMLARI ya da ilgili ekranlardan tamamlayabilirsiniz.</div>
    </div>
}

@* ==================== NAVİGASYON ==================== *@
<div class="frm-actions" style="justify-content:space-between;margin-top:18px">
    <div>
        @if (step > 0) { <a class="btn btn-ghost" href="?step=@(step - 1)">◀ Geri</a> }
    </div>
    <div style="display:flex;gap:10px">
        @if (step < last)
        {
            <a class="btn btn-ghost" href="?step=@(step + 1)">Atla ▷</a>
            <a class="btn btn-primary" href="?step=@(step + 1)">İleri ▶</a>
        }
        else
        {
            <a class="btn btn-primary" href="/BackOffice">Bitir ✓</a>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Adım 7: kategori değişince sektör örnek ürünlerini otomatik doldur (WPF Prefill davranışı).
        (function () {
            var sel = document.getElementById('wizCat'), ta = document.getElementById('wizLines');
            if (!sel || !ta) return;
            sel.addEventListener('change', function () {
                var pf = sel.options[sel.selectedIndex].getAttribute('data-prefill') || '';
                if (pf.trim().length) ta.value = pf;
            });
        })();
    </script>
}
