@page
@model MindAeonRestWeb.Pages.BackOffice.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>👤 Kullanıcılar</h1>
    <a class="btn btn-primary" href="/BackOffice/Users/Edit">+ Yeni Kullanıcı</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Kullanıcı adı, ad soyad veya rol ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Kullanıcı Adı</th><th>Ad Soyad</th><th>Roller</th><th>Şube Erişimi</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var u in Model.Items)
        {
            <tr class="@(u.IsDeleted ? "row-deleted" : "")">
                <td><b>@u.Username</b></td>
                <td>@u.FullName</td>
                <td>@u.RolesText</td>
                <td>@(u.AccessSummary ?? "—")</td>
                <td>
                    @if (u.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (u.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!u.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/Users/Edit/@u.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
