@page
@model MindAeonRestWeb.Pages.BackOffice.CodeSeries.IndexModel
@{
    ViewData["Title"] = "Kod Serileri";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🔢 Kod Serileri</h1>
    <a class="btn btn-primary" href="/BackOffice/CodeSeries/Edit">+ Yeni Seri</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Tip, ön ek veya şube ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Kart Tipi</th><th>Şube</th><th>Ön Ek</th><th>Basamak</th><th>Başlangıç No</th><th>Sıradaki Kod</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var s in Model.Items)
        {
            <tr class="@(s.IsDeleted ? "row-deleted" : "")">
                <td><b>@s.EntityTypeText</b></td>
                <td>@s.BranchText</td>
                <td>@(string.IsNullOrEmpty(s.Prefix) ? "—" : s.Prefix)</td>
                <td>@s.Padding</td>
                <td>@s.NextNumber</td>
                <td><span class="muted">@s.NextCodePreview</span></td>
                <td>
                    @if (s.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (s.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!s.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/CodeSeries/Edit/@s.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
