@page "{id:int?}"
@model MindAeonRestWeb.Pages.BackOffice.CodeSeries.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Kod Serisi" : "Kod Serisi";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🔢 @(Model.IsNew ? "Yeni Kod Serisi" : "Kod Serisi Düzenle")</h1>
    <a class="btn btn-ghost" href="/BackOffice/CodeSeries">← Liste</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">@Model.Error</div>
}

<div class="bo-card bo-form">
    <p class="hint" style="margin-top:0">Yeni kart açılışında otomatik artan kod önerilir; kayıtta numara artar.</p>
    <form method="post">
        <div class="frm-row">
            <label>Kart Tipi *</label>
            <select asp-for="EntityType" asp-items="Model.TypeOptions" class="field" required></select>
        </div>
        <div class="frm-row">
            <label>Şube</label>
            <select asp-for="BranchId" asp-items="Model.BranchOptions" class="field"></select>
            <small class="hint">Evrak serileri için; boş = tüm şubeler (varsayılan).</small>
        </div>
        <div class="frm-row">
            <label>Ön Ek</label>
            <input asp-for="Prefix" class="field up" maxlength="20" autocomplete="off" />
            <small class="hint">Otomatik BÜYÜK harfe çevrilir.</small>
        </div>
        <div class="frm-row">
            <label>Basamak *</label>
            <input asp-for="Padding" type="number" min="1" max="18" class="field" required />
        </div>
        <div class="frm-row">
            <label>Başlangıç No *</label>
            <input asp-for="NextNumber" type="number" min="1" class="field" required />
        </div>
        <div class="frm-row">
            <label>Sıradaki Kod</label>
            <div class="img-prev"><b id="preview">—</b></div>
        </div>
        <div class="frm-row">
            <label class="chk"><input asp-for="IsActive" type="checkbox" /> Seri aktif</label>
        </div>
        <div class="frm-actions">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/BackOffice/CodeSeries" class="btn btn-ghost">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const prefixEl = document.querySelector('input[name="Prefix"]');
        const padEl = document.querySelector('input[name="Padding"]');
        const nextEl = document.querySelector('input[name="NextNumber"]');
        const previewEl = document.getElementById('preview');

        // Ön ek: elle BÜYÜK harf (server CodeHelper.Normalize ile de garanti).
        prefixEl?.addEventListener('input', e => { e.target.value = e.target.value.toLocaleUpperCase('tr-TR'); updatePreview(); });

        function updatePreview() {
            const prefix = prefixEl?.value ?? '';
            let pad = parseInt(padEl?.value, 10); if (isNaN(pad) || pad < 1) pad = 1;
            let next = parseInt(nextEl?.value, 10); if (isNaN(next) || next < 1) next = 1;
            previewEl.textContent = prefix + String(next).padStart(pad, '0');
        }

        padEl?.addEventListener('input', updatePreview);
        nextEl?.addEventListener('input', updatePreview);
        updatePreview();
    </script>
}
