@page
@model MindAeonRestWeb.Pages.BackOffice.Products.IndexModel
@{
    ViewData["Title"] = "Ürünler";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>📦 Ürünler</h1>
    <a class="btn btn-primary" href="/BackOffice/Products/Edit">+ Yeni Ürün</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Kod veya ad ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th style="width:44px">Resim</th><th>Kod</th><th>Ad</th><th>Ana Birim</th><th>Satış Vergisi</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="7" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var p in Model.Items)
        {
            <tr class="@(p.IsDeleted ? "row-deleted" : "")">
                <td>@if (p.HasImage) { <img class="thumb" src="/BackOffice/Products?handler=Image&id=@p.Id" alt="" loading="lazy" /> } else { <span class="muted">—</span> }</td>
                <td><b>@p.Code</b></td>
                <td>@p.Name</td>
                <td>@(string.IsNullOrEmpty(p.MainUnitName) ? "—" : p.MainUnitName)</td>
                <td>@(string.IsNullOrEmpty(p.SalesTaxName) ? "—" : p.SalesTaxName)</td>
                <td>
                    @if (p.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (p.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!p.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/Products/Edit/@p.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
