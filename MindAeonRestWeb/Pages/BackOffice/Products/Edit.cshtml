        // Mevcut resmi "sil" işaretle (gizle + Remove=true; hidden Id form ile gider).
        function removeExistingImage(btn) {
            const card = btn.closest('.field');
            if (!card) return;
            card.querySelector('.img-remove-flag').value = 'true';
            const radio = card.querySelector('input[type="radio"]');
            if (radio) radio.checked = false;
            card.style.display = 'none';
        }

        // ---- "+" hızlı ekleme (AJAX → Service.Save → seçici/listeye ekle) ----
        async function quickPost(handler, code, name) {
            const fd = new FormData();
            fd.append('code', code);
            fd.append('name', name);
            fd.append('__RequestVerificationToken', ANTIFORGERY);
            const res = await fetch(`?handler=${handler}`, { method: 'POST', body: fd });
            return await res.json();
        }

        async function quickAddUnit() {
            const code = prompt('Yeni birim kodu (ör. ADET):'); if (!code) return;
            const name = prompt('Birim adı:'); if (!name) return;
            const r = await quickPost('QuickUnit', code, name);
            if (!r.ok) { alert(r.error); return; }
            // Tüm birim seçicilerine ekle.
            document.querySelectorAll('#mainUnitSelect, select[name$=".UnitId"]').forEach(sel => {
                sel.appendChild(new Option(r.text, r.id));
            });
            document.getElementById('mainUnitSelect').value = r.id;
        }

        async function quickAddTax() {
            const code = prompt('Yeni vergi grubu kodu:'); if (!code) return;
            const name = prompt('Vergi grubu adı:'); if (!name) return;
            const r = await quickPost('QuickTax', code, name);
            if (!r.ok) { alert(r.error); return; }
            document.querySelectorAll('.tax-select').forEach(sel => sel.appendChild(new Option(r.text, r.id)));
        }

        async function quickAddCategory() {
            const code = prompt('Yeni kategori kodu:'); if (!code) return;
            const name = prompt('Kategori adı:'); if (!name) return;
            const r = await quickPost('QuickCategory', code, name);
            if (!r.ok) { alert(r.error); return; }
            const grid = document.getElementById('categoryGrid');
            const lbl = document.createElement('label');
            lbl.className = 'chk';
            lbl.innerHTML = `<input type="checkbox" name="CategoryIds" value="${r.id}" checked /> ${r.name} <span class="muted">(${r.code})</span>`;
            grid.appendChild(lbl);
            document.getElementById('noCategoryHint')?.remove();
        }
    </script>
