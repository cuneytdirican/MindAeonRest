            tr.className = 'price-row';
            tr.innerHTML =
                `<td><select name="Prices[${i}].PriceType" class="field">${pt}</select></td>` +
                `<td><select name="Prices[${i}].UnitId" class="field">${unitOptionsHtml()}</select></td>` +
