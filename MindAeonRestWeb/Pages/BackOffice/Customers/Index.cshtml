@page
@model MindAeonRestWeb.Pages.BackOffice.Customers.IndexModel
@{
    ViewData["Title"] = "Müşteriler";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>👥 Müşteriler</h1>
    <a class="btn btn-primary" href="/BackOffice/Customers/Edit">+ Yeni Müşteri</a>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Kod, ünvan veya telefon ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Kod</th><th>Ünvan / Ad</th><th>Grup</th><th>Telefon</th><th>Durum</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var c in Model.Items)
        {
            <tr class="@(c.IsDeleted ? "row-deleted" : "")">
                <td><b>@c.Code</b></td>
                <td>@c.Name</td>
                <td>@(c.CustomerGroupName ?? "—")</td>
                <td>@(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)</td>
                <td>
                    @if (c.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (c.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td class="ar">
                    @if (!c.IsDeleted)
                    {
                        <a class="btn btn-sm" href="/BackOffice/Customers/Edit/@c.Id">Düzenle</a>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
