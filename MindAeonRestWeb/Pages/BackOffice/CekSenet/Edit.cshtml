@page "{id:int?}"
@model MindAeonRestWeb.Pages.BackOffice.CekSenet.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Çek / Senet" : $"Çek / Senet · #{Model.Id}";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🧾 @(Model.IsNew ? "Yeni Çek / Senet" : "Çek / Senet Detayı")</h1>
    <a class="btn btn-ghost" href="/BackOffice/CekSenet">← Liste</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-error">@Model.Error</div>
}

@if (Model.IsNew)
{
    <div class="bo-card bo-form">
        <p class="hint" style="margin-top:0">Kayıt eklendiğinde cari hareket otomatik oluşur (Alınan → cari alacak, Verilen → cari borç).</p>
        <form method="post">
            <div class="frm-row">
                <label>Tür *</label>
                <select asp-for="Kind" asp-items="Model.KindOptions" class="field" required></select>
            </div>
            <div class="frm-row">
                <label>Yön *</label>
                <select asp-for="Direction" asp-items="Model.DirectionOptions" class="field" required></select>
            </div>
            <div class="frm-row">
                <label>Cari *</label>
                <select asp-for="CustomerId" asp-items="Model.CustomerOptions" class="field" required></select>
            </div>
            <div class="frm-row">
                <label>Seri / No</label>
                <input asp-for="Serial" class="field" maxlength="60" autocomplete="off" />
            </div>
            <div class="frm-row">
                <label>Banka</label>
                <select asp-for="BankName" asp-items="Model.BankOptions" class="field"></select>
                <small class="hint">Çek için banka seçiniz; senette boş bırakabilirsiniz.</small>
            </div>
            <div class="frm-row">
                <label>Tutar *</label>
                <input asp-for="Amount" type="number" step="0.01" min="0" class="field" required />
            </div>
            <div class="frm-row">
                <label>Düzenleme Tarihi *</label>
                <input asp-for="IssueDate" type="date" class="field" required />
            </div>
            <div class="frm-row">
                <label>Vade Tarihi *</label>
                <input asp-for="DueDate" type="date" class="field" required />
            </div>
            <div class="frm-row">
                <label>Açıklama</label>
                <input asp-for="Note" class="field" maxlength="300" />
            </div>
            <div class="frm-actions">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/BackOffice/CekSenet" class="btn btn-ghost">Vazgeç</a>
            </div>
        </form>
    </div>
}
else if (Model.Existing is { } n)
{
    <div class="bo-card bo-form">
        <p class="hint" style="margin-top:0">Mevcut çek/senedin alanları değiştirilemez (kayıt cari hareketle bağlıdır). Yalnızca durum güncellenebilir — WPF ile aynı davranış.</p>
        <div class="frm-row"><label>Tür</label><input class="field" value="@n.KindText" readonly /></div>
        <div class="frm-row"><label>Yön</label><input class="field" value="@n.DirectionText" readonly /></div>
        <div class="frm-row"><label>Cari</label><input class="field" value="@n.CustomerName" readonly /></div>
        <div class="frm-row"><label>Seri / No</label><input class="field" value="@(string.IsNullOrEmpty(n.Serial) ? "—" : n.Serial)" readonly /></div>
        <div class="frm-row"><label>Banka</label><input class="field" value="@(string.IsNullOrEmpty(n.BankName) ? "—" : n.BankName)" readonly /></div>
        <div class="frm-row"><label>Tutar</label><input class="field" value="@n.AmountText" readonly /></div>
        <div class="frm-row"><label>Düzenleme Tarihi</label><input class="field" value="@n.IssueText" readonly /></div>
        <div class="frm-row"><label>Vade Tarihi</label><input class="field" value="@n.DueText" readonly /></div>
        <div class="frm-row"><label>Açıklama</label><input class="field" value="@(string.IsNullOrEmpty(n.Note) ? "—" : n.Note)" readonly /></div>

        <hr />
        <form method="post" asp-page-handler="Status" asp-route-id="@Model.Id"
              onsubmit="return confirm('Durum güncellensin mi? Karşılıksız seçilirse cari hareket ters çevrilir.')">
            <div class="frm-row">
                <label>Durum</label>
                <select asp-for="NewStatus" asp-items="Model.StatusOptions" class="field"></select>
                <small class="hint">Karşılıksız → cari hareket ters çevrilir.</small>
            </div>
            <div class="frm-actions">
                <button type="submit" class="btn btn-primary">Durumu Uygula</button>
                <a href="/BackOffice/CekSenet" class="btn btn-ghost">Vazgeç</a>
            </div>
        </form>
    </div>
}
