@page
@model MindAeonRestWeb.Pages.BackOffice.Roles.IndexModel
@{
    ViewData["Title"] = "Roller";
    Layout = "_BackOfficeLayout";
}

<div class="bo-page-head">
    <h1>🛡️ Roller</h1>
</div>

<form method="get" class="bo-filter">
    <input type="text" name="Q" value="@Model.Q" placeholder="Ad veya açıklama ara..." class="field" />
    <label class="chk"><input type="checkbox" name="ShowDeleted" value="true" @(Model.ShowDeleted ? "checked" : "") /> Silinenleri göster</label>
    <button type="submit" class="btn">Göster</button>
</form>

<div class="bo-card">
    <table class="bo-table">
        <thead>
            <tr><th>Rol</th><th>Açıklama</th><th>Durum</th><th>AI Yetkisi</th><th class="ar">İşlem</th></tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="5" class="empty">Kayıt yok.</td></tr>
        }
        @foreach (var r in Model.Items)
        {
            <tr class="@(r.IsDeleted ? "row-deleted" : "")">
                <td><b>@r.Name</b></td>
                <td>@r.Description</td>
                <td>
                    @if (r.IsDeleted) { <span class="badge-del">Silinmiş</span> }
                    else if (r.IsActive) { <span class="badge-ok">Aktif</span> }
                    else { <span class="badge-off">Pasif</span> }
                </td>
                <td>
                    @if (r.CanUseAi) { <span class="badge-ok">✓ AI Yetkili</span> }
                    else { <span class="badge-off">—</span> }
                </td>
                <td class="ar">
                    @if (!r.IsDeleted)
                    {
                        <form method="post" asp-page-handler="ToggleAi" style="display:inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit" title="AI Hub yetkisini aç/kapat">🧠 AI @(r.CanUseAi ? "Kapat" : "Aç")</button>
                        </form>
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline" onsubmit="return confirm('Silinsin (pasifleştirilsin) mi?')">
                            <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="deleted" value="true" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ToggleDelete" style="display:inline">
                            <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="deleted" value="false" />
                            <input type="hidden" name="Q" value="@Model.Q" /><input type="hidden" name="ShowDeleted" value="@Model.ShowDeleted" />
                            <button class="btn btn-sm" type="submit">Geri Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="bo-count">@Model.Items.Count kayıt</div>
