<Application x:Class="MindAeonRestLicence.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#16181D" />
        <SolidColorBrush x:Key="Surface" Color="#22262E" />
        <SolidColorBrush x:Key="Accent" Color="#C9882B" />
        <SolidColorBrush x:Key="Text" Color="#ECEFF4" />
        <SolidColorBrush x:Key="Muted" Color="#9AA2AE" />
        <SolidColorBrush x:Key="Border" Color="#39404B" />
        <SolidColorBrush x:Key="Danger" Color="#E5524A" />
        <SolidColorBrush x:Key="Ok" Color="#22A35A" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E24" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /></Style>
    </Application.Resources>
</Application>
