<Window x:Class="MindAeonRestLicence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MindAeonRest — Lisans Üretici (DAHİLİ)" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <!-- SOL: LİSANS ÜRET -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🔐 Lisans Üret" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                        <TextBlock x:Name="KeyStatus" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Text="Özel anahtar yüklü değil" />
                        <Button Content="Anahtar Dosyası Seç" Margin="12,0,0,0" Padding="10,5" Click="PickKey_Click" />
                    </StackPanel>

                    <Label Content="1) TALEP ANAHTARI (müşteriden gelen)" />
                    <TextBox x:Name="RequestBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                    <Button Content="Çöz" HorizontalAlignment="Left" Margin="0,8,0,12" Click="Decode_Click" />

                    <Border Background="#1B1E24" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="DecodedText" Foreground="{StaticResource Muted}" Text="Talep anahtarını yapıştırıp 'Çöz' deyin." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Label Content="2) PAKET" />
                    <ComboBox x:Name="PkgCombo" Margin="0,0,0,10" />

                    <Label Content="3) SÜRE" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="Perpetual" Content="Süresiz" IsChecked="True" Foreground="{StaticResource Text}" GroupName="dur" VerticalAlignment="Center" />
                        <RadioButton x:Name="Dated" Content="Bitiş:" Foreground="{StaticResource Text}" GroupName="dur" Margin="20,0,6,0" VerticalAlignment="Center" />
                        <DatePicker x:Name="ExpiryBox" Width="150" />
                    </StackPanel>

                    <Label Content="BAYİ ADI" />
                    <TextBox x:Name="DealerBox" Margin="0,0,0,8" />
                    <Label Content="BAYİ İLETİŞİM" />
                    <TextBox x:Name="ContactBox" Margin="0,0,0,8" />
                    <Label Content="NOT" />
                    <TextBox x:Name="NoteBox" Margin="0,0,0,12" />

                    <Button Content="✓ LİSANS ÜRET" Padding="18,10" HorizontalAlignment="Left" FontSize="14" Click="Generate_Click" />
                    <TextBlock x:Name="GenError" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Label Content="LİSANS ANAHTARI (müşteriye verilecek)" Margin="0,12,0,0" />
                    <TextBox x:Name="LicenseBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="📋 Anahtarı Kopyala" Padding="14,6" Click="CopyLicense_Click" />
                        <Button Content="💾 Dosyaya Kaydet (.lic)" Margin="10,0,0,0" Padding="14,6" Background="#2C3340" Click="SaveLicense_Click" />
                    </StackPanel>
                    <TextBlock Text="Anahtarı kopyalayıp e-posta/WhatsApp ile müşteriye iletin; ya da .lic dosyası olarak gönderin." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- SAĞ: VERİLEN LİSANSLAR -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="📜 Verilen Lisanslar" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <Button Content="🔄 Yenile" HorizontalAlignment="Right" Padding="10,5" Click="Refresh_Click" />
                </Grid>
                <DataGrid x:Name="IssuedGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1B1E24" Foreground="{StaticResource Text}" GridLinesVisibility="Horizontal"
                          RowBackground="#1B1E24" AlternatingRowBackground="#20242B" BorderBrush="{StaticResource Border}"
                          MouseDoubleClick="IssuedGrid_DoubleClick" ToolTip="Satıra çift tıklayın: o lisans anahtarını panoya kopyalar (yeniden gönderim için).">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding IssuedText}" Width="120" />
                        <DataGridTextColumn Header="Bayi" Binding="{Binding Dealer}" Width="*" />
                        <DataGridTextColumn Header="Şirket" Binding="{Binding CompanyCode}" Width="100" />
                        <DataGridTextColumn Header="Paket" Binding="{Binding PackageName}" Width="90" />
                        <DataGridTextColumn Header="Bitiş" Binding="{Binding ExpiryText}" Width="100" />
                        <DataGridTextColumn Header="Donanım" Binding="{Binding HardwareId}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
