@using MindAeonRest.Licence.Data
@using MindAeonRest.Licence.Portal.Models
@model MindAeonRest.Licence.Portal.Pages.Admin.LicensesModel
@{
    var d = Model.Detail;
}
@if (d is null)
{
    <div class="card"><p class="text-muted mb-0">Lisans bulunamadı.</p></div>
}
else
{
    var st = AdminLabels.License(d.Status);
    <div class="card" style="border-color:var(--primary);">
        <div class="card__head">
            <div>
                <h3 class="card__title">Lisans @d.LicenseCode</h3>
                <div class="text-sm text-muted">@AdminLabels.Package(d.Package) · @st.Text</div>
            </div>
            <span class="badge @st.Css"><span class="dot"></span> @st.Text</span>
        </div>

        <div class="grid grid-4">
            <div>
                <div class="text-sm text-muted">Paket</div>
                <div style="font-weight:600;">@AdminLabels.Package(d.Package)</div>
            </div>
            <div>
                <div class="text-sm text-muted">Şube / Kullanıcı</div>
                <div style="font-weight:600;">@d.MaxBranches / @d.MaxUsers</div>
            </div>
            <div>
                <div class="text-sm text-muted">Üretim</div>
                <div style="font-weight:600;">@d.IssuedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div>
                <div class="text-sm text-muted">Bitiş</div>
                <div style="font-weight:600;">@(d.ExpiresUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "Süresiz")</div>
            </div>
        </div>

        <div class="form-field" style="margin-top:var(--sp-4);">
            <label>Donanım Kimliği</label>
            <input type="text" value="@d.HardwareId" readonly style="font-variant-numeric:tabular-nums;" />
        </div>

        @if (!string.IsNullOrWhiteSpace(d.Notes))
        {
            <p class="text-sm text-muted">Not: @d.Notes</p>
        }

        <h4 style="margin-top:var(--sp-5);">Geçmiş</h4>
        @if (d.History is null || d.History.Count == 0)
        {
            <p class="text-muted mb-0">Geçmiş kaydı yok.</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var h in d.History)
                {
                    <div class="timeline__item">
                        <div class="timeline__time">@h.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                        <div class="timeline__title">@AdminLabels.Action(h.Action)</div>
                        @if (h.FromPackage is { } fp && h.ToPackage is { } tp)
                        {
                            <div class="text-sm text-muted">@AdminLabels.Package(fp) → @AdminLabels.Package(tp)</div>
                        }
                        else if (h.ToPackage is { } onlyTp)
                        {
                            <div class="text-sm text-muted">@AdminLabels.Package(onlyTp)</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(h.Note))
                        {
                            <div class="text-sm text-muted">@h.Note</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
