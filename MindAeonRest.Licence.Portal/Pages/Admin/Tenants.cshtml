@page
@model MindAeonRest.Licence.Portal.Pages.Admin.TenantsModel
@{
    ViewData["Title"] = "Tenant'lar — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Yönetim", "/Admin", "Tenant'lar"))

<div class="card" x-data="{ detailOpen: false }" x-on:tenant-detail="detailOpen = true">
    <div class="page-head flex items-center justify-between" style="margin-bottom:var(--sp-4);">
        <div>
            <h1 style="margin-bottom:var(--sp-1);">Tenant'lar</h1>
            <div class="subtitle">POS kümesindeki tüm kiracılar — lisans paketi, şube/kullanıcı sayısı, lisans atama ve detay gözetimi.</div>
        </div>
        <a class="btn btn-primary" href="/Admin/NewTenant"><i data-lucide="plus"></i> Yeni Tenant</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <div class="alert-error">@Model.LoadError</div>
    }

    <div id="tenantTable">
        @await Html.PartialAsync("_TenantsTable", Model)
    </div>

    <div x-show="detailOpen" x-transition style="margin-top:var(--sp-5);">
        <div id="tenantDetail"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.addEventListener('portalToast', e => window.toast(e.detail.message, e.detail.kind));
    </script>
}
