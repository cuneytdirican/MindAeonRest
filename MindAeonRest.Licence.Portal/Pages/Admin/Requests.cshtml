@page
@using MindAeonRest.Licence.Data
@model MindAeonRest.Licence.Portal.Pages.Admin.RequestsModel
@{
    ViewData["Title"] = "Talepler — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Yönetim", "/Admin", "Talepler"))

<div class="page-head">
    <h1>Lisans Talepleri</h1>
    <div class="subtitle">Bayilerden gelen lisans/yükseltme talepleri — onayla veya reddet.</div>
</div>

<div class="card">
    <div class="flex items-center gap-2" style="margin-bottom:var(--sp-4);">
        <span class="pill active" hx-get="/Admin/Requests?handler=Table&Status=0" hx-target="#reqTable" hx-swap="innerHTML"
              x-data x-on:click="$el.parentElement.querySelectorAll('.pill').forEach(p=>p.classList.remove('active')); $el.classList.add('active')">Bekleyen</span>
        <span class="pill" hx-get="/Admin/Requests?handler=Table&Status=1" hx-target="#reqTable" hx-swap="innerHTML"
              x-data x-on:click="$el.parentElement.querySelectorAll('.pill').forEach(p=>p.classList.remove('active')); $el.classList.add('active')">Üretildi</span>
        <span class="pill" hx-get="/Admin/Requests?handler=Table&Status=2" hx-target="#reqTable" hx-swap="innerHTML"
              x-data x-on:click="$el.parentElement.querySelectorAll('.pill').forEach(p=>p.classList.remove('active')); $el.classList.add('active')">Reddedildi</span>
        <span class="htmx-indicator flex items-center gap-2 text-muted text-sm"><i data-lucide="loader-circle"></i></span>
    </div>

    <div id="reqTable">
        @await Html.PartialAsync("_RequestsTable", Model)
    </div>
</div>

@section Scripts {
    <script>
        document.body.addEventListener('portalToast', e => window.toast(e.detail.message, e.detail.kind));
    </script>
}
