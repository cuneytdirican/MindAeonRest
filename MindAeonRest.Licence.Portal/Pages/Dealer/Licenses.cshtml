@page
@using MindAeonRest.Licence.Portal.Models
@model MindAeonRest.Licence.Portal.Pages.Dealer.LicensesModel
@{
    ViewData["Title"] = "Lisanslar — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Bayi", "/Dealer", "Lisanslar"))

<div class="page-head flex items-center justify-between" style="gap:var(--sp-4); flex-wrap:wrap;">
    <div>
        <h1>Lisanslar</h1>
        <div class="subtitle">Portföyünüzdeki lisanslar (salt-okuma). Lisans üretimi yöneticidedir.</div>
    </div>
    <button class="btn btn-primary" type="button" onclick="window.dispatchEvent(new CustomEvent('open-req'))">
        <i data-lucide="arrow-up-circle"></i> Yükseltme Talebi Gönder
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="toast @(Model.FlashKind ?? "info")" style="margin-bottom:var(--sp-4); max-width:none;">
        <i data-lucide="info"></i><div>@Model.Flash</div>
    </div>
}

<div class="card" style="margin-bottom:var(--sp-4); display:flex; align-items:center; gap:var(--sp-3); background:var(--surface-2);">
    <i data-lucide="lock" style="color:var(--text-3);"></i>
    <div class="text-sm text-muted mb-0">
        Bayi olarak lisans <strong>açamaz</strong> ya da değiştiremezsiniz. Yeni lisans veya paket yükseltmesi için
        "Yükseltme Talebi Gönder" ile yöneticiye iletin; onay sonrası otomatik üretilir.
    </div>
</div>

<div class="card">
    <div class="card__head">
        <h3 class="card__title">Lisans Listesi (@Model.Rows.Count)</h3>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="text-muted text-sm" style="padding:var(--sp-4) 0;">Henüz lisans yok.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>İşletme</th><th>Lisans Kodu</th><th>Paket</th><th>Durum</th>
                        <th class="num">Şube / Kul.</th><th>Veriliş</th><th>Bitiş</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var st = DealerLabels.LicenseStatus(r.License.Status);
                        <tr>
                            <td style="font-weight:600;">@r.BizTitle<div class="text-sm text-muted">@r.CompanyCode</div></td>
                            <td><span class="badge primary">@r.License.LicenseCode</span></td>
                            <td>@DealerLabels.Package(r.License.Package)</td>
                            <td><span class="badge @st.Css"><span class="dot"></span>@st.Text</span></td>
                            <td class="num">@r.License.MaxBranches / @r.License.MaxUsers</td>
                            <td class="text-sm text-muted">@r.License.IssuedUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-sm text-muted">
                                @(r.License.ExpiresUtc is { } e ? e.ToLocalTime().ToString("dd.MM.yyyy") : "Süresiz")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ============ Yükseltme Talebi modalı ============ -->
<div id="reqModal" x-data="{open:false}" x-show="open" x-cloak @@open-req.window="open=true" class="modal-backdrop" @@keydown.escape.window="open=false" style="display:none;">
    <div class="modal" @@click.outside="open=false">
        <form method="post" asp-page-handler="Request">
            @Html.AntiForgeryToken()
            <div class="modal__head">
                <h3 class="modal__title">Yükseltme / Lisans Talebi</h3>
                <button class="btn btn-ghost btn-icon" type="button" @@click="open=false"><i data-lucide="x"></i></button>
            </div>
            <div class="modal__body">
                <div class="form-field">
                    <label>İşletme (opsiyonel)</label>
                    <select name="ReqBusinessId" id="reqBizSelect" onchange="syncCode(this)">
                        <option value="">— Bağımsız —</option>
                        @foreach (var b in Model.Businesses)
                        {
                            <option value="@b.Id" data-code="@b.CompanyCode">@b.Title (@b.CompanyCode)</option>
                        }
                    </select>
                </div>
                <div class="form-field"><label>Şirket Kodu *</label><input name="ReqCompanyCode" id="reqCode" required /></div>
                <div class="form-field">
                    <label>Donanım Kimliği *</label>
                    <input name="ReqHardwareId" required placeholder="Masaüstünden alınan HardwareId" />
                    <div class="hint">Lisans donanıma bağlanır; doğru cihaz kimliğini girin.</div>
                </div>
                <div class="form-field">
                    <label>İstenen Paket *</label>
                    <select name="ReqPackage" required>
                        <option value="0">Lite</option>
                        <option value="1" selected>Standart</option>
                        <option value="2">Enterprise</option>
                    </select>
                </div>
                <p class="text-sm text-muted mb-0">
                    Talep "Bekliyor" olarak kuyruğa girer; yönetici onayında lisans otomatik üretilir.
                </p>
            </div>
            <div class="modal__foot">
                <button class="btn" type="button" @@click="open=false">Vazgeç</button>
                <button class="btn btn-primary" type="submit"><i data-lucide="send"></i> Talebi Gönder</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        function syncCode(sel) {
            var opt = sel.options[sel.selectedIndex];
            var code = opt ? opt.getAttribute("data-code") : "";
            if (code) document.getElementById("reqCode").value = code;
        }
    </script>
}
