@page
@using MindAeonRest.Licence.Portal.Models
@model MindAeonRest.Licence.Portal.Pages.Dealer.RequestsModel
@{
    ViewData["Title"] = "Yükseltme Talepleri — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Bayi", "/Dealer", "Yükseltme Talebi"))

<div class="page-head flex items-center justify-between" style="gap:var(--sp-4); flex-wrap:wrap;">
    <div>
        <h1>Yükseltme Talepleri</h1>
        <div class="subtitle">Gönderdiğiniz lisans/yükseltme taleplerinin durumu.</div>
    </div>
    <button class="btn btn-primary" type="button" onclick="window.dispatchEvent(new CustomEvent('open-req'))">
        <i data-lucide="plus"></i> Yeni Talep
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="toast @(Model.FlashKind ?? "info")" style="margin-bottom:var(--sp-4); max-width:none;">
        <i data-lucide="info"></i><div>@Model.Flash</div>
    </div>
}

<div class="grid grid-3">
    <div class="kpi"><div class="kpi__label">Bekleyen</div><div class="kpi__value">@Model.PendingCount</div></div>
    <div class="kpi"><div class="kpi__label">Onaylanan</div><div class="kpi__value">@Model.IssuedCount</div></div>
    <div class="kpi"><div class="kpi__label">Reddedilen</div><div class="kpi__value">@Model.RejectedCount</div></div>
</div>

<div class="card mt-4">
    <div class="card__head"><h3 class="card__title">Talep Listesi (@Model.Requests.Count)</h3></div>

    @if (Model.Requests.Count == 0)
    {
        <div class="text-muted text-sm" style="padding:var(--sp-4) 0;">Henüz talep göndermediniz.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th>#</th><th>Şirket Kodu</th><th>Donanım</th><th>İstenen Paket</th><th>Durum</th><th>Tarih</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Requests)
                    {
                        var st = DealerLabels.RequestStatus(r.Status);
                        <tr>
                            <td class="text-muted">#@r.Id</td>
                            <td><span class="badge">@r.CompanyCode</span></td>
                            <td class="text-sm text-muted" style="font-family:monospace;">@r.HardwareId</td>
                            <td>@r.RequestedPackageName</td>
                            <td><span class="badge @st.Css"><span class="dot"></span>@st.Text</span></td>
                            <td class="text-sm text-muted">@r.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ============ Yeni Talep modalı ============ -->
<div id="reqModal" x-data="{open:false}" x-show="open" x-cloak @@open-req.window="open=true" class="modal-backdrop" @@keydown.escape.window="open=false" style="display:none;">
    <div class="modal" @@click.outside="open=false">
        <form method="post" asp-page-handler="Request">
            @Html.AntiForgeryToken()
            <div class="modal__head">
                <h3 class="modal__title">Yeni Yükseltme Talebi</h3>
                <button class="btn btn-ghost btn-icon" type="button" @@click="open=false"><i data-lucide="x"></i></button>
            </div>
            <div class="modal__body">
                <div class="form-field">
                    <label>İşletme (opsiyonel)</label>
                    <select name="ReqBusinessId" id="reqBizSelect" onchange="syncCode(this)">
                        <option value="">— Bağımsız —</option>
                        @foreach (var b in Model.Businesses)
                        {
                            <option value="@b.Id" data-code="@b.CompanyCode">@b.Title (@b.CompanyCode)</option>
                        }
                    </select>
                </div>
                <div class="form-field"><label>Şirket Kodu *</label><input name="ReqCompanyCode" id="reqCode" required /></div>
                <div class="form-field">
                    <label>Donanım Kimliği *</label>
                    <input name="ReqHardwareId" required placeholder="Masaüstünden alınan HardwareId" />
                </div>
                <div class="form-field">
                    <label>İstenen Paket *</label>
                    <select name="ReqPackage" required>
                        <option value="0">Lite</option>
                        <option value="1" selected>Standart</option>
                        <option value="2">Enterprise</option>
                    </select>
                </div>
            </div>
            <div class="modal__foot">
                <button class="btn" type="button" @@click="open=false">Vazgeç</button>
                <button class="btn btn-primary" type="submit"><i data-lucide="send"></i> Gönder</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
        function syncCode(sel) {
            var opt = sel.options[sel.selectedIndex];
            var code = opt ? opt.getAttribute("data-code") : "";
            if (code) document.getElementById("reqCode").value = code;
        }
    </script>
}
