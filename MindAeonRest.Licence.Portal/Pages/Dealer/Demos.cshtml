@page
@using MindAeonRest.Licence.Portal.Models
@model MindAeonRest.Licence.Portal.Pages.Dealer.DemosModel
@{
    ViewData["Title"] = "Demolar — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Bayi", "/Dealer", "Demolar"))

<div class="page-head flex items-center justify-between" style="gap:var(--sp-4); flex-wrap:wrap;">
    <div>
        <h1>Demo Kurulumları</h1>
        <div class="subtitle">Aday müşterilere kurduğunuz deneme kurulumlarını izleyin.</div>
    </div>
    <button class="btn btn-primary" type="button" onclick="window.dispatchEvent(new CustomEvent('open-demo'))">
        <i data-lucide="flask-conical"></i> Demo Kur
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Flash))
{
    <div class="toast @(Model.FlashKind ?? "info")" style="margin-bottom:var(--sp-4); max-width:none;">
        <i data-lucide="info"></i><div>@Model.Flash</div>
    </div>
}

<div class="grid grid-3">
    <div class="kpi"><div class="kpi__label">Toplam Demo</div><div class="kpi__value">@Model.Demos.Count</div></div>
    <div class="kpi"><div class="kpi__label">Açık</div><div class="kpi__value">@Model.OpenCount</div></div>
    <div class="kpi"><div class="kpi__label">Dönüşen</div><div class="kpi__value">@Model.ConvertedCount</div></div>
</div>

<div class="card mt-4">
    <div class="card__head"><h3 class="card__title">Demo Listesi</h3></div>

    @if (Model.Demos.Count == 0)
    {
        <div class="text-muted text-sm" style="padding:var(--sp-4) 0;">Henüz demo kurulumu yok.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th>Şirket Kodu</th><th>Unvan</th><th>İletişim</th><th>Başlangıç</th><th>Durum</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Demos)
                    {
                        <tr>
                            <td><span class="badge">@d.CompanyCode</span></td>
                            <td style="font-weight:600;">@(d.BusinessTitle ?? "—")</td>
                            <td class="text-sm text-muted">@(d.ContactName ?? d.Phone ?? d.Email ?? "—")</td>
                            <td class="text-sm text-muted">@d.StartedUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (d.Converted)
                                {
                                    <span class="badge success"><span class="dot"></span>Dönüştü</span>
                                }
                                else
                                {
                                    <span class="badge warning"><span class="dot"></span>Açık</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ============ Demo Kur modalı ============ -->
<div id="demoModal" x-data="{open:false}" x-show="open" x-cloak @@open-demo.window="open=true" class="modal-backdrop" @@keydown.escape.window="open=false" style="display:none;">
    <div class="modal" @@click.outside="open=false">
        <form method="post" asp-page-handler="CreateDemo">
            @Html.AntiForgeryToken()
            <div class="modal__head">
                <h3 class="modal__title">Demo Kur</h3>
                <button class="btn btn-ghost btn-icon" type="button" @@click="open=false"><i data-lucide="x"></i></button>
            </div>
            <div class="modal__body">
                <p class="text-sm text-muted" style="margin-bottom:var(--sp-4);">
                    Şirket kodu boş bırakılırsa otomatik üretilir. Demo bayinize bağlanır.
                </p>
                <div class="grid grid-2" style="gap:var(--sp-3);">
                    <div class="form-field"><label>Şirket Kodu</label><input name="CompanyCode" placeholder="(otomatik)" /></div>
                    <div class="form-field"><label>Unvan</label><input name="BusinessTitle" /></div>
                </div>
                <div class="form-field"><label>Donanım Kimliği</label><input name="HardwareId" /></div>
                <div class="grid grid-2" style="gap:var(--sp-3);">
                    <div class="form-field"><label>Yetkili</label><input name="ContactName" /></div>
                    <div class="form-field"><label>Telefon</label><input name="Phone" /></div>
                </div>
                <div class="form-field"><label>E-posta</label><input name="Email" type="email" /></div>
            </div>
            <div class="modal__foot">
                <button class="btn" type="button" @@click="open=false">Vazgeç</button>
                <button class="btn btn-primary" type="submit"><i data-lucide="check"></i> Kur</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <script>lucide.createIcons();</script> }
