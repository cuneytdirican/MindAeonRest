@page
@model LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş — MindAeon Lisans Portalı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
    <div class="login-split">
        <aside class="login-aside">
            <div class="brand">
                <span class="logo-dot"></span>
                <span>MindAeon</span>
            </div>
            <div>
                <h2>Lisans, bayi ve ödeme yönetimi tek panelde.</h2>
                <p>Lisanslarınızı çevrimiçi/çevrimdışı yönetin, bayi portföyünüzü izleyin ve destek taleplerini takip edin.</p>
                <ul>
                    <li><i data-lucide="shield-check"></i> RSA imzalı güvenli lisanslama</li>
                    <li><i data-lucide="bar-chart-3"></i> Ciro ve kullanım raporları</li>
                    <li><i data-lucide="users"></i> Rol bazlı erişim (Yönetici / Bayi / Müşteri)</li>
                </ul>
            </div>
            <div class="text-sm" style="color:rgba(255,255,255,.7)">© @DateTime.UtcNow.Year MobilTeg • MindAeonRest</div>
        </aside>

        <section class="login-panel">
            <div class="login-card">
                <h1>Tekrar hoş geldiniz</h1>
                <p class="text-muted">Devam etmek için hesabınıza giriş yapın.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert-error" role="alert">@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-field">
                        <label for="Email">E-posta</label>
                        <input id="Email" name="Email" type="email" autocomplete="username"
                               value="@Model.Email" placeholder="ad@firma.com" required />
                    </div>
                    <div class="form-field">
                        <label for="Password">Parola</label>
                        <input id="Password" name="Password" type="password" autocomplete="current-password"
                               placeholder="••••••••" required />
                    </div>
                    <button class="btn btn-primary btn-block" type="submit">
                        <i data-lucide="log-in"></i> Giriş Yap
                    </button>
                </form>
            </div>
        </section>
    </div>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/app.js"></script>
</body>
</html>
