@page
@using MindAeonRest.Licence.Data
@model MindAeonRest.Licence.Portal.Pages.Musteri.OdemelerimModel
@{
    ViewData["Title"] = "Ödemelerim — MindAeon";
}
@await Html.PartialAsync("_Breadcrumb", ("Müşteri", "/Musteri", "Ödemelerim"))

<div class="page-head">
    <h1>Ödemelerim</h1>
    <div class="subtitle">Geçmiş ödemeleriniz ve yeni ödeme başlatma.</div>
</div>

<div class="grid grid-3" style="margin-bottom:var(--sp-5)">
    <div class="kpi">
        <div class="kpi__label">Toplam Ödenen</div>
        <div class="kpi__value money net">@CustomerUi.Money(Model.TotalPaid) ₺</div>
    </div>
    <div class="kpi">
        <div class="kpi__label">Bekleyen</div>
        <div class="kpi__value money" style="color:var(--warning)">@CustomerUi.Money(Model.Pending) ₺</div>
    </div>
    <div class="kpi">
        <div class="kpi__label">İşlem Sayısı</div>
        <div class="kpi__value">@Model.Payments.Count</div>
    </div>
</div>

@if (Model.CustomerPays)
{
    <div class="card" style="margin-bottom:var(--sp-5)" x-data="{ open:false }">
        <div class="card__head">
            <div>
                <h2 class="card__title">Yeni Ödeme</h2>
                <span class="text-muted text-sm">Paket ve süre seçin; tutar otomatik hesaplanır.</span>
            </div>
            <button class="btn btn-primary" type="button" @@click="open=!open">
                <i data-lucide="plus"></i>Ödeme Başlat
            </button>
        </div>

        <div x-show="open" x-cloak x-transition>
            @if (!Model.Catalog.Any())
            {
                <div class="text-muted text-sm">Şu an satışa açık bir paket fiyatı bulunmuyor.</div>
            }
            else
            {
                <form hx-post="/Musteri/Odemelerim?handler=Pay" hx-target="#payResult" hx-swap="innerHTML"
                      hx-indicator="#payIndicator">
                    @Html.AntiForgeryToken()
                    <div class="grid grid-3">
                        <div class="form-field">
                            <label for="catalogSel">Paket / Süre</label>
                            <select id="catalogSel" name="catalogKey"
                                    x-data="{}" @@change="
                                        var o=$event.target.selectedOptions[0];
                                        $refs.pkg.value=o.dataset.pkg; $refs.dur.value=o.dataset.dur;">
                                @foreach (var c in Model.Catalog)
                                {
                                    <option data-pkg="@c.Package" data-dur="@((int)c.Duration)">
                                        @c.PackageName · @CustomerUi.DurationLabel(c.Duration) — @CustomerUi.Money(c.Price) @c.CurrencyCode
                                    </option>
                                }
                            </select>
                            <input type="hidden" name="package" x-ref="pkg" value="@Model.Catalog.First().Package" />
                            <input type="hidden" name="duration" x-ref="dur" value="@((int)Model.Catalog.First().Duration)" />
                        </div>
                        <div class="form-field">
                            <label for="provSel">Ödeme Yöntemi</label>
                            <select id="provSel" name="provider">
                                <option value="3">Banka Havalesi / EFT</option>
                            </select>
                            <span class="text-muted text-sm">Ödeme talimatınız oluşturulur; havale/EFT sonrası onaylanır.</span>
                        </div>
                        <div class="form-field" style="justify-content:flex-end">
                            <button class="btn btn-primary btn-block" type="submit">
                                <i data-lucide="credit-card"></i>Öde
                                <span id="payIndicator" class="htmx-indicator"><i data-lucide="loader-circle"></i></span>
                            </button>
                        </div>
                    </div>
                    <div id="payResult" style="margin-top:var(--sp-3)"></div>
                </form>
            }
        </div>
    </div>
}
else
{
    <div class="card" style="margin-bottom:var(--sp-5)">
        <div class="flex items-center gap-3">
            <i data-lucide="info" style="color:var(--info)"></i>
            <div class="text-muted text-sm">Ödemeleriniz bayiniz üzerinden tahsil edilmektedir. Sorularınız için destek talebi oluşturabilirsiniz.</div>
        </div>
    </div>
}

<div class="card">
    <div class="card__head"><h2 class="card__title">Ödeme Geçmişi</h2></div>
    @if (!Model.Payments.Any())
    {
        <div class="text-muted text-sm" style="padding:var(--sp-3) 0">Henüz ödeme kaydı yok.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>No</th><th>Tarih</th><th>Yöntem</th><th>Durum</th>
                        <th class="num">Tutar</th><th>Referans</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td class="tabular">#@p.Id</td>
                        <td class="tabular">@p.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@CustomerUi.ProviderLabel(p.Provider)</td>
                        <td><span class="badge @CustomerUi.PaymentBadge(p.Status)"><span class="dot"></span>@CustomerUi.PaymentLabel(p.Status)</span></td>
                        <td class="num money net">@CustomerUi.Money(p.Amount) <span class="text-muted">@p.CurrencyCode</span></td>
                        <td class="tabular text-muted">@(string.IsNullOrWhiteSpace(p.ProviderRef) ? "—" : p.ProviderRef)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <style>[x-cloak]{display:none!important}</style>
    <script>lucide.createIcons();</script>
}
